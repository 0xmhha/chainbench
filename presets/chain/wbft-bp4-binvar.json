{
  "schemaVersion": "2",
  "kind": "chain-preset",
  "id": "wbft-bp4-binvar",
  "description": "wbft: 4 bp. Binaries: default = ${GWBFT_BIN:-gwbft}. Used by no case.",
  "binaries": {
    "default": "${GWBFT_BIN:-gwbft}"
  },
  "chain": "wbft",
  "keys": {
    "nodekeys": {
      "ref": "presets/keys",
      "source": "keyPreset"
    }
  },
  "topology": {
    "bp": 4
  }
}
