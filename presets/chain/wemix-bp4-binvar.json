{
  "schemaVersion": "2",
  "kind": "chain-preset",
  "id": "wemix-bp4-binvar",
  "description": "wemix: 4 bp. Binaries: default = ${GWEMIX_BIN:-gwemix}. Used by 1 case.",
  "binaries": {
    "default": "${GWEMIX_BIN:-gwemix}"
  },
  "chain": "wemix",
  "keys": {
    "nodekeys": {
      "ref": "presets/keys",
      "source": "keyPreset"
    }
  },
  "topology": {
    "bp": 4
  }
}
