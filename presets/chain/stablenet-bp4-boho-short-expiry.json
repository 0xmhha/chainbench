{
  "schemaVersion": "2",
  "kind": "chain-preset",
  "id": "stablenet-bp4-boho-short-expiry",
  "description": "stablenet: 4 bp, with Boho and Applepie on from block 0 and governance proposals expiring after 30 seconds. A burn refund reads GovMinter v2's refundableBalance, so it needs boho; watching an expiry needs the short window. The genesis is what makes both true, so it is what declares both capabilities. Used by 1 case.",
  "chain": "stablenet",
  "keys": {
    "nodekeys": {
      "ref": "presets/keys",
      "source": "keyPreset"
    }
  },
  "topology": {
    "bp": 4
  },
  "hardforks": {
    "applepie": 0,
    "boho": 0
  },
  "genesis": {
    "provides": [
      "short-expiry"
    ],
    "overlay": {
      "config": {
        "boho": {
          "systemContracts": {
            "govMinter": {
              "address": "0x0000000000000000000000000000000000001003",
              "version": "v2"
            }
          }
        }
      }
    },
    "set": {
      "config.anzeon.systemContracts.govValidator.params.expiry": "30",
      "config.anzeon.systemContracts.govMinter.params.expiry": "30",
      "config.anzeon.systemContracts.govCouncil.params.expiry": "30",
      "config.anzeon.systemContracts.govMasterMinter.params.expiry": "30"
    }
  }
}
