# Dev accounts injected into every chainbench-server container at start.
# Copy to accounts.env (gitignored) and set a real password there.
#
# DEV_ACCOUNTS: space-separated name:uid pairs. Every account gets a home,
# bash, sudo-group membership, and the shared password below (sudo asks for
# it — the containers are loopback-published only, mirroring the real fleet).
DEV_ACCOUNTS="devuser1:2001 devuser2:2002"
DEV_ACCOUNTS_PASSWORD="change-me"
