{
  "schemaVersion": "2",
  "kind": "case",
  "id": "admin-peers-populated",
  "description": "RT-A-1-05 — P2P 피어 연결 확인 (원본 regression/ethereum/05-test-p2p-peers)",
  "applicableChains": "stablenet,wbft,wemix",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "admin-peers-populated-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "compare": "GreaterOrEqual",
      "expect": "rpcCall",
      "is": "1",
      "method": "admin_peers",
      "select": "#"
    },
    {
      "compare": "NotEqual",
      "expect": "rpcCall",
      "is": "",
      "method": "admin_peers",
      "select": "0.id"
    }
  ]
}
