{
  "schemaVersion": "2",
  "kind": "case",
  "id": "stress-block-time",
  "description": "Measure block production time statistics over last 100 blocks (원본 stress/block-time.sh)",
  "requires": [
    "rpc",
    "consensus"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "stress-stablenet",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 20,
      "timeout": "180s"
    },
    {
      "expect": "blockInterval",
      "on": "node1",
      "blocks": 15,
      "maxSeconds": 60
    }
  ]
}
