{
  "schemaVersion": "2",
  "kind": "case",
  "id": "fault-node-crash",
  "description": "Stop 1 validator and verify consensus continues with 3/4 (원본 fault/node-crash.sh)",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "fault-stablenet",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "stopNode",
      "on": "node3"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "90s",
      "pollInterval": "2s"
    },
    {
      "do": "restartNode",
      "on": "node3"
    },
    {
      "do": "waitBlock",
      "on": "node3",
      "target": 8,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    }
  ]
}
