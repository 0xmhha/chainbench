{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wbft-chain-up-15",
  "requires": [
    "rpc",
    "consensus"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "wbft-docker15",
    "chain": "wbft",
    "binaries": {
      "default": "/data/chainbench/bin/gwbft"
    },
    "topology": {
      "bp": 13,
      "pn": 1,
      "en": 1
    },
    "keys": {
      "nodekeys": {
        "source": "generate"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "180s"
    },
    {
      "expect": "chainId",
      "compare": "Greater",
      "is": "0"
    },
    {
      "expect": "blockNumber",
      "compare": "GreaterOrEqual",
      "is": "2"
    },
    {
      "expect": "rpc",
      "method": "istanbul_getValidators",
      "params": [
        "latest"
      ],
      "compare": "Len",
      "is": 13
    },
    {
      "expect": "rpc",
      "method": "net_peerCount",
      "compare": "NotEqual",
      "is": "0x0"
    }
  ]
}
