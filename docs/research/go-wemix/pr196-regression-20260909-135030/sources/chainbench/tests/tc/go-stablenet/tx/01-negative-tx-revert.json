{
  "schemaVersion": "2",
  "kind": "case",
  "id": "stablenet-negative-tx-revert",
  "description": "Negative path (WA25): deploy a contract whose runtime always reverts, then send it a transaction and require that it reverts (mined with status 0x0). Also send a plain value transfer and require it succeeds, so a false pass would need both to be wrong.",
  "requires": ["rpc"],
  "env": {
    "schemaVersion": "2", "kind": "env", "id": "stablenet", "chain": "stablenet",
    "binaries": { "default": "gstable" },
    "topology": { "bp": 4 },
    "keys": { "nodekeys": { "source": "preset", "ref": "keys/preset" } }
  },
  "steps": [
    { "do": "waitBlock", "target": 2, "timeout": "120s" },
    { "do": "deployContract", "on": "node1", "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8", "bytecode": "0x600580600b6000396000f360006000fd", "gas": "300000", "save": "rv" },
    { "expect": "codeAt", "on": "node1", "address": "$rv", "compare": "Equal", "is": "0x60006000fd" },
    { "do": "sendTx", "on": "node1", "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8", "to": "$rv", "gas": "100000", "expect": "revert" }
  ]
}
