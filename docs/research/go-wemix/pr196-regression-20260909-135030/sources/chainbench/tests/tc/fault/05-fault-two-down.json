{
  "schemaVersion": "2",
  "kind": "case",
  "id": "fault-two-down",
  "description": "Stop 2/4 validators - consensus should halt, recover when 1 returns (원본 fault/two-down.sh)",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "fault-stablenet",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "stopNode",
      "on": "node3"
    },
    {
      "do": "stopNode",
      "on": "node4"
    },
    {
      "expect": "blockHalt",
      "on": "node1",
      "within": "12s",
      "maxAdvance": 1
    },
    {
      "do": "startNode",
      "on": "node3"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "90s",
      "pollInterval": "2s"
    },
    {
      "do": "startNode",
      "on": "node4"
    }
  ]
}
