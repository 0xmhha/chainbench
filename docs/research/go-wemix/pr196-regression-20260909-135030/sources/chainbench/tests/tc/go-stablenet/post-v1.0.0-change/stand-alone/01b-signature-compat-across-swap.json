{
  "schemaVersion": "2",
  "kind": "case",
  "id": "signature-compat-across-swap",
  "description": "TC-3-1-04 — 노드가 다른 바이너리로 재기동해도 기존 tx 의 blockNumber·status·from·to 가 보존된다",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "signature-compat-stablenet",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable",
      "upgrade": "${GSTABLE_UPGRADE_BIN:-gstable}"
    },
    "topology": {
      "bp": 4,
      "en": 1
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "from": "node1",
      "to": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
      "value": "1",
      "gas": "21000",
      "save": "legacyTx",
      "expect": "receipt"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "select": "blockNumber",
      "save": "blockBefore"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "select": "status",
      "save": "statusBefore"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "select": "from",
      "save": "fromBefore"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "select": "to",
      "save": "toBefore"
    },
    {
      "do": "swapNode",
      "on": "en1",
      "binary": "upgrade",
      "purpose": "signature-compat"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "compare": "GreaterOrEqual",
      "expected": "$blockBefore",
      "timeout": "180s",
      "pollInterval": "2s"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "select": "blockNumber",
      "compare": "Equal",
      "is": "$blockBefore"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "select": "status",
      "compare": "Equal",
      "is": "$statusBefore"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "select": "from",
      "compare": "Equal",
      "is": "$fromBefore"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "select": "to",
      "compare": "Equal",
      "is": "$toBefore"
    },
    {
      "do": "readNodeLog",
      "on": "en1",
      "save": "upgradedNodeLog"
    }
  ]
}
