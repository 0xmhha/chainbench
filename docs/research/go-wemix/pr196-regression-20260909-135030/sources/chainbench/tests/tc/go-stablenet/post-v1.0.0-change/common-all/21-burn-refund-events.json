{
  "schemaVersion": "2",
  "kind": "case",
  "id": "burn-refund-events",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "burn-refund-events-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "data": "",
      "do": "sendTx",
      "from": "node4",
      "gas": "0xb71b0",
      "on": "node4",
      "save": "burnHash",
      "to": "0x0000000000000000000000000000000000001003",
      "value": "0xde0b6b3a7640000"
    },
    {
      "do": "read",
      "hash": "$burnHash",
      "save": "burnPid",
      "source": "receiptLog",
      "topic": 1,
      "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a"
    },
    {
      "do": "read",
      "of": [
        "$burnPid"
      ],
      "op": "abiCall",
      "save": "cancelData",
      "selector": "0xe0a8f6f5",
      "source": "derive"
    },
    {
      "data": "$cancelData",
      "do": "sendTx",
      "from": "node4",
      "gas": "0xb71b0",
      "on": "node4",
      "save": "cancelHash",
      "to": "0x0000000000000000000000000000000000001003"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$cancelHash"
      ],
      "save": "cancelBlk",
      "select": "blockNumber",
      "source": "rpcCall"
    },
    {
      "data": "0x936834b9",
      "do": "sendTx",
      "from": "node4",
      "gas": "0xb71b0",
      "on": "node4",
      "save": "claimHash",
      "to": "0x0000000000000000000000000000000000001003"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$claimHash"
      ],
      "save": "claimBlk",
      "select": "blockNumber",
      "source": "rpcCall"
    },
    {
      "expect": "txStatus",
      "hash": "$burnHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$cancelHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$claimHash",
      "is": "0x1"
    },
    {
      "address": "0x0000000000000000000000000000000000001003",
      "compare": "GreaterOrEqual",
      "expect": "logs",
      "fromBlock": "$cancelBlk",
      "is": "1",
      "select": "count",
      "toBlock": "$cancelBlk",
      "topics": [
        "0x116044c8ec23de4088f4a50cf4f8a504ec887c439452af3be4f57f6c77bf2062"
      ]
    },
    {
      "address": "0x0000000000000000000000000000000000001003",
      "compare": "GreaterOrEqual",
      "expect": "logs",
      "fromBlock": "$claimBlk",
      "is": "1",
      "select": "count",
      "toBlock": "$claimBlk",
      "topics": [
        "0x9543fa265d2616af3e7021d8b5a7d1271eb7bba960908675ce3bddaf60c1af24"
      ]
    }
  ]
}
