{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wbft-node-crash",
  "description": "Stop one wbft validator and verify consensus continues 3/4, then restart it (WA25 — wbft had no fault coverage).",
  "requires": ["rpc", "consensus", "process"],
  "env": {
    "schemaVersion": "2", "kind": "env", "id": "wbft-fault", "chain": "wbft",
    "binaries": { "default": "gwbft" },
    "topology": { "bp": 4 },
    "keys": { "nodekeys": { "source": "preset", "ref": "keys/preset" } }
  },
  "steps": [
    { "do": "waitBlock", "target": 3, "timeout": "180s" },
    { "do": "stopNode", "on": "node3" },
    { "expect": "blockAdvance", "on": "node1", "timeout": "120s", "pollInterval": "2s" },
    { "do": "restartNode", "on": "node3" }
  ]
}
