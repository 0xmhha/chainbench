{
  "schemaVersion": "2",
  "kind": "case",
  "id": "feecap-above-min-accepted",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "feecap-above-min-accepted-env",
    "chain": "stablenet",
    "binaries": {
      "default": "go-stablenet"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "method": "eth_blockNumber",
      "save": "n",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "eth_getBlockByNumber",
      "params": [
        "$n",
        false
      ],
      "save": "base",
      "select": "baseFeePerGas",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "$n"
      ],
      "save": "tip",
      "select": "gasTip",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "of": [
        "$base",
        "$base",
        "$tip"
      ],
      "op": "sum",
      "save": "feecap",
      "source": "derive"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "maxFeePerGas": "$feecap",
      "maxPriorityFeePerGas": "$tip",
      "save": "hash",
      "to": "0x00000000000000000000000000000000C0FFEE0E",
      "value": "1"
    },
    {
      "expect": "txStatus",
      "hash": "$hash",
      "is": "0x1"
    }
  ]
}
