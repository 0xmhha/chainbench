{
  "schemaVersion": "2",
  "kind": "case",
  "id": "gas-price-equals-basefee-plus-tip",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "gas-price-equals-basefee-plus-tip-env",
    "chain": "stablenet",
    "binaries": {
      "default": "go-stablenet"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "save": "gp",
      "source": "gasPrice"
    },
    {
      "do": "read",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "save": "n",
      "select": "number",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "eth_getBlockByNumber",
      "params": [
        "$n",
        false
      ],
      "save": "base",
      "select": "baseFeePerGas",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "$n"
      ],
      "save": "tip",
      "select": "gasTip",
      "source": "rpcCall"
    },
    {
      "compare": "Equal",
      "expect": "derive",
      "is": "$gp",
      "of": [
        "$base",
        "$tip"
      ],
      "op": "sum"
    }
  ]
}
