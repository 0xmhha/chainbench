{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wemix-chain-up",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "wemix",
    "chain": "wemix",
    "binaries": {
      "default": "${GWEMIX_BIN:-gwemix}"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "180s"
    },
    {
      "expect": "chainId",
      "compare": "Greater",
      "is": "0"
    },
    {
      "expect": "blockNumber",
      "compare": "GreaterOrEqual",
      "is": "2"
    },
    {
      "expect": "rpc",
      "method": "net_peerCount",
      "compare": "NotEqual",
      "is": "0x0"
    }
  ]
}
