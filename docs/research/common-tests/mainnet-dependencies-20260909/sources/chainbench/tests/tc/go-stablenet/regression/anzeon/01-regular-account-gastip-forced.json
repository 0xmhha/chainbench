{
  "schemaVersion": "2",
  "kind": "case",
  "id": "regular-account-gastip-forced",
  "description": "RT-C-01 — 일반 계정의 tipCap이 header.GasTip()으로 강제 대체됨 (원본 regression/anzeon/01-test-regular-account-gastip-forced)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "regular-account-gastip-forced-env",
    "chain": "stablenet",
    "binaries": {
      "default": "go-stablenet"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "method": "eth_blockNumber",
      "save": "n",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "$n"
      ],
      "save": "htip",
      "select": "gasTip",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "of": [
        "$htip",
        "$htip",
        "$htip",
        "$htip",
        "$htip"
      ],
      "op": "sum",
      "save": "hightip",
      "source": "derive"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "maxFeePerGas": "1000000000000000",
      "maxPriorityFeePerGas": "$hightip",
      "save": "hash",
      "to": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
      "value": "1"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$hash"
      ],
      "save": "egp",
      "select": "effectiveGasPrice",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$hash"
      ],
      "save": "blk",
      "select": "blockNumber",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "eth_getBlockByNumber",
      "params": [
        "$blk",
        false
      ],
      "save": "base",
      "select": "baseFeePerGas",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "$blk"
      ],
      "save": "itip",
      "select": "gasTip",
      "source": "rpcCall"
    },
    {
      "compare": "Equal",
      "expect": "derive",
      "is": "$itip",
      "of": [
        "$egp",
        "$base"
      ],
      "op": "diff"
    }
  ]
}
