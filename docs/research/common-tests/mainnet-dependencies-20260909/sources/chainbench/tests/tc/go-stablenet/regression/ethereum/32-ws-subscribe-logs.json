{
  "schemaVersion": "2",
  "kind": "case",
  "id": "ws-subscribe-logs",
  "description": "RT-A-4-07 — eth_subscribe(logs) WebSocket 구독 (원본 regression/ethereum/32-test-ws-subscribe-logs)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc",
    "ws"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "ws-subscribe-logs-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc",
      "ws"
    ]
  },
  "steps": [
    {
      "data": "0x6027600c60003960276000f37f111111111111111111111111111111111111111111111111111111111111111160006000a100",
      "do": "sendTx",
      "from": "node1",
      "gas": "200000",
      "on": "node1",
      "save": "dhash"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$dhash"
      ],
      "save": "addr",
      "select": "contractAddress",
      "source": "rpcCall"
    },
    {
      "address": "$addr",
      "do": "wsOpen",
      "event": "logs",
      "on": "en1",
      "save": "logsub"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "100000",
      "on": "node1",
      "save": "ehash",
      "to": "$addr"
    },
    {
      "expect": "txStatus",
      "hash": "$dhash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$ehash",
      "is": "0x1"
    },
    {
      "count": 1,
      "expect": "wsCollected",
      "sub": "$logsub",
      "timeout": "30s"
    }
  ]
}
