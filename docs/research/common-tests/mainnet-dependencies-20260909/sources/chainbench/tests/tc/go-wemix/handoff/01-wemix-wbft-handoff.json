{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wemix-wbft-handoff",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "wemix-wbft",
    "chain": "wbft",
    "binaries": {
      "producer": "${GWEMIX_BIN:-gwemix}",
      "validator": "${GWBFT_BIN:-gwbft}"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "upgrade": {
      "profile": "profiles/wemix-upgrade.yaml",
      "template": "${GOWEMIX_TEMPLATE}"
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 22,
      "timeout": "240s"
    },
    {
      "expect": "blockNumber",
      "compare": "Greater",
      "is": "20"
    },
    {
      "expect": "rpc",
      "method": "eth_getBlockByNumber",
      "params": [
        "0x15",
        false
      ],
      "select": "miner",
      "compare": "NotEqual",
      "is": "0xf9593d358b373d354a348c00887b914b408f6984"
    },
    {
      "expect": "rpc",
      "method": "istanbul_getValidators",
      "params": [
        "latest"
      ],
      "compare": "Len",
      "is": 4
    }
  ]
}
