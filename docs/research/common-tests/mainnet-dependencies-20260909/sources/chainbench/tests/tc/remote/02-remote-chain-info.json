{
  "schemaVersion": "2",
  "kind": "case",
  "id": "remote-chain-info",
  "description": "레거시 remote/chain-info: 붙은 체인이 chainId 를 보고하고 동기화가 끝나 있다.",
  "applicableChains": "stablenet,wbft",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "remote-chain-info-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "compare": "Greater",
      "expect": "chainId",
      "is": "0"
    },
    {
      "expect": "rpcCall",
      "is": false,
      "method": "eth_syncing"
    },
    {
      "compare": "NotEqual",
      "expect": "rpcCall",
      "is": "",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "hash"
    }
  ]
}
