{
  "schemaVersion": "2",
  "kind": "case",
  "id": "epoch-transition-carries-epoch-info",
  "description": "RT-B-03 — 에폭 전환 — 검증자 집합 갱신 (원본 regression/wbft/03-test-epoch-transition)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc",
    "consensus"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "epoch-transition-carries-epoch-info-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc",
      "consensus"
    ]
  },
  "steps": [
    {
      "do": "waitBlock",
      "pollInterval": "2s",
      "target": 140,
      "timeout": "240s"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "rpcCall",
      "is": "1",
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "0x8c"
      ],
      "select": "epochInfo.validators.#"
    }
  ]
}
