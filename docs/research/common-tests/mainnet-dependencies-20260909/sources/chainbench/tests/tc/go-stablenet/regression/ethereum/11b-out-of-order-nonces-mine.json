{
  "schemaVersion": "2",
  "kind": "case",
  "id": "out-of-order-nonces-mine",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "out-of-order-nonces-mine-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundHash",
      "to": "$acct",
      "value": "10000000000000000000"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "100000000000000",
      "maxPriorityFeePerGas": "30000000000000",
      "nonce": "2",
      "on": "en1",
      "to": "0x00000000000000000000000000000000C0FFEE11",
      "value": "1",
      "wait": false
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "100000000000000",
      "maxPriorityFeePerGas": "30000000000000",
      "nonce": "1",
      "on": "en1",
      "to": "0x00000000000000000000000000000000C0FFEE11",
      "value": "1",
      "wait": false
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "100000000000000",
      "maxPriorityFeePerGas": "30000000000000",
      "nonce": "0",
      "on": "en1",
      "to": "0x00000000000000000000000000000000C0FFEE11",
      "value": "1",
      "wait": false
    },
    {
      "address": "$acct",
      "compare": "Equal",
      "do": "waitFor",
      "expected": "3",
      "pollInterval": "2s",
      "source": "nonceAt",
      "timeout": "90s"
    },
    {
      "expect": "txStatus",
      "hash": "$fundHash",
      "is": "0x1"
    },
    {
      "address": "$acct",
      "compare": "Equal",
      "expect": "nonceAt",
      "is": "3"
    }
  ]
}
