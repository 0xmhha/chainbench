{
  "schemaVersion": "2",
  "kind": "case",
  "id": "basic-txpool-propagation",
  "description": "Verify TX propagation across nodes and txpool drain under load (원본 basic/txpool-propagation.sh)",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "basic-stablenet",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4,
      "en": 1
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "120s"
    },
    {
      "do": "newAccount",
      "save": "r",
      "saveKey": "rk"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8",
      "to": "$r",
      "value": "1",
      "expect": "receipt"
    },
    {
      "expect": "balanceAt",
      "on": "node2",
      "address": "$r",
      "compare": "Greater",
      "is": "0"
    }
  ]
}
