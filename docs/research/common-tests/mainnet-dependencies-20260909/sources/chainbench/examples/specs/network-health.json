{
  "schemaVersion": "1",
  "id": "network-health",
  "chain": { "name": "stablenet", "binary": "go-stablenet" },
  "requires": ["rpc"],
  "assertions": [
    { "assert": "sameBlockHash", "block": "0x0", "onEach": ["bp1", "bp2", "bp3", "bp4"] },
    { "assert": "blockAdvance", "timeout": "30s" }
  ]
}
