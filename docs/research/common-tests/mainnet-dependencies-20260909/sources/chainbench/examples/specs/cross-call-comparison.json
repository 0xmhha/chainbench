{
  "schemaVersion": "1",
  "id": "cross-call-comparison",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "go-stablenet" },
  "requires": ["rpc"],
  "steps": [
    {
      "read": {
        "source": "call",
        "to": "0x0000000000000000000000000000000000001001",
        "data": "0x18160ddd",
        "save": "totalSupply"
      }
    },
    {
      "read": {
        "source": "balanceAt",
        "address": "0x0000000000000000000000000000000000000001",
        "save": "holderBalance"
      }
    }
  ],
  "assertions": [
    {
      "assert": "call",
      "to": "0x0000000000000000000000000000000000001001",
      "data": "0x18160ddd",
      "compare": "Equal",
      "expected": "$totalSupply"
    },
    {
      "assert": "balanceAt",
      "address": "0x0000000000000000000000000000000000000001",
      "compare": "LessOrEqual",
      "expected": "$totalSupply"
    },
    {
      "assert": "balanceAt",
      "address": "0x0000000000000000000000000000000000000001",
      "compare": "Equal",
      "expected": "$holderBalance"
    }
  ]
}
