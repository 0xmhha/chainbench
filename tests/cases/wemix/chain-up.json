{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wemix-chain-up",
  "env": "wemix",
  "requires": ["rpc"],
  "steps": [
    { "do": "waitBlock", "target": 2, "timeout": "180s" },
    { "expect": "chainId", "compare": "Greater", "is": "0" },
    { "expect": "blockNumber", "compare": "GreaterOrEqual", "is": "2" },
    { "expect": "rpc", "method": "net_peerCount", "compare": "NotEqual", "is": "0x0" }
  ]
}
