{
  "schemaVersion": "2",
  "kind": "case",
  "id": "e1-mixed-producers",
  "env": "e1-mixed-stablenet",
  "requires": ["rpc", "consensus"],
  "steps": [
    { "do": "waitBlock", "target": 3, "timeout": "120s" },
    { "expect": "rpc", "method": "istanbul_getValidators", "params": ["latest"], "compare": "Len", "is": 3 },
    { "expect": "blockAdvance", "on": "node1", "timeout": "60s", "pollInterval": "2s" }
  ]
}
