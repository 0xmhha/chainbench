{
  "schemaVersion": "2",
  "kind": "case",
  "id": "fault-two-down",
  "env": "fault-stablenet",
  "requires": ["rpc", "consensus", "process"],
  "steps": [
    { "do": "waitBlock", "target": 3, "timeout": "120s" },
    { "expect": "sameBlockHash", "block": "latest" },
    { "do": "stopNode", "on": "node3" },
    { "do": "stopNode", "on": "node4" },
    { "expect": "blockHalt", "on": "node1", "within": "12s", "maxAdvance": 1 },
    { "do": "startNode", "on": "node3" },
    { "expect": "blockAdvance", "on": "node1", "timeout": "90s", "pollInterval": "2s" },
    { "do": "startNode", "on": "node4" }
  ]
}
