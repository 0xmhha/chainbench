{
  "schemaVersion": "2",
  "kind": "env",
  "id": "wemix-wbft",
  "chain": "wbft",
  "binaries": {
    "producer": "${GWEMIX_BIN:-gwemix}",
    "validator": "${GWBFT_BIN:-gwbft}"
  },
  "keys": { "nodekeys": { "source": "preset", "ref": "keys/preset" } },
  "upgrade": {
    "profile": "profiles/wemix-upgrade.yaml",
    "template": "${GOWEMIX_TEMPLATE}"
  }
}
