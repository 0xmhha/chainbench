{
  "schemaVersion": "2", "kind": "case", "id": "basic-peers",
  "env": "basic-stablenet", "requires": ["rpc"],
  "steps": [
    { "do": "waitBlock", "target": 2, "timeout": "120s" },
    { "expect": "peerCount", "on": "node1", "compare": "GreaterOrEqual", "is": "1" },
    { "expect": "peerCount", "on": "node2", "compare": "GreaterOrEqual", "is": "1" },
    { "expect": "peerCount", "on": "node3", "compare": "GreaterOrEqual", "is": "1" },
    { "expect": "peerCount", "on": "node4", "compare": "GreaterOrEqual", "is": "1" },
    { "expect": "peerCount", "on": "en1", "compare": "GreaterOrEqual", "is": "1" }
  ]
}
