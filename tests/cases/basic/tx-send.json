{
  "schemaVersion": "2", "kind": "case", "id": "basic-tx-send",
  "env": "basic-stablenet", "requires": ["rpc"],
  "steps": [
    { "do": "waitBlock", "target": 2, "timeout": "120s" },
    { "do": "newAccount", "save": "r", "saveKey": "rk" },
    { "do": "sendTx", "on": "node1", "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8", "to": "$r", "value": "1", "expect": "receipt" },
    { "expect": "balanceAt", "on": "node1", "address": "$r", "compare": "Greater", "is": "0" }
  ]
}
