{
  "schemaVersion": "1",
  "id": "feecap-above-min-accepted",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "go-stablenet" },
  "requires": ["rpc"],
  "steps": [
    { "read": { "source": "rpcCall", "method": "eth_blockNumber", "save": "n" } },
    { "read": { "source": "rpcCall", "method": "eth_getBlockByNumber",
                "params": ["$n", false], "select": "baseFeePerGas", "save": "base" } },
    { "read": { "source": "rpcCall", "method": "istanbul_getWbftExtraInfo",
                "params": ["$n"], "select": "gasTip", "save": "tip" } },
    { "read": { "source": "derive", "op": "sum", "of": ["$base", "$base", "$tip"], "save": "feecap" } },
    { "sendTx": { "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8",
                  "to": "0x00000000000000000000000000000000C0FFEE0E",
                  "value": "1", "gas": "21000",
                  "maxFeePerGas": "$feecap", "maxPriorityFeePerGas": "$tip",
                  "save": "hash" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$hash", "expected": "0x1" }
  ]
}
