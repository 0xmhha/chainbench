{
  "schemaVersion": "1",
  "id": "revert-tx-status-zero",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "sendTx": { "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8",
                  "data": "0x600580600b6000396000f360006000fd",
                  "gas": "200000", "save": "dhash" } },
    { "read": { "source": "rpcCall", "method": "eth_getTransactionReceipt",
                "params": ["$dhash"], "select": "contractAddress", "save": "addr" } },
    { "sendTx": { "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8",
                  "to": "$addr", "gas": "100000",
                  "expect": "revert", "save": "chash" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$dhash", "expected": "0x1" },
    { "assert": "rpcCall", "method": "eth_getTransactionReceipt",
      "params": ["$chash"], "select": "status",
      "compare": "Equal", "expected": "0x0" }
  ]
}
