{
  "schemaVersion": "1",
  "id": "mint-proposal-executes",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "read": { "source": "balanceAt", "address": "0x00000000000000000000000000000000C0FFEE05", "save": "b0" } },
    { "read": { "source": "derive", "op": "sum", "of": ["$b0", "1000000000000000000"], "save": "want" } },
    { "sendTx": { "on": "en1",
                  "from": "node1",
                  "to": "0x0000000000000000000000000000000000001003",
                  "gas": "0x16e360",
                  "data": "",
                  "save": "propHash" } },
    { "read": { "source": "receiptLog", "hash": "$propHash",
                "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a",
                "topic": 1, "save": "pid" } },
    { "read": { "source": "derive", "op": "abiCall", "selector": "0x98951b56", "of": ["$pid"], "save": "approveData" } },
    { "sendTx": { "on": "en2",
                  "from": "node2",
                  "to": "0x0000000000000000000000000000000000001003",
                  "gas": "0x16e360",
                  "data": "$approveData",
                  "save": "apHash" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$propHash", "expected": "0x1" },
    { "assert": "txStatus", "hash": "$apHash", "expected": "0x1" },
    { "assert": "balanceAt", "address": "0x00000000000000000000000000000000C0FFEE05", "expected": "$want" }
  ]
}
