{
  "schemaVersion": "1",
  "id": "direct-blacklist-call-rejected",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "newAccount": { "save": "acct", "saveKey": "acctKey" } },
    { "sendTx": { "on": "en1",
                  "from": "node1",
                  "to": "$acct",
                  "value": "10000000000000000000", "gas": "21000",
                  "save": "fundHash" } },
    { "sendTx": { "on": "en1",
                  "key": "$acctKey",
                  "to": "0x0000000000000000000000000000000000B00003",
                  "data": "0xf9f92be400000000000000000000000000000000000000000000000000000000c0ffee40",
                  "expect": "reject" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$fundHash", "expected": "0x1" }
  ]
}
