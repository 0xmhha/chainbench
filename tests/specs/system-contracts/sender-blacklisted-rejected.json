{
  "schemaVersion": "1",
  "id": "sender-blacklisted-rejected",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "newAccount": { "save": "acct", "saveKey": "acctKey" } },
    { "sendTx": { "on": "en1",
                  "from": "node1",
                  "to": "$acct",
                  "value": "10000000000000000000", "gas": "21000",
                  "save": "fundHash" } },
    { "read": { "source": "derive", "op": "abiCall", "selector": "0x0d321273", "of": ["$acct"], "save": "addBlData" } },
    { "sendTx": { "on": "en1",
                  "from": "node1",
                  "to": "0x0000000000000000000000000000000000001004",
                  "gas": "0x16e360",
                  "data": "$addBlData",
                  "save": "addHash" } },
    { "read": { "source": "receiptLog", "hash": "$addHash",
                "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a",
                "topic": 1, "save": "addPid" } },
    { "read": { "source": "derive", "op": "abiCall", "selector": "0x98951b56", "of": ["$addPid"], "save": "addApprove" } },
    { "sendTx": { "on": "en2",
                  "from": "node2",
                  "to": "0x0000000000000000000000000000000000001004",
                  "gas": "0x16e360",
                  "data": "$addApprove",
                  "save": "addApHash" } },
    { "sendTx": { "on": "en1",
                  "key": "$acctKey",
                  "to": "0x00000000000000000000000000000000C0FFEE10",
                  "value": "1",
                  "expect": "reject", "reason": "blacklist" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$fundHash", "expected": "0x1" },
    { "assert": "txStatus", "hash": "$addApHash", "expected": "0x1" }
  ]
}
