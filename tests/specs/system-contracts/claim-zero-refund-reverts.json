{
  "schemaVersion": "1",
  "id": "claim-zero-refund-reverts",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "newAccount": { "save": "acct", "saveKey": "acctKey" } },
    { "sendTx": { "on": "en1",
                  "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8",
                  "to": "$acct",
                  "value": "100000000000000000000", "gas": "21000",
                  "save": "fundHash" } },
    { "sendTx": { "on": "en1",
                  "key": "$acctKey",
                  "to": "0x0000000000000000000000000000000000001003",
                  "gas": "0xb71b0",
                  "data": "0x936834b9",
                  "expect": "revert",
                  "save": "claimHash" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$fundHash", "expected": "0x1" }
  ]
}
