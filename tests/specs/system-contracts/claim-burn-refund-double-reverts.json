{
  "schemaVersion": "1",
  "id": "claim-burn-refund-double-reverts",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "sendTx": { "on": "en2",
                  "from": "node2",
                  "to": "0x0000000000000000000000000000000000001003",
                  "gas": "0xb71b0",
                  "value": "0xde0b6b3a7640000",
                  "data": "",
                  "save": "burnHash" } },
    { "read": { "source": "receiptLog", "hash": "$burnHash",
                "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a",
                "topic": 1, "save": "burnPid" } },
    { "read": { "source": "derive", "op": "abiCall", "selector": "0xe0a8f6f5", "of": ["$burnPid"], "save": "cancelData" } },
    { "sendTx": { "on": "en2",
                  "from": "node2",
                  "to": "0x0000000000000000000000000000000000001003",
                  "gas": "0xb71b0", "data": "$cancelData", "save": "cancelHash" } },
    { "sendTx": { "on": "en2",
                  "from": "node2",
                  "to": "0x0000000000000000000000000000000000001003",
                  "gas": "0xb71b0", "data": "0x936834b9", "save": "claim1Hash" } },
    { "sendTx": { "on": "en2",
                  "from": "node2",
                  "to": "0x0000000000000000000000000000000000001003",
                  "gas": "0xb71b0", "data": "0x936834b9",
                  "expect": "revert", "save": "claim2Hash" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$burnHash", "expected": "0x1" },
    { "assert": "txStatus", "hash": "$cancelHash", "expected": "0x1" },
    { "assert": "txStatus", "hash": "$claim1Hash", "expected": "0x1" }
  ]
}
