{
  "schemaVersion": "1",
  "id": "gastip-governance-updates-header",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "read": { "source": "rpcCall", "method": "eth_blockNumber", "save": "h0" } },
    { "read": { "source": "rpcCall", "method": "istanbul_getWbftExtraInfo", "params": ["$h0"], "select": "gasTip", "save": "orig" } },

    { "read": { "source": "derive", "op": "abiCall", "selector": "0xeeaf6816", "of": ["25000000000000"], "save": "propData" } },
    { "sendTx": { "on": "en1",
                  "from": "node1",
                  "to": "0x0000000000000000000000000000000000001001",
                  "gas": "0x16e360",
                  "data": "$propData", "save": "propHash" } },
    { "read": { "source": "receiptLog", "hash": "$propHash",
                "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a",
                "topic": 1, "save": "pid" } },
    { "read": { "source": "derive", "op": "abiCall", "selector": "0x98951b56", "of": ["$pid"], "save": "approveData" } },
    { "sendTx": { "on": "en2",
                  "from": "node2",
                  "to": "0x0000000000000000000000000000000000001001",
                  "gas": "0x16e360",
                  "data": "$approveData", "save": "apHash" } },
    { "waitFor": { "source": "rpcCall", "method": "istanbul_getWbftExtraInfo", "params": ["@latest"],
                   "select": "gasTip", "compare": "Equal", "expected": "25000000000000",
                   "timeout": "60s", "pollInterval": "1s" } },

    { "read": { "source": "derive", "op": "abiCall", "selector": "0xeeaf6816", "of": ["$orig"], "save": "restoreData" } },
    { "sendTx": { "on": "en1",
                  "from": "node1",
                  "to": "0x0000000000000000000000000000000000001001",
                  "gas": "0x16e360",
                  "data": "$restoreData", "save": "restoreHash" } },
    { "read": { "source": "receiptLog", "hash": "$restoreHash",
                "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a",
                "topic": 1, "save": "pid2" } },
    { "read": { "source": "derive", "op": "abiCall", "selector": "0x98951b56", "of": ["$pid2"], "save": "approveData2" } },
    { "sendTx": { "on": "en2",
                  "from": "node2",
                  "to": "0x0000000000000000000000000000000000001001",
                  "gas": "0x16e360",
                  "data": "$approveData2", "save": "apHash2" } },
    { "waitFor": { "source": "rpcCall", "method": "istanbul_getWbftExtraInfo", "params": ["@latest"],
                   "select": "gasTip", "compare": "Equal", "expected": "$orig",
                   "timeout": "60s", "pollInterval": "1s" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$propHash", "expected": "0x1" },
    { "assert": "txStatus", "hash": "$apHash", "expected": "0x1" },
    { "assert": "txStatus", "hash": "$restoreHash", "expected": "0x1" },
    { "assert": "txStatus", "hash": "$apHash2", "expected": "0x1" },
    { "assert": "logs", "address": "0x0000000000000000000000000000000000001001",
      "topics": ["0x535d54b8a14e2287f10efd7add38eca14bcf44eb31651abf8eec2499eba393a3"],
      "fromBlock": "earliest", "toBlock": "latest",
      "select": "count", "compare": "GreaterOrEqual", "expected": "1" }
  ]
}
