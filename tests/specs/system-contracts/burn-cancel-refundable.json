{
  "schemaVersion": "1",
  "id": "burn-cancel-refundable",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "read": { "source": "derive", "op": "abiCall", "selector": "0xb03d36cd", "of": ["0x2493a84a8f83cb87fdcbe0bb3b2d313f69a58d3c"], "save": "refBalCall" } },
    { "read": { "source": "call", "to": "0x0000000000000000000000000000000000001003", "data": "$refBalCall", "save": "refBefore" } },
    { "sendTx": { "on": "en2",
                  "from": "0x2493a84a8f83cb87fdcbe0bb3b2d313f69a58d3c",
                  "to": "0x0000000000000000000000000000000000001003",
                  "gas": "0xb71b0",
                  "value": "0xde0b6b3a7640000",
                  "data": "",
                  "save": "burnHash" } },
    { "read": { "source": "receiptLog", "hash": "$burnHash",
                "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a",
                "topic": 1, "save": "cancelPid" } },
    { "read": { "source": "derive", "op": "abiCall", "selector": "0xe0a8f6f5", "of": ["$cancelPid"], "save": "cancelData" } },
    { "sendTx": { "on": "en2",
                  "from": "0x2493a84a8f83cb87fdcbe0bb3b2d313f69a58d3c",
                  "to": "0x0000000000000000000000000000000000001003",
                  "gas": "0xb71b0",
                  "data": "$cancelData",
                  "save": "cancelHash" } },
    { "read": { "source": "call", "to": "0x0000000000000000000000000000000000001003", "data": "$refBalCall", "save": "refAfter" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$burnHash", "expected": "0x1" },
    { "assert": "txStatus", "hash": "$cancelHash", "expected": "0x1" },
    { "assert": "derive", "op": "diff", "of": ["$refAfter", "$refBefore"],
      "compare": "Equal", "expected": "1000000000000000000" }
  ]
}
