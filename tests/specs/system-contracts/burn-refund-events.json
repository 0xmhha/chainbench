{
  "schemaVersion": "1",
  "id": "burn-refund-events",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "sendTx": { "on": "en4",
                  "from": "0x8eb79036bc0f3aba136ef18b3a2fb8c1188939a6",
                  "to": "0x0000000000000000000000000000000000001003",
                  "gas": "0xb71b0",
                  "value": "0xde0b6b3a7640000",
                  "data": "",
                  "save": "burnHash" } },
    { "read": { "source": "receiptLog", "hash": "$burnHash",
                "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a",
                "topic": 1, "save": "burnPid" } },
    { "read": { "source": "derive", "op": "abiCall", "selector": "0xe0a8f6f5", "of": ["$burnPid"], "save": "cancelData" } },
    { "sendTx": { "on": "en4",
                  "from": "0x8eb79036bc0f3aba136ef18b3a2fb8c1188939a6",
                  "to": "0x0000000000000000000000000000000000001003",
                  "gas": "0xb71b0", "data": "$cancelData", "save": "cancelHash" } },
    { "read": { "source": "rpcCall", "method": "eth_getTransactionReceipt",
                "params": ["$cancelHash"], "select": "blockNumber", "save": "cancelBlk" } },
    { "sendTx": { "on": "en4",
                  "from": "0x8eb79036bc0f3aba136ef18b3a2fb8c1188939a6",
                  "to": "0x0000000000000000000000000000000000001003",
                  "gas": "0xb71b0", "data": "0x936834b9", "save": "claimHash" } },
    { "read": { "source": "rpcCall", "method": "eth_getTransactionReceipt",
                "params": ["$claimHash"], "select": "blockNumber", "save": "claimBlk" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$burnHash", "expected": "0x1" },
    { "assert": "txStatus", "hash": "$cancelHash", "expected": "0x1" },
    { "assert": "txStatus", "hash": "$claimHash", "expected": "0x1" },
    { "assert": "logs",
      "address": "0x0000000000000000000000000000000000001003",
      "topics": ["0x116044c8ec23de4088f4a50cf4f8a504ec887c439452af3be4f57f6c77bf2062"],
      "fromBlock": "$cancelBlk", "toBlock": "$cancelBlk",
      "select": "count", "compare": "GreaterOrEqual", "expected": "1" },
    { "assert": "logs",
      "address": "0x0000000000000000000000000000000000001003",
      "topics": ["0x9543fa265d2616af3e7021d8b5a7d1271eb7bba960908675ce3bddaf60c1af24"],
      "fromBlock": "$claimBlk", "toBlock": "$claimBlk",
      "select": "count", "compare": "GreaterOrEqual", "expected": "1" }
  ]
}
