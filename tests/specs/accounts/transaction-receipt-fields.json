{
  "schemaVersion": "1",
  "id": "transaction-receipt-fields",
  "applicableChains": "stablenet,wbft",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "sendTx": { "from": "node1",
                  "to": "0x00000000000000000000000000000000C0FFEE06",
                  "value": "1", "gas": "21000", "save": "hash" } }
  ],
  "assertions": [
    { "assert": "rpcCall", "method": "eth_getTransactionReceipt", "params": ["$hash"],
      "select": "status", "compare": "Equal", "expected": "0x1" },
    { "assert": "rpcCall", "method": "eth_getTransactionReceipt", "params": ["$hash"],
      "select": "effectiveGasPrice", "compare": "NotNil" },
    { "assert": "rpcCall", "method": "eth_getTransactionReceipt", "params": ["$hash"],
      "select": "logs", "compare": "NotNil" }
  ]
}
