{
  "schemaVersion": "1",
  "id": "fee-delegated-unfunded-feepayer-rejected",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable",
             "genesisOverlay": { "config": { "applepieBlock": 0 } } },
  "requires": ["rpc"],
  "steps": [
    { "newAccount": { "save": "sender", "saveKey": "senderKey" } },
    { "newAccount": { "save": "feePayer", "saveKey": "feePayerKey" } },

    { "sendTx": { "on": "en1",
                  "from": "node1",
                  "to": "$sender",
                  "value": "10000000000000000000", "gas": "21000",
                  "save": "fundHash" } },

    { "sendTx": { "on": "en1",
                  "key": "$senderKey",
                  "feePayerKey": "$feePayerKey",
                  "to": "0x00000000000000000000000000000000C0FFEE10",
                  "value": "1",
                  "expect": "reject" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$fundHash", "expected": "0x1" },
    { "assert": "blockNumber", "compare": "GreaterOrEqual", "expected": "1" }
  ]
}
