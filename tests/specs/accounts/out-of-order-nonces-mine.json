{
  "schemaVersion": "1",
  "id": "out-of-order-nonces-mine",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "newAccount": { "save": "acct", "saveKey": "acctKey" } },
    { "sendTx": { "on": "en1", "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8", "to": "$acct",
                  "value": "10000000000000000000", "gas": "21000", "save": "fundHash" } },
    { "sendTx": { "on": "en1", "key": "$acctKey", "to": "0x00000000000000000000000000000000C0FFEE11", "value": "1",
                  "nonce": "2", "maxFeePerGas": "100000000000000", "maxPriorityFeePerGas": "30000000000000", "wait": false } },
    { "sendTx": { "on": "en1", "key": "$acctKey", "to": "0x00000000000000000000000000000000C0FFEE11", "value": "1",
                  "nonce": "1", "maxFeePerGas": "100000000000000", "maxPriorityFeePerGas": "30000000000000", "wait": false } },
    { "sendTx": { "on": "en1", "key": "$acctKey", "to": "0x00000000000000000000000000000000C0FFEE11", "value": "1",
                  "nonce": "0", "maxFeePerGas": "100000000000000", "maxPriorityFeePerGas": "30000000000000", "wait": false } },
    { "waitFor": { "source": "nonceAt", "address": "$acct", "compare": "Equal", "expected": "3",
                   "timeout": "90s", "pollInterval": "2s" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$fundHash", "expected": "0x1" },
    { "assert": "nonceAt", "address": "$acct", "compare": "Equal", "expected": "3" }
  ]
}
