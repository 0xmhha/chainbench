{
  "schemaVersion": "1",
  "id": "gas-limit-exceeds-block-rejected",
  "applicableChains": "stablenet,wbft",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "read": { "source": "rpcCall", "method": "eth_getBlockByNumber",
                "params": ["latest", false], "select": "gasLimit", "save": "gl" } },
    { "read": { "source": "derive", "op": "sum", "of": ["$gl", "1"], "save": "over" } },
    { "sendTx": { "from": "node1",
                  "to": "0x00000000000000000000000000000000C0FFEE10",
                  "value": "1", "gas": "$over",
                  "expect": "reject" } }
  ],
  "assertions": [
    { "assert": "blockNumber", "compare": "GreaterOrEqual", "expected": "0x1" }
  ]
}
