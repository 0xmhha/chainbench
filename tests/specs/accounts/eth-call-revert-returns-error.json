{
  "schemaVersion": "1",
  "id": "eth-call-revert-returns-error",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "sendTx": { "on": "en1", "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8",
                  "data": "0x6080604052348015600e575f5ffd5b50606a80601a5f395ff3fe6080604052348015600e575f5ffd5b50600436106026575f3560e01c8063a9cc471814602a575b5f5ffd5b60306032565b005b60405162461bcd60e51b815260206004820152600960248201526810905117d25394155560ba1b604482015260640160405180910390fd",
                  "gas": "300000", "save": "dhash" } },
    { "read": { "source": "rpcCall", "method": "eth_getTransactionReceipt",
                "params": ["$dhash"], "select": "contractAddress", "save": "addr" } },
    { "waitFor": { "source": "codeAt", "address": "$addr", "compare": "NotEqual", "expected": "0x",
                   "timeout": "60s", "pollInterval": "1s" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$dhash", "expected": "0x1" },
    { "assert": "callError", "to": "$addr", "data": "0xa9cc4718" }
  ]
}
