{
  "schemaVersion": "1",
  "id": "effective-gas-price",
  "applicableChains": "stablenet,wbft",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "sendTx": { "from": "node1",
                  "to": "0x00000000000000000000000000000000C0FFEE0B",
                  "value": "1", "gas": "21000", "save": "hash" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$hash", "expected": "0x1" },
    { "assert": "rpcCall", "method": "eth_getTransactionReceipt", "params": ["$hash"],
      "select": "effectiveGasPrice", "compare": "Greater", "expected": "0" },
    { "assert": "rpcCall", "method": "eth_getTransactionReceipt", "params": ["$hash"],
      "select": "gasUsed", "compare": "GreaterOrEqual", "expected": "21000" }
  ]
}
