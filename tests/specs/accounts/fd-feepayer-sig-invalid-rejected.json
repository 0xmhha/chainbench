{
  "schemaVersion": "1",
  "id": "fd-feepayer-sig-invalid-rejected",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable",
             "genesisOverlay": { "config": { "applepieBlock": 0 } } },
  "requires": ["rpc"],
  "steps": [
    { "newAccount": { "save": "acct", "saveKey": "acctKey" } },
    { "sendTx": { "on": "en1", "from": "node1", "to": "$acct",
                  "value": "10000000000000000000", "gas": "21000", "save": "fundHash" } },
    { "sendRawTampered": { "on": "en1", "senderKey": "$acctKey", "feePayerKey": "$acctKey",
                           "to": "0x00000000000000000000000000000000C0FFEE21", "value": "1", "which": "feepayer" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$fundHash", "expected": "0x1" },
    { "assert": "blockNumber", "compare": "GreaterOrEqual", "expected": "1" }
  ]
}
