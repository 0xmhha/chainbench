{
  "schemaVersion": "2",
  "kind": "case",
  "id": "estimate-gas",
  "description": "RT-A-3-04 — eth_estimateGas 정상 동작 (원본 regression/ethereum/22-test-estimate-gas). 전에는 추정값이 21000 이상인지만 보았다. CT-CONTRACT-004 의 기대 결과는 \"성공하고 사용 가스가 추정값 이하다\" 인데, 추정값 하나만 보면 실제 실행과 견주지 않으므로 추정이 모자라도 통과한다. 그래서 추정값을 읽어 그 값을 그대로 가스 한도로 주고 보낸 뒤, 영수증의 사용 가스가 추정값을 넘지 않는지 본다. 한도를 추정값으로 준 것 자체가 추정이 충분했는지에 대한 검사이기도 하다 — 모자랐다면 가스 소진으로 실패한다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "data": "0x",
      "do": "read",
      "save": "est",
      "source": "estimateGas",
      "to": "0x0000000000000000000000000000000000000001"
    },
    {
      "compare": "GreaterOrEqual",
      "data": "0x",
      "expect": "estimateGas",
      "is": "21000",
      "to": "0x0000000000000000000000000000000000000001"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "$est",
      "save": "hash",
      "to": "0x0000000000000000000000000000000000000001",
      "value": "1"
    },
    {
      "expect": "txStatus",
      "hash": "$hash",
      "is": "0x1"
    },
    {
      "compare": "LessOrEqual",
      "expect": "rpcCall",
      "is": "$est",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$hash"
      ],
      "select": "gasUsed"
    }
  ]
}
