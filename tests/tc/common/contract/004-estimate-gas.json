{
  "schemaVersion": "2",
  "kind": "case",
  "id": "estimate-gas",
  "description": "RT-A-3-04 — eth_estimateGas 정상 동작 (원본 regression/ethereum/22-test-estimate-gas)",
  "requires": [
    "rpc"
  ],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "compare": "GreaterOrEqual",
      "data": "0x",
      "expect": "estimateGas",
      "is": "21000",
      "to": "0x0000000000000000000000000000000000000001"
    }
  ]
}
