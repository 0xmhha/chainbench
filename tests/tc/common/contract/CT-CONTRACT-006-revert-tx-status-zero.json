{
  "schemaVersion": "2",
  "kind": "case",
  "id": "revert-tx-status-zero",
  "description": "CT-CONTRACT-006 — 되돌리는 호출은 블록에 들어가되 영수증 상태가 실패이고, 쓴 가스만 차감된다 (기존 명세 RT-A-3-06, TX-017, 절차는 docs/tc/common/06-detailed-procedures/04-contract.md 의 CT-CONTRACT-006). 2026-09-30 에 revert-tx-status-zero, stablenet-negative-tx-revert, wbft-revert-status-zero, wemix-revert-status-zero 네 파일을 하나로 합쳤다. 체인별 두 파일은 preset 과 id 만 달랐다. 합치면서 잃을 뻔한 두 가지를 옮겨 왔다. 하나는 negative-tx-revert 가 보던 배포 코드 확인으로, 배포된 런타임이 정확히 0x60006000fd 인지 본다. 코드가 비어 있지 않은지만 보면 엉뚱한 코드가 올라가도 통과한다. 다른 하나는 체인별 파일이 보던 blockAdvance 로, 되돌린 트랜잭션이 블록을 깨뜨리지 않고 체인이 계속 나아가는지 본다. 차감액은 문서 기대 결과 \"쓴 가스만 차감된다\" 를 재는 부분이다. 호출자를 새 계정으로 두는 것은 node1 이 블록 보상을 받아 잔액이 저절로 움직이기 때문이다. 쓴 가스가 한도(100000)보다 작은지도 본다. 한도를 다 쓰면 REVERT 가 아니라 가스 소진이고, 그때는 '쓴 가스만 차감' 과 '한도만큼 차감' 을 구별할 수 없다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "200000",
      "data": "0x600580600b6000396000f360006000fd",
      "save": "dhash"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$dhash"
      ],
      "select": "contractAddress",
      "save": "addr"
    },
    {
      "expect": "txStatus",
      "hash": "$dhash",
      "is": "0x1"
    },
    {
      "do": "waitFor",
      "source": "codeAt",
      "address": "$addr",
      "compare": "Equal",
      "expected": "0x60006000fd",
      "pollInterval": "1s",
      "timeout": "60s"
    },
    {
      "do": "newAccount",
      "save": "caller",
      "saveKey": "callerKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "to": "$caller",
      "value": "10000000000000000000",
      "gas": "21000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "read",
      "source": "balanceAt",
      "address": "$caller",
      "save": "before"
    },
    {
      "do": "sendTx",
      "key": "$callerKey",
      "to": "$addr",
      "gas": "100000",
      "expect": "revert",
      "save": "chash",
      "timeout": "120s"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$chash"
      ],
      "select": "status",
      "compare": "Equal",
      "is": "0x0"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$chash"
      ],
      "select": "gasUsed",
      "compare": "Less",
      "is": "100000"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$chash"
      ],
      "select": "gasUsed",
      "save": "used"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$chash"
      ],
      "select": "effectiveGasPrice",
      "save": "price"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "mul",
      "of": [
        "$used",
        "$price"
      ],
      "save": "fee"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "diff",
      "of": [
        "$before",
        "$fee"
      ],
      "save": "want"
    },
    {
      "expect": "balanceAt",
      "address": "$caller",
      "compare": "Equal",
      "is": "$want"
    },
    {
      "expect": "blockAdvance",
      "timeout": "90s"
    }
  ]
}
