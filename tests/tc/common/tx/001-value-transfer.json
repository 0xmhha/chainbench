{
  "schemaVersion": "2",
  "kind": "case",
  "id": "value-transfer",
  "description": "RT-A-4-03 — eth_sendRawTransaction 서명된 tx 전파 (원본 regression/ethereum/28-test-send-raw-tx) 시험 대상 트랜잭션은 노드가 아니라 별도 계정이 서명해 eth_sendRawTransaction 으로 보낸다. from 에 노드 이름을 적으면 eth_sendTransaction 이 되어 노드가 자기 계정으로 서명하는데, 그것은 실제 사용자가 보내는 모양이 아니고 원본 시험 스크립트가 cast send --private-key 로 하던 것과도 다르다. 계정을 새로 만들어 faucet 에서 자금을 받은 뒤 그 열쇠로 서명한다. 자금을 넣는 첫 전송만 노드 서명인데, 제네시스가 자금을 준 계정의 열쇠는 노드가 들고 있어 달리 할 수가 없다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "sender",
      "saveKey": "senderKey"
    },
    {
      "do": "sendTx",
      "from": "faucet",
      "to": "$sender",
      "value": "3000000000000000000",
      "gas": "21000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getBalance",
      "params": [
        "0x00000000000000000000000000000000C0FFEE01",
        "latest"
      ],
      "save": "before"
    },
    {
      "do": "sendTx",
      "key": "$senderKey",
      "to": "0x00000000000000000000000000000000C0FFEE01",
      "value": "1000000000000000000",
      "save": "hash",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "expect": "txStatus",
      "hash": "$hash",
      "is": "0x1"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getBalance",
      "params": [
        "0x00000000000000000000000000000000C0FFEE01",
        "latest"
      ],
      "save": "after"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$after",
        "$before"
      ],
      "compare": "Equal",
      "is": "1000000000000000000"
    }
  ]
}
