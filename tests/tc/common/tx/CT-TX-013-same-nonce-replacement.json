{
  "schemaVersion": "2",
  "kind": "case",
  "id": "replacement-tx",
  "description": "TX-013 / RT-A-2-09 — fresh nonce 0 계정에서 nonce 2의 queued 거래를 보낸 뒤 정확한 hash·queued 1·pending 0을 확인한다. 같은 nonce의 fee cap과 tip을 두 배로 올려 교체하고 정확한 새 hash만 남았는지 확인한다. nonce 0·1로 격차를 채운 뒤 세 거래 성공·계정 nonce 3·교체 거래 nonce 2·기존 hash의 eth_getTransactionByHash null 및 영수증 부재를 검증한다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundHash",
      "to": "$acct",
      "value": "10000000000000000000"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_maxPriorityFeePerGas",
      "save": "tip"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "baseFeePerGas",
      "save": "base"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$base",
        "$base",
        "$tip"
      ],
      "save": "feeCap"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "mul",
      "of": [
        "$tip",
        "2"
      ],
      "save": "tip2"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "mul",
      "of": [
        "$feeCap",
        "2"
      ],
      "save": "feeCap2"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "nonce": "2",
      "on": "node2",
      "save": "tx1",
      "to": "0x00000000000000000000000000000000C0FFEE12",
      "value": "1",
      "wait": false
    },
    {
      "expect": "rpcCall",
      "on": "node2",
      "method": "txpool_contentFrom",
      "params": [
        "$acct"
      ],
      "select": "queued.2.hash",
      "compare": "EqualCI",
      "is": "$tx1"
    },
    {
      "expect": "rpcCall",
      "on": "node2",
      "method": "txpool_contentFrom",
      "params": [
        "$acct"
      ],
      "select": "queued.#",
      "compare": "Equal",
      "is": "1"
    },
    {
      "expect": "rpcCall",
      "on": "node2",
      "method": "txpool_contentFrom",
      "params": [
        "$acct"
      ],
      "select": "pending.#",
      "compare": "Equal",
      "is": "0"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "$feeCap2",
      "maxPriorityFeePerGas": "$tip2",
      "nonce": "2",
      "on": "node2",
      "save": "tx2",
      "to": "0x00000000000000000000000000000000C0FFEE12",
      "value": "1",
      "wait": false
    },
    {
      "expect": "rpcCall",
      "on": "node2",
      "method": "txpool_contentFrom",
      "params": [
        "$acct"
      ],
      "select": "queued.2.hash",
      "compare": "EqualCI",
      "is": "$tx2"
    },
    {
      "expect": "rpcCall",
      "on": "node2",
      "method": "txpool_contentFrom",
      "params": [
        "$acct"
      ],
      "select": "queued.#",
      "compare": "Equal",
      "is": "1"
    },
    {
      "expect": "rpcCall",
      "on": "node2",
      "method": "txpool_contentFrom",
      "params": [
        "$acct"
      ],
      "select": "pending.#",
      "compare": "Equal",
      "is": "0"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "nonce": "0",
      "on": "node2",
      "save": "gap0",
      "to": "0x00000000000000000000000000000000C0FFEE12",
      "value": "1",
      "wait": false
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "nonce": "1",
      "on": "node2",
      "save": "tx3",
      "to": "0x00000000000000000000000000000000C0FFEE12",
      "value": "1",
      "wait": false
    },
    {
      "compare": "Equal",
      "do": "waitFor",
      "expected": "true",
      "hash": "$tx2",
      "pollInterval": "2s",
      "source": "txMined",
      "timeout": "90s"
    },
    {
      "expect": "txStatus",
      "hash": "$fundHash",
      "is": "0x1"
    },
    {
      "expect": "txMined",
      "hash": "$tx3",
      "is": "true"
    },
    {
      "expect": "txStatus",
      "hash": "$tx3",
      "is": "0x1"
    },
    {
      "expect": "txMined",
      "hash": "$tx2",
      "is": "true"
    },
    {
      "expect": "txStatus",
      "hash": "$tx2",
      "is": "0x1"
    },
    {
      "expect": "txMined",
      "hash": "$tx1",
      "is": "false"
    },
    {
      "expect": "txStatus",
      "hash": "$gap0",
      "is": "0x1"
    },
    {
      "expect": "rpcCall",
      "on": "node2",
      "method": "eth_getTransactionByHash",
      "params": [
        "$tx1"
      ],
      "compare": "Nil",
      "is": null
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$tx2"
      ],
      "select": "nonce",
      "compare": "Equal",
      "is": "0x2"
    },
    {
      "expect": "nonceAt",
      "address": "$acct",
      "compare": "Equal",
      "is": "3"
    }
  ]
}
