{
  "schemaVersion": "2",
  "kind": "case",
  "id": "sample-minimal-value-transfer",
  "description": "v1 스펙 샘플. 이미 떠 있는 체인에 붙어 실행한다. steps 로 값을 모으고 assertions 로 판정한다. chainbench validate tests/tc/samples/01-sample-minimal.json 시험 대상 트랜잭션은 노드가 아니라 별도 계정이 서명해 eth_sendRawTransaction 으로 보낸다. from 에 노드 이름을 적으면 eth_sendTransaction 이 되어 노드가 자기 계정으로 서명하는데, 그것은 실제 사용자가 보내는 모양이 아니다. 계정을 새로 만들어 faucet 에서 자금을 받은 뒤 그 열쇠로 서명한다. 자금을 넣는 첫 전송만 노드 서명인데, 제네시스가 자금을 준 계정의 열쇠는 노드가 들고 있어 달리 할 수가 없다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "hooks": {
    "pre": [
      {
        "do": "read",
        "of": [
          "21000"
        ],
        "op": "sum",
        "save": "transferGas",
        "source": "derive"
      }
    ]
  },
  "steps": [
    {
      "address": "node2",
      "do": "read",
      "save": "balBefore",
      "source": "balanceAt"
    },
    {
      "do": "newAccount",
      "save": "sender",
      "saveKey": "senderKey"
    },
    {
      "do": "sendTx",
      "from": "faucet",
      "to": "$sender",
      "value": "3000000000000000000",
      "gas": "21000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "sendTx",
      "expect": "receipt",
      "on": "node1",
      "save": "txHash",
      "to": "node2",
      "value": "1000000000000000000",
      "key": "$senderKey",
      "timeout": "120s"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$txHash"
      ],
      "save": "txBlock",
      "select": "blockNumber",
      "source": "rpcCall"
    },
    {
      "expect": "txStatus",
      "hash": "$txHash",
      "is": "0x1"
    },
    {
      "compare": "Greater",
      "expect": "derive",
      "is": "0",
      "of": [
        "$txBlock",
        "0"
      ],
      "op": "diff"
    },
    {
      "address": "node2",
      "compare": "Greater",
      "expect": "balanceAt",
      "is": "$balBefore"
    }
  ]
}
