{
  "schemaVersion": "2",
  "kind": "case",
  "id": "keystore-fee-delegate-sign",
  "description": "CT-TX-011 — 노드 키 저장소로 대납 트랜잭션을 서명해 보내는 경로가 동작하고, 조립할 수 없는 요청은 거부된다 (기존 명세 T-3, 절차는 docs/tc/common/06-detailed-procedures/02-tx.md 의 CT-TX-011). node1 이 키 저장소로 0x2 에 서명하고(eth_signTransaction), node2 가 키 저장소로 대납 서명을 붙인다(eth_signRawFeeDelegateTransaction). 보낸 결과가 성공이고 형식 0x16, 대납자 node2, 보낸 이 node1 인지 본다. 거부는 세 체인이 같은 문구로 하는 두 가지만 본다. 대납자를 주지 않으면 'missing FeePayer', 0x2 가 아닌 legacy 서명을 넘기면 'senderTx type error' 다. T-3 의 나머지 절반인 '대납자 키로 서명할 때 형식이 맞지 않으면 거부'(checkFeeDelegateTx, PR #114)는 go-wemix 에 없어 공통에서 뺐다(부록 A). 대납 형식은 Applepie 부터라 genesis 에 applepieBlock 0 을 얹는다. 노드 키 저장소를 쓰므로 소유한 네트워크에서만 돈다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "genesis": {
      "overlay": {
        "config": {
          "applepieBlock": 0
        }
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node2",
      "method": "eth_coinbase",
      "save": "payer"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_maxPriorityFeePerGas",
      "save": "tip"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "baseFeePerGas",
      "save": "base"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$base",
        "$base",
        "$tip"
      ],
      "format": "hex",
      "save": "feeCap"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_gasPrice",
      "save": "gp"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_getTransactionCount",
      "params": [
        "node1",
        "pending"
      ],
      "save": "nonce"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_signTransaction",
      "params": [
        {
          "from": "node1",
          "to": "0x00000000000000000000000000000000C0FFEE41",
          "value": "0x1",
          "gas": "0x5208",
          "maxFeePerGas": "$feeCap",
          "maxPriorityFeePerGas": "$tip",
          "nonce": "$nonce"
        }
      ],
      "select": "raw",
      "save": "senderRaw"
    },
    {
      "expect": "rpcError",
      "on": "node2",
      "method": "eth_signRawFeeDelegateTransaction",
      "params": [
        {},
        "$senderRaw"
      ],
      "reason": "missing FeePayer"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_signTransaction",
      "params": [
        {
          "from": "node1",
          "to": "0x00000000000000000000000000000000C0FFEE41",
          "value": "0x1",
          "gas": "0x5208",
          "gasPrice": "$gp",
          "nonce": "$nonce"
        }
      ],
      "select": "raw",
      "save": "legacyRaw"
    },
    {
      "expect": "rpcError",
      "on": "node2",
      "method": "eth_signRawFeeDelegateTransaction",
      "params": [
        {
          "feePayer": "node2"
        },
        "$legacyRaw"
      ],
      "reason": "senderTx type error"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node2",
      "method": "eth_signRawFeeDelegateTransaction",
      "params": [
        {
          "feePayer": "node2"
        },
        "$senderRaw"
      ],
      "select": "raw",
      "save": "fdRaw"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_sendRawTransaction",
      "params": [
        "$fdRaw"
      ],
      "save": "h"
    },
    {
      "do": "waitFor",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h"
      ],
      "select": "status",
      "compare": "Equal",
      "expected": "0x1",
      "timeout": "90s",
      "pollInterval": "1s"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h"
      ],
      "select": "type",
      "compare": "Equal",
      "is": "0x16"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h"
      ],
      "select": "feePayer",
      "compare": "EqualCI",
      "is": "$payer"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h"
      ],
      "select": "from",
      "compare": "EqualCI",
      "is": "node1"
    }
  ]
}
