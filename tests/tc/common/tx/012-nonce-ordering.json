{
  "schemaVersion": "2",
  "kind": "case",
  "id": "nonce-ordering",
  "description": "RT-A-2-04 — Nonce 순서 보장 (원본 regression/ethereum/11-test-nonce-ordering, 절차는 docs/tc/common/06-detailed-procedures/02-tx.md 의 CT-TX-012). 문서의 기대 결과는 \"세 트랜잭션이 모두 포함되고 nonce 가 3이다. 해시 중복이나 누락이 없다\" 인데, 전에는 계정 nonce 가 3인지만 봤다. nonce 는 하나가 사라지고 다른 하나가 두 번 들어가도 3이 된다. 그래서 세 해시를 각각 붙잡아 두고, 해시마다 영수증이 성공인지와 그 해시의 트랜잭션이 어느 nonce 를 들고 있는지 확인한다. 같은 해시가 두 번 실렸다면 서로 다른 nonce 를 들 수 없고, 하나가 빠졌다면 그 해시로 트랜잭션을 찾을 수 없다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundHash",
      "to": "$acct",
      "value": "10000000000000000000"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "35000000000000",
      "maxPriorityFeePerGas": "30000000000000",
      "nonce": "2",
      "on": "node2",
      "to": "0x00000000000000000000000000000000C0FFEE10",
      "value": "1",
      "wait": false,
      "save": "h2"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "35000000000000",
      "maxPriorityFeePerGas": "30000000000000",
      "nonce": "1",
      "on": "node2",
      "to": "0x00000000000000000000000000000000C0FFEE10",
      "value": "1",
      "wait": false,
      "save": "h1"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "35000000000000",
      "maxPriorityFeePerGas": "30000000000000",
      "nonce": "0",
      "on": "node2",
      "to": "0x00000000000000000000000000000000C0FFEE10",
      "value": "1",
      "wait": false,
      "save": "h0"
    },
    {
      "address": "$acct",
      "compare": "Equal",
      "do": "waitFor",
      "expected": "3",
      "pollInterval": "2s",
      "source": "nonceAt",
      "timeout": "90s"
    },
    {
      "expect": "txStatus",
      "hash": "$fundHash",
      "is": "0x1"
    },
    {
      "address": "$acct",
      "compare": "Equal",
      "expect": "nonceAt",
      "is": "3"
    },
    {
      "expect": "txStatus",
      "hash": "$h0",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$h1",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$h2",
      "is": "0x1"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h0"
      ],
      "select": "nonce",
      "compare": "Equal",
      "is": "0x0"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h1"
      ],
      "select": "nonce",
      "compare": "Equal",
      "is": "0x1"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h2"
      ],
      "select": "nonce",
      "compare": "Equal",
      "is": "0x2"
    }
  ]
}
