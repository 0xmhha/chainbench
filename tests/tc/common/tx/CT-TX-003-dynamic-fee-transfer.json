{
  "schemaVersion": "2",
  "kind": "case",
  "id": "dynamic-fee-transfer",
  "description": "CT-TX-003 / TX-003 — 최신 baseFee+tip을 cap으로 제출하고 포함 블록의 baseFee와 실제 거래의 cap/tip을 읽는다. 선언 입력과 실제 서명 필드를 대조하며, cap>=mined baseFee와 effectiveGasPrice=baseFee+min(actual tipCap,actual feeCap-baseFee)를 검증한다. type2의 거래·영수증과 실제 송신·수신 잔액도 대조한다. 임의의 큰 cap이나 baseFee+tip으로 min 분기를 대신하지 않는다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "sender",
      "saveKey": "senderKey"
    },
    {
      "do": "newAccount",
      "save": "recipient",
      "saveKey": "recipientKey"
    },
    {
      "do": "sendTx",
      "from": "faucet",
      "on": "node1",
      "to": "$sender",
      "value": "10000000000000000000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "read",
      "source": "balanceAt",
      "address": "$sender",
      "save": "before"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_maxPriorityFeePerGas",
      "save": "tip"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "baseFeePerGas",
      "save": "base"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$base",
        "$tip"
      ],
      "save": "feeCap"
    },
    {
      "do": "sendTx",
      "key": "$senderKey",
      "on": "node1",
      "to": "$recipient",
      "value": "1000000000000000",
      "gas": "21000",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "expect": "receipt",
      "save": "h",
      "timeout": "120s"
    },
    {
      "expect": "txStatus",
      "hash": "$h",
      "is": "0x1"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h"
      ],
      "select": "type",
      "compare": "Equal",
      "is": "0x2"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h"
      ],
      "select": "blockNumber",
      "save": "bn"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getBlockByNumber",
      "params": [
        "$bn",
        false
      ],
      "select": "baseFeePerGas",
      "save": "blockBase"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h"
      ],
      "select": "maxFeePerGas",
      "save": "txCap"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h"
      ],
      "select": "maxPriorityFeePerGas",
      "save": "txTip"
    },
    {
      "expect": "derive",
      "op": "sum",
      "of": [
        "$txCap"
      ],
      "compare": "Equal",
      "is": "$feeCap"
    },
    {
      "expect": "derive",
      "op": "sum",
      "of": [
        "$txTip"
      ],
      "compare": "Equal",
      "is": "$tip"
    },
    {
      "expect": "derive",
      "op": "sum",
      "of": [
        "$txCap"
      ],
      "compare": "GreaterOrEqual",
      "is": "$blockBase"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "diff",
      "of": [
        "$txCap",
        "$blockBase"
      ],
      "save": "headroom"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "min",
      "of": [
        "$txTip",
        "$headroom"
      ],
      "save": "effectiveTip"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$blockBase",
        "$effectiveTip"
      ],
      "save": "wantPrice"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h"
      ],
      "select": "effectiveGasPrice",
      "compare": "Equal",
      "is": "$wantPrice"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h"
      ],
      "select": "gasUsed",
      "save": "used"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h"
      ],
      "select": "effectiveGasPrice",
      "save": "price"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "mul",
      "of": [
        "$used",
        "$price"
      ],
      "save": "fee"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "diff",
      "of": [
        "$before",
        "1000000000000000",
        "$fee"
      ],
      "save": "want"
    },
    {
      "expect": "balanceAt",
      "address": "$sender",
      "compare": "Equal",
      "is": "$want"
    },
    {
      "expect": "balanceAt",
      "address": "$recipient",
      "compare": "Equal",
      "is": "1000000000000000"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h"
      ],
      "select": "type",
      "compare": "Equal",
      "is": "0x2"
    }
  ]
}
