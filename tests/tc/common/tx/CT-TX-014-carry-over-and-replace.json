{
  "schemaVersion": "2",
  "kind": "case",
  "id": "carry-over-and-replace",
  "description": "CT-TX-014 — 블록에 들어가지 못한 트랜잭션이 풀에 남아 nonce 순서대로 다음 블록들에 들어가고, 교체하면 새 것만 들어간다 (기존 명세 N-008 의 관측 부분, 절차는 docs/tc/common/06-detailed-procedures/02-tx.md 의 CT-TX-014). N-008 은 블록 크기 한도로 넘치게 했는데 그 한도는 go-wemix 의 한 브랜치에만 있다. 여기서는 세 체인에 다 있는 가스 한도로 넘치게 한다. 남은 가스가 10000 이하가 될 때까지 도는 10바이트 컨트랙트(PUSH0 없음)를 부르고, 각 트랜잭션의 gas 를 최신 블록 gasLimit 에서 1000000 을 뺀 값으로 잡는다. 실제로 가스를 거의 다 쓰므로 한 블록에 한 건만 들어가고 나머지는 이월된다. 가스를 잡기만 하고 쓰지 않으면 남은 가스가 블록에 돌아와 이월이 생기지 않는다. nonce 0~5 를 기다리지 않고 보낸 뒤 풀의 pending 이 2 건 이상인지 보고, 마지막 nonce 를 팁과 최대 수수료를 두 배로 올려 교체한다. 여섯 건이 모두 성공하고 포함 블록 번호가 nonce 순서대로 늘며, 교체 전 해시는 사라진다. genesis gasLimit 은 덮어쓰지 않고 체인의 기본값을 쓴다(WEMIX3.0 은 메인넷과 같은 105000000, WEMIX4.0 105000000, StableNet 20000000). gas 를 최신 블록 한도에서 구하므로 한도가 얼마든 이월은 같은 식으로 생긴다. 전에는 비용을 줄이려 한도를 낮췄는데, 낮춘 한도에서는 go-wemix 가 체인을 올릴 때 거버넌스 컨트랙트를 배포하지 못했다 — 3000000 은 전부터, 10000000 은 2026-09-30 go-wemix 0.10.15(1ceaa1e6) 에서 배포 트랜잭션이 블록 한도를 거의 채운 뒤(9,977,868 gas) 남은 것이 들어가지 못해 시간 초과로 끝났다. 운영망에 없는 한도로 체인을 세우면 이런 식으로 시험 대상이 아닌 곳이 깨진다. 이 값을 따르지 않는 체인이 있어도 gas 를 최신 블록 한도에서 구하므로 이월은 같은 식으로 생긴다. 트랜잭션 하나의 최대 수수료가 geth 계열 RPC 의 기본 상한(1 ether)을 넘을 수 있어, tx/019 처럼 rpc.txfeecap 을 0(상한 없음)으로 띄운다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ],
    "launch": {
      "all": {
        "rpc.txfeecap": "0"
      }
    }
  },
  "steps": [
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "200000",
      "data": "0x600a600c600039600a6000f35b6127105a1160005700",
      "save": "dhash",
      "expect": "receipt"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$dhash"
      ],
      "select": "contractAddress",
      "save": "burner"
    },
    {
      "expect": "txStatus",
      "hash": "$dhash",
      "is": "0x1"
    },
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "sendTx",
      "from": "faucet",
      "on": "node1",
      "to": "$acct",
      "value": "10000000000000000000000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "gasLimit",
      "save": "limit"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "diff",
      "of": [
        "$limit",
        "1000000"
      ],
      "save": "g"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_maxPriorityFeePerGas",
      "save": "tip"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "baseFeePerGas",
      "save": "base"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$base",
        "$base",
        "$tip"
      ],
      "save": "feeCap"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "on": "node1",
      "to": "$burner",
      "value": "0",
      "gas": "$g",
      "nonce": "0",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "wait": false,
      "save": "h0"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "on": "node1",
      "to": "$burner",
      "value": "0",
      "gas": "$g",
      "nonce": "1",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "wait": false,
      "save": "h1"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "on": "node1",
      "to": "$burner",
      "value": "0",
      "gas": "$g",
      "nonce": "2",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "wait": false,
      "save": "h2"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "on": "node1",
      "to": "$burner",
      "value": "0",
      "gas": "$g",
      "nonce": "3",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "wait": false,
      "save": "h3"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "on": "node1",
      "to": "$burner",
      "value": "0",
      "gas": "$g",
      "nonce": "4",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "wait": false,
      "save": "h4"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "on": "node1",
      "to": "$burner",
      "value": "0",
      "gas": "$g",
      "nonce": "5",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "wait": false,
      "save": "h5"
    },
    {
      "expect": "rpcCall",
      "on": "node1",
      "method": "txpool_contentFrom",
      "params": [
        "$acct"
      ],
      "select": "pending.#",
      "compare": "GreaterOrEqual",
      "is": "2"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "mul",
      "of": [
        "$tip",
        "2"
      ],
      "save": "tip2"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "mul",
      "of": [
        "$feeCap",
        "2"
      ],
      "save": "feeCap2"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "on": "node1",
      "to": "$burner",
      "value": "0",
      "gas": "$g",
      "nonce": "5",
      "maxFeePerGas": "$feeCap2",
      "maxPriorityFeePerGas": "$tip2",
      "wait": false,
      "save": "h5r"
    },
    {
      "do": "waitFor",
      "on": "node1",
      "source": "nonceAt",
      "address": "$acct",
      "compare": "Equal",
      "expected": "6",
      "timeout": "120s",
      "pollInterval": "1s"
    },
    {
      "expect": "txStatus",
      "hash": "$h0",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$h1",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$h2",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$h3",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$h4",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$h5r",
      "is": "0x1"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h5"
      ],
      "compare": "Nil",
      "is": null
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h0"
      ],
      "select": "blockNumber",
      "save": "b0"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h1"
      ],
      "select": "blockNumber",
      "save": "b1"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h2"
      ],
      "select": "blockNumber",
      "save": "b2"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h3"
      ],
      "select": "blockNumber",
      "save": "b3"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h4"
      ],
      "select": "blockNumber",
      "save": "b4"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h5r"
      ],
      "select": "blockNumber",
      "save": "b5"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$b1",
        "$b0"
      ],
      "compare": "GreaterOrEqual",
      "is": "1"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$b2",
        "$b1"
      ],
      "compare": "GreaterOrEqual",
      "is": "1"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$b3",
        "$b2"
      ],
      "compare": "GreaterOrEqual",
      "is": "1"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$b4",
        "$b3"
      ],
      "compare": "GreaterOrEqual",
      "is": "1"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$b5",
        "$b4"
      ],
      "compare": "GreaterOrEqual",
      "is": "1"
    }
  ]
}
