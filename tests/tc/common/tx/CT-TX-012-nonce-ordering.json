{
  "schemaVersion": "2",
  "kind": "case",
  "id": "nonce-ordering",
  "description": "TX-010 / RT-A-2-04 — 새 계정의 nonce 2·1을 먼저 보내 실제 queued 해시를 확인하고 0으로 격차를 채운다. 세 거래의 성공·실제 nonce와 영수증 blockNumber 비감소를 대조한다. transactionIndex < 2^64를 확인한 뒤 blockNumber*2^64+transactionIndex의 엄격 증가로 같은 블록의 실제 순서를 검증한다. 평균·계정 nonce만으로 순서를 대신하지 않는다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundHash",
      "to": "$acct",
      "value": "10000000000000000000"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_maxPriorityFeePerGas",
      "save": "tip"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "baseFeePerGas",
      "save": "base"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$base",
        "$base",
        "$tip"
      ],
      "save": "feeCap"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "nonce": "2",
      "on": "node2",
      "to": "0x00000000000000000000000000000000C0FFEE10",
      "value": "1",
      "wait": false,
      "save": "h2"
    },
    {
      "expect": "rpcCall",
      "on": "node2",
      "method": "txpool_contentFrom",
      "params": [
        "$acct"
      ],
      "select": "queued.2.hash",
      "compare": "EqualCI",
      "is": "$h2"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "nonce": "1",
      "on": "node2",
      "to": "0x00000000000000000000000000000000C0FFEE10",
      "value": "1",
      "wait": false,
      "save": "h1"
    },
    {
      "expect": "rpcCall",
      "on": "node2",
      "method": "txpool_contentFrom",
      "params": [
        "$acct"
      ],
      "select": "queued.1.hash",
      "compare": "EqualCI",
      "is": "$h1"
    },
    {
      "do": "sendTx",
      "key": "$acctKey",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "nonce": "0",
      "on": "node2",
      "to": "0x00000000000000000000000000000000C0FFEE10",
      "value": "1",
      "wait": false,
      "save": "h0"
    },
    {
      "address": "$acct",
      "compare": "Equal",
      "do": "waitFor",
      "expected": "3",
      "pollInterval": "2s",
      "source": "nonceAt",
      "timeout": "90s"
    },
    {
      "expect": "txStatus",
      "hash": "$fundHash",
      "is": "0x1"
    },
    {
      "address": "$acct",
      "compare": "Equal",
      "expect": "nonceAt",
      "is": "3"
    },
    {
      "expect": "txStatus",
      "hash": "$h0",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$h1",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$h2",
      "is": "0x1"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h0"
      ],
      "select": "nonce",
      "compare": "Equal",
      "is": "0x0"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h1"
      ],
      "select": "nonce",
      "compare": "Equal",
      "is": "0x1"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h2"
      ],
      "select": "nonce",
      "compare": "Equal",
      "is": "0x2"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h0"
      ],
      "select": "blockNumber",
      "save": "block0"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h0"
      ],
      "select": "transactionIndex",
      "save": "index0"
    },
    {
      "expect": "derive",
      "op": "sum",
      "of": [
        "$index0"
      ],
      "compare": "Less",
      "is": "18446744073709551616"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "mul",
      "of": [
        "$block0",
        "18446744073709551616"
      ],
      "save": "blockPosition0"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$blockPosition0",
        "$index0"
      ],
      "save": "position0"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h1"
      ],
      "select": "blockNumber",
      "save": "block1"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h1"
      ],
      "select": "transactionIndex",
      "save": "index1"
    },
    {
      "expect": "derive",
      "op": "sum",
      "of": [
        "$index1"
      ],
      "compare": "Less",
      "is": "18446744073709551616"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "mul",
      "of": [
        "$block1",
        "18446744073709551616"
      ],
      "save": "blockPosition1"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$blockPosition1",
        "$index1"
      ],
      "save": "position1"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h2"
      ],
      "select": "blockNumber",
      "save": "block2"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h2"
      ],
      "select": "transactionIndex",
      "save": "index2"
    },
    {
      "expect": "derive",
      "op": "sum",
      "of": [
        "$index2"
      ],
      "compare": "Less",
      "is": "18446744073709551616"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "mul",
      "of": [
        "$block2",
        "18446744073709551616"
      ],
      "save": "blockPosition2"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$blockPosition2",
        "$index2"
      ],
      "save": "position2"
    },
    {
      "expect": "derive",
      "op": "sum",
      "of": [
        "$block0"
      ],
      "compare": "LessOrEqual",
      "is": "$block1"
    },
    {
      "expect": "derive",
      "op": "sum",
      "of": [
        "$position0"
      ],
      "compare": "Less",
      "is": "$position1"
    },
    {
      "expect": "derive",
      "op": "sum",
      "of": [
        "$block1"
      ],
      "compare": "LessOrEqual",
      "is": "$block2"
    },
    {
      "expect": "derive",
      "op": "sum",
      "of": [
        "$position1"
      ],
      "compare": "Less",
      "is": "$position2"
    }
  ]
}
