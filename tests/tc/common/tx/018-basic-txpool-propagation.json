{
  "schemaVersion": "2",
  "kind": "case",
  "id": "basic-txpool-propagation",
  "description": "Verify TX propagation across nodes and txpool drain under load (원본 basic/txpool-propagation.sh)",
  "requires": [
    "rpc"
  ],
  "chainPreset": "stablenet-bp4-en1",
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "120s"
    },
    {
      "do": "newAccount",
      "save": "r",
      "saveKey": "rk"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "from": "node1",
      "to": "$r",
      "value": "1",
      "expect": "receipt"
    },
    {
      "expect": "balanceAt",
      "on": "node2",
      "address": "$r",
      "compare": "Greater",
      "is": "0"
    }
  ]
}
