{
  "schemaVersion": "2",
  "kind": "case",
  "id": "access-list-tx",
  "description": "RT-A-2-03: eth_createAccessList 로 노드가 만든 접근 목록을 붙여 type 0x01 트랜잭션을 보낸다.",
  "requires": [
    "rpc",
    "family:wbft"
  ],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "save": "base",
      "source": "baseFee"
    },
    {
      "do": "read",
      "of": [
        "$base",
        "$base"
      ],
      "op": "sum",
      "save": "gp",
      "source": "derive"
    },
    {
      "do": "read",
      "method": "eth_createAccessList",
      "params": [
        {
          "from": "node1",
          "to": "0x00000000000000000000000000000000C0FFEE0D",
          "value": "0x1"
        },
        "latest"
      ],
      "save": "createdList",
      "select": "accessList",
      "source": "rpcCall"
    },
    {
      "accessList": "$createdList",
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "gasPrice": "$gp",
      "save": "hash",
      "to": "0x00000000000000000000000000000000C0FFEE0D",
      "value": "1"
    },
    {
      "expect": "txStatus",
      "hash": "$hash",
      "is": "0x1"
    },
    {
      "compare": "Equal",
      "expect": "rpcCall",
      "is": "0x1",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "type"
    }
  ]
}
