{
  "schemaVersion": "2",
  "kind": "case",
  "id": "logs-query-well-formed",
  "description": "RT-A-4-04 — eth_getLogs 의 필터가 실제로 걸러 내는지 본다 (원본 regression/ethereum/29-test-eth-get-logs). 전에는 latest 한 블록에서 로그 개수가 0 이상인지만 보았다. 개수는 음수가 될 수 없어 노드가 무엇을 답해도 통과했고, 로그가 하나도 없어도 초록불이었다. 이웃 케이스 contract-event-emitted 가 토픽 값이 맞는지를 보므로, 이 케이스는 필터 자체를 본다. 같은 블록을 두 번 묻되 한 번은 그 이벤트의 토픽으로, 한 번은 없는 토픽으로 묻는다. 맞는 쪽은 하나가 나오고 틀린 쪽은 하나도 안 나와야 필터가 일하는 것이다. 배포하는 바이트코드는 이웃 케이스와 같은 것으로, 토픽 하나짜리 로그를 내고 끝난다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "data": "0x6027600c60003960276000f37f111111111111111111111111111111111111111111111111111111111111111160006000a100",
      "do": "sendTx",
      "from": "node1",
      "gas": "200000",
      "save": "dhash"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$dhash"
      ],
      "save": "addr",
      "select": "contractAddress",
      "source": "rpcCall"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "100000",
      "save": "ehash",
      "to": "$addr"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$ehash"
      ],
      "save": "blk",
      "select": "blockNumber",
      "source": "rpcCall"
    },
    {
      "expect": "txStatus",
      "hash": "$ehash",
      "is": "0x1"
    },
    {
      "address": "$addr",
      "compare": "Equal",
      "expect": "logs",
      "fromBlock": "$blk",
      "is": 1,
      "select": "count",
      "toBlock": "$blk",
      "topics": [
        "0x1111111111111111111111111111111111111111111111111111111111111111"
      ]
    },
    {
      "address": "$addr",
      "compare": "Equal",
      "expect": "logs",
      "fromBlock": "$blk",
      "is": 0,
      "select": "count",
      "toBlock": "$blk",
      "topics": [
        "0x2222222222222222222222222222222222222222222222222222222222222222"
      ]
    }
  ]
}
