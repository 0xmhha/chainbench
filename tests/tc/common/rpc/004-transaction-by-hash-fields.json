{
  "schemaVersion": "2",
  "kind": "case",
  "id": "transaction-by-hash-fields",
  "description": "RT-G-1-03 — eth_getTransactionByHash (원본 regression/api/03-test-get-tx-by-hash) 시험 대상 트랜잭션은 노드가 아니라 별도 계정이 서명해 eth_sendRawTransaction 으로 보낸다. from 에 노드 이름을 적으면 eth_sendTransaction 이 되어 노드가 자기 계정으로 서명하는데, 그것은 실제 사용자가 보내는 모양이 아니다. 계정을 새로 만들어 faucet 에서 자금을 받은 뒤 그 열쇠로 서명한다. 자금을 넣는 첫 전송만 노드 서명인데, 제네시스가 자금을 준 계정의 열쇠는 노드가 들고 있어 달리 할 수가 없다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "sender",
      "saveKey": "senderKey"
    },
    {
      "do": "sendTx",
      "from": "faucet",
      "to": "$sender",
      "value": "3000000000000000000",
      "gas": "21000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "sendTx",
      "save": "hash",
      "to": "0x00000000000000000000000000000000C0FFEE05",
      "value": "1",
      "key": "$senderKey",
      "timeout": "120s"
    },
    {
      "compare": "EqualCI",
      "expect": "rpcCall",
      "is": "$sender",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "from"
    },
    {
      "compare": "EqualCI",
      "expect": "rpcCall",
      "is": "0x00000000000000000000000000000000C0FFEE05",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "to"
    },
    {
      "compare": "NotNil",
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "blockNumber"
    },
    {
      "compare": "NotNil",
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "value"
    }
  ]
}
