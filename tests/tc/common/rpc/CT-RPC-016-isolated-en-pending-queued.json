{
  "schemaVersion": "2",
  "kind": "case",
  "id": "isolated-en-pending-queued",
  "description": "RPC-018 — 실제 EN(node5)을 BP4에서 peer 격리하고 정상 합의는 계속 유지한다. 새 sender의 nonce0 pending과 nonce2 queued를 EN에서 제출해 정확한 hash·nonce·from·gas 및 account bucket을 검사한다. peer0·EN block halt·각 receipt null을 확인하므로 재연결되거나 이미 채굴되면 실패한다. 연결을 복구한 뒤 nonce0 성공을 확인하고 nonce1을 채워 nonce2 성공·풀 비움을 검증한다. 격리 전 EN이 제안한 gasPrice·tip을 읽고 cap은 추천 가격의 두 배로 구성한다. 로컬 입장에서만 허용되는 오래된 고정 35조 wei cap으로 원격 재검증·전파가 막히지 않도록 한다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "wbft-bp4-en1",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "spender",
      "saveKey": "spenderKey"
    },
    {
      "do": "sendTx",
      "from": "faucet",
      "on": "node1",
      "to": "$spender",
      "value": "10000000000000000000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "waitFor",
      "source": "balanceAt",
      "on": "node5",
      "address": "$spender",
      "compare": "Equal",
      "expected": "10000000000000000000",
      "timeout": "60s",
      "pollInterval": "1s"
    },
    {
      "on": "node1",
      "method": "admin_nodeInfo",
      "expect": "rpcCall",
      "select": "enode",
      "compare": "Regexp",
      "is": "^enode://"
    },
    {
      "on": "node2",
      "method": "admin_nodeInfo",
      "expect": "rpcCall",
      "select": "enode",
      "compare": "Regexp",
      "is": "^enode://"
    },
    {
      "on": "node3",
      "method": "admin_nodeInfo",
      "expect": "rpcCall",
      "select": "enode",
      "compare": "Regexp",
      "is": "^enode://"
    },
    {
      "on": "node4",
      "method": "admin_nodeInfo",
      "expect": "rpcCall",
      "select": "enode",
      "compare": "Regexp",
      "is": "^enode://"
    },
    {
      "on": "node5",
      "method": "admin_nodeInfo",
      "expect": "rpcCall",
      "select": "enode",
      "compare": "Regexp",
      "is": "^enode://"
    },
    {
      "do": "read",
      "source": "gasPrice",
      "on": "node5",
      "save": "poolGasPrice"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node5",
      "method": "eth_maxPriorityFeePerGas",
      "save": "poolTip"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$poolGasPrice",
        "$poolGasPrice"
      ],
      "save": "poolFeeCap"
    },
    {
      "do": "partition",
      "method": "peers",
      "groups": [
        [
          "node1",
          "node2",
          "node3",
          "node4"
        ],
        [
          "node5"
        ]
      ]
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "admin_peers",
      "select": "#",
      "compare": "Equal",
      "is": "0"
    },
    {
      "do": "waitFor",
      "source": "peerCount",
      "on": "node5",
      "compare": "Equal",
      "expected": "0",
      "timeout": "30s",
      "pollInterval": "1s"
    },
    {
      "expect": "blockHalt",
      "on": "node5",
      "within": "5s",
      "maxAdvance": 0
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "10s"
    },
    {
      "do": "sendTx",
      "key": "$spenderKey",
      "on": "node5",
      "to": "0x00000000000000000000000000000000C0FFEE11",
      "value": "1",
      "gas": "21000",
      "nonce": "0",
      "maxFeePerGas": "$poolFeeCap",
      "maxPriorityFeePerGas": "$poolTip",
      "wait": false,
      "save": "h0"
    },
    {
      "do": "sendTx",
      "key": "$spenderKey",
      "on": "node5",
      "to": "0x00000000000000000000000000000000C0FFEE11",
      "value": "1",
      "gas": "21000",
      "nonce": "2",
      "maxFeePerGas": "$poolFeeCap",
      "maxPriorityFeePerGas": "$poolTip",
      "wait": false,
      "save": "h2"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_status",
      "select": "pending",
      "compare": "GreaterOrEqual",
      "is": "1"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_content",
      "select": "pending.#",
      "compare": "GreaterOrEqual",
      "is": "1"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_contentFrom",
      "params": [
        "$spender"
      ],
      "select": "pending.#",
      "compare": "Equal",
      "is": "1"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_contentFrom",
      "params": [
        "$spender"
      ],
      "select": "pending.0.nonce",
      "compare": "Equal",
      "is": "0x0"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_contentFrom",
      "params": [
        "$spender"
      ],
      "select": "pending.0.hash",
      "compare": "EqualCI",
      "is": "$h0"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_contentFrom",
      "params": [
        "$spender"
      ],
      "select": "pending.0.from",
      "compare": "EqualCI",
      "is": "$spender"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_contentFrom",
      "params": [
        "$spender"
      ],
      "select": "pending.0.gas",
      "compare": "Equal",
      "is": "0x5208"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h0"
      ],
      "compare": "Nil",
      "is": null
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_status",
      "select": "queued",
      "compare": "GreaterOrEqual",
      "is": "1"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_content",
      "select": "queued.#",
      "compare": "GreaterOrEqual",
      "is": "1"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_contentFrom",
      "params": [
        "$spender"
      ],
      "select": "queued.#",
      "compare": "Equal",
      "is": "1"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_contentFrom",
      "params": [
        "$spender"
      ],
      "select": "queued.2.nonce",
      "compare": "Equal",
      "is": "0x2"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_contentFrom",
      "params": [
        "$spender"
      ],
      "select": "queued.2.hash",
      "compare": "EqualCI",
      "is": "$h2"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_contentFrom",
      "params": [
        "$spender"
      ],
      "select": "queued.2.from",
      "compare": "EqualCI",
      "is": "$spender"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_contentFrom",
      "params": [
        "$spender"
      ],
      "select": "queued.2.gas",
      "compare": "Equal",
      "is": "0x5208"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h2"
      ],
      "compare": "Nil",
      "is": null
    },
    {
      "expect": "peerCount",
      "on": "node5",
      "compare": "Equal",
      "is": "0"
    },
    {
      "do": "healPartition",
      "method": "peers"
    },
    {
      "do": "waitFor",
      "source": "peerCount",
      "on": "node5",
      "compare": "GreaterOrEqual",
      "expected": "1",
      "timeout": "30s",
      "pollInterval": "1s"
    },
    {
      "do": "waitFor",
      "source": "txStatus",
      "on": "node5",
      "hash": "$h0",
      "compare": "Equal",
      "expected": "0x1",
      "timeout": "120s",
      "pollInterval": "1s"
    },
    {
      "do": "sendTx",
      "key": "$spenderKey",
      "on": "node5",
      "to": "0x00000000000000000000000000000000C0FFEE11",
      "value": "1",
      "gas": "21000",
      "nonce": "1",
      "maxFeePerGas": "$poolFeeCap",
      "maxPriorityFeePerGas": "$poolTip",
      "expect": "receipt",
      "save": "h1",
      "timeout": "120s"
    },
    {
      "do": "waitFor",
      "source": "txStatus",
      "on": "node5",
      "hash": "$h2",
      "compare": "Equal",
      "expected": "0x1",
      "timeout": "120s",
      "pollInterval": "1s"
    },
    {
      "expect": "nonceAt",
      "on": "node5",
      "address": "$spender",
      "compare": "Equal",
      "is": "3"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_contentFrom",
      "params": [
        "$spender"
      ],
      "select": "pending.#",
      "compare": "Equal",
      "is": "0"
    },
    {
      "expect": "rpcCall",
      "on": "node5",
      "method": "txpool_contentFrom",
      "params": [
        "$spender"
      ],
      "select": "queued.#",
      "compare": "Equal",
      "is": "0"
    }
  ]
}
