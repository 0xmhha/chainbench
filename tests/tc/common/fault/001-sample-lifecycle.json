{
  "schemaVersion": "2",
  "kind": "case",
  "id": "sample-lifecycle-node-restart",
  "description": "작성 샘플 — 노드를 멈췄다 살리고 체인이 이어지는지 확인한다 (docs/guide/dsl-authoring.md) 멈추는 노드는 블록 생성 노드(node3)다. CT-FAULT-001 은 생성 노드 하나가 빠져도 합의가 이어지는지를 보며, 종단 노드를 멈추면 합의에는 아무 일도 일어나지 않는다. 다시 띄운 뒤에는 node1 의 그 시점 높이까지 node3 이 따라잡기를 기다렸다가 해시를 견준다. 고정 높이(8)는 체인이 이미 지나간 뒤라 아무것도 기다리지 않았다.",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4-en1-binvar",
    "genesis": {
      "overlay": {
        "config": {
          "bohoBlock": 6
        }
      }
    },
    "accounts": {
      "dev1": {
        "fund": "0x8AC7230489E80000"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "from": "dev1",
      "to": "$acct",
      "value": "1000000000000000000",
      "gas": "21000",
      "expect": "receipt"
    },
    {
      "expect": "balanceAt",
      "on": "node1",
      "address": "$acct",
      "compare": "Greater",
      "is": "0"
    },
    {
      "do": "stopNode",
      "on": "node3"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "60s",
      "pollInterval": "2s"
    },
    {
      "do": "startNode",
      "on": "node3"
    },
    {
      "do": "read",
      "source": "blockNumber",
      "on": "node1",
      "save": "caught"
    },
    {
      "do": "waitFor",
      "source": "blockNumber",
      "on": "node3",
      "compare": "GreaterOrEqual",
      "expected": "$caught",
      "timeout": "180s",
      "pollInterval": "2s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "readNodeLog",
      "on": "node3",
      "maxBytes": 4096,
      "save": "node3Log"
    }
  ]
}
