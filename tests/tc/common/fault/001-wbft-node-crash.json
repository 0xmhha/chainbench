{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wbft-node-crash",
  "description": "Stop one wbft validator and verify consensus continues 3/4, then restart it (WA25 — wbft had no fault coverage). After the restart the node must catch up (CT-FAULT-001): node1's head right after the restart includes the blocks made while node3 was down, so node3 reaching that height means it synced them; then every node must agree on the latest hash, and node3's state root at that height must equal node1's — the root node3 computed by executing the blocks, not a header it was handed.",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "skipsOn": [],
  "chainPreset": "wbft-bp4",
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "180s"
    },
    {
      "do": "stopNode",
      "on": "node3"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "do": "restartNode",
      "on": "node3"
    },
    {
      "do": "read",
      "source": "blockNumber",
      "on": "node1",
      "save": "caught"
    },
    {
      "do": "waitFor",
      "source": "blockNumber",
      "on": "node3",
      "compare": "GreaterOrEqual",
      "expected": "$caught",
      "timeout": "180s",
      "pollInterval": "2s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$caught",
        "0"
      ],
      "format": "hex",
      "save": "caughtHex"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getBlockByNumber",
      "params": [
        "$caughtHex",
        false
      ],
      "select": "stateRoot",
      "save": "root"
    },
    {
      "expect": "rpcCall",
      "on": "node3",
      "method": "eth_getBlockByNumber",
      "params": [
        "$caughtHex",
        false
      ],
      "select": "stateRoot",
      "compare": "Equal",
      "is": "$root"
    }
  ]
}
