{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wbft-node-crash",
  "description": "Stop one wbft validator and verify consensus continues 3/4, then restart it (WA25 — wbft had no fault coverage).",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "chainPreset": "wbft-bp4",
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "180s"
    },
    {
      "do": "stopNode",
      "on": "node3"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "do": "restartNode",
      "on": "node3"
    }
  ]
}
