{
  "schemaVersion": "2",
  "kind": "case",
  "id": "fault-node-crash",
  "description": "검증자 node3를 중단한 뒤 중단 전 높이에서 새 블록 10개가 생성되는지 확인한다. 복구 후 네 노드의 현재 높이 차이가 2블록 이내인지 검사하고, 공통 높이의 블록 해시·상태 루트와 복구 노드 로그를 확인한다. 원문 fault/node-crash.sh.",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "skipsOn": [],
  "chainPreset": "stablenet-bp4",
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "300s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "read",
      "source": "blockNumber",
      "on": "node1",
      "save": "crashStartHeight"
    },
    {
      "do": "stopNode",
      "on": "node3"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$crashStartHeight",
        "10"
      ],
      "save": "crashProgressTarget"
    },
    {
      "do": "waitBlock",
      "on": "node1",
      "target": "$crashProgressTarget",
      "timeout": "60s"
    },
    {
      "do": "read",
      "source": "blockNumber",
      "on": "node1",
      "save": "crashStoppedProgressHead"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$crashStoppedProgressHead",
        "$crashStartHeight"
      ],
      "compare": "GreaterOrEqual",
      "is": "10"
    },
    {
      "do": "restartNode",
      "on": "node3"
    },
    {
      "do": "read",
      "source": "blockNumber",
      "on": "node1",
      "save": "caught"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "diff",
      "of": [
        "$caught",
        "2"
      ],
      "save": "caughtMinimum"
    },
    {
      "expect": "blockLag",
      "maxLag": "2",
      "timeout": "90s",
      "pollInterval": "2s",
      "onEach": [
        "node1",
        "node2",
        "node3",
        "node4"
      ]
    },
    {
      "do": "read",
      "source": "blockNumber",
      "on": "node1",
      "save": "crashRecoveredHead1"
    },
    {
      "do": "read",
      "source": "blockNumber",
      "on": "node2",
      "save": "crashRecoveredHead2"
    },
    {
      "do": "read",
      "source": "blockNumber",
      "on": "node3",
      "save": "crashRecoveredHead3"
    },
    {
      "do": "read",
      "source": "blockNumber",
      "on": "node4",
      "save": "crashRecoveredHead4"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "min",
      "of": [
        "$crashRecoveredHead1",
        "$crashRecoveredHead2",
        "$crashRecoveredHead3",
        "$crashRecoveredHead4"
      ],
      "save": "crashRecoveredMinimum"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$crashRecoveredHead1",
        "$crashRecoveredMinimum"
      ],
      "compare": "LessOrEqual",
      "is": "2"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$crashRecoveredHead2",
        "$crashRecoveredMinimum"
      ],
      "compare": "LessOrEqual",
      "is": "2"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$crashRecoveredHead3",
        "$crashRecoveredMinimum"
      ],
      "compare": "LessOrEqual",
      "is": "2"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$crashRecoveredHead4",
        "$crashRecoveredMinimum"
      ],
      "compare": "LessOrEqual",
      "is": "2"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$crashRecoveredMinimum",
        "0"
      ],
      "format": "hex",
      "save": "caughtHex"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getBlockByNumber",
      "params": [
        "$caughtHex",
        false
      ],
      "select": "stateRoot",
      "save": "root"
    },
    {
      "expect": "rpcCall",
      "on": "node3",
      "method": "eth_getBlockByNumber",
      "params": [
        "$caughtHex",
        false
      ],
      "select": "stateRoot",
      "compare": "Equal",
      "is": "$root"
    },
    {
      "do": "readNodeLog",
      "on": "node3",
      "maxBytes": 4096,
      "save": "node3Log"
    }
  ]
}
