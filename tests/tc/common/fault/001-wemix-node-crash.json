{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wemix-node-crash",
  "description": "Stop one wemix (poa) producer and verify block production continues, then restart it (WA25 — wemix had no fault coverage).",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "chainPreset": "wemix-bp4",
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "300s"
    },
    {
      "do": "stopNode",
      "on": "node3"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "180s",
      "pollInterval": "3s"
    },
    {
      "do": "restartNode",
      "on": "node3"
    }
  ]
}
