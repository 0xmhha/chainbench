{
  "schemaVersion": "2",
  "kind": "case",
  "id": "dynamic-feecap-above-min-accepted",
  "description": "CT-FEE-002 — 동적 수수료(0x2) 트랜잭션을 기본 수수료의 두 배에 팁을 더한 최대 수수료로 보내면 받아들여진다 (기존 명세 TC-1-3-01~06, TS-1-3-01·02, 절차는 docs/tc/common/06-detailed-procedures/03-fee.md 의 CT-FEE-002). 경계값 가운데 '초과는 받아들여진다' 부분이다. '같음' 은 공통이 아니라 뺐다. 경계를 go-stablenet 은 고정 상수(MinBaseFee)로, go-wemix 는 다음 블록 기본 수수료에 거버넌스 팁을 더한 값으로 정하고, go-wbft 는 RPC 로 받은 트랜잭션을 제출 때 가격으로 거부하지 않아 세 체인에 같은 경계값이 없다. 초과로 보내는 값은 노드가 제안한 가격이라 세 체인 모두 하한 위에 있다. 새 계정이 자기 키로 서명해 보내고, 성공 상태와 형식을 본다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "sender",
      "saveKey": "senderKey"
    },
    {
      "do": "sendTx",
      "from": "faucet",
      "on": "node1",
      "to": "$sender",
      "value": "10000000000000000000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_maxPriorityFeePerGas",
      "save": "tip"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "baseFeePerGas",
      "save": "base"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$base",
        "$base",
        "$tip"
      ],
      "save": "feeCap"
    },
    {
      "do": "sendTx",
      "key": "$senderKey",
      "on": "node1",
      "to": "0x00000000000000000000000000000000C0FFEE21",
      "value": "1",
      "gas": "21000",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "expect": "receipt",
      "save": "h",
      "timeout": "120s"
    },
    {
      "expect": "txStatus",
      "hash": "$h",
      "is": "0x1"
    },
    {
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$h"
      ],
      "select": "type",
      "compare": "Equal",
      "is": "0x2"
    }
  ]
}
