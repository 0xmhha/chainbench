{
  "schemaVersion": "2",
  "kind": "case",
  "id": "fee-history-well-formed",
  "description": "CT-FEE-012 / RPC-017 — 10개 블록과 [25,75] percentile의 fee history를 조회한다. baseFee 11개 모두 양수, gasUsedRatio 10개 모두 0..1, reward 10행 각 2개를 검증한다. 노드의 동적 head를 각 RPC에서 조회하므로 고정 블록별 재계산과 동일 snapshot의 원자성은 native 독립 대조에서 별도 확인한다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 10,
      "timeout": "120s"
    },
    {
      "expect": "rpcCall",
      "method": "eth_feeHistory",
      "params": [
        "0xa",
        "latest",
        [
          25,
          75
        ]
      ],
      "select": "oldestBlock",
      "compare": "Regexp",
      "is": "^0x[0-9a-fA-F]+$"
    },
    {
      "expect": "rpcCall",
      "method": "eth_feeHistory",
      "params": [
        "0xa",
        "latest",
        [
          25,
          75
        ]
      ],
      "select": "baseFeePerGas.#",
      "compare": "Equal",
      "is": "11"
    },
    {
      "expect": "rpcCall",
      "method": "eth_feeHistory",
      "params": [
        "0xa",
        "latest",
        [
          25,
          75
        ]
      ],
