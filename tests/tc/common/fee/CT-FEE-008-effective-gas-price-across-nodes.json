{
  "schemaVersion": "2",
  "kind": "case",
  "id": "effective-gas-price-regular-bp-en",
  "description": "TC-4-6-02 — 일반 계정 tx 의 effectiveGasPrice 가 두 노드에서 같다 시험 대상 트랜잭션은 노드가 아니라 별도 계정이 서명해 eth_sendRawTransaction 으로 보낸다. from 에 노드 이름을 적으면 eth_sendTransaction 이 되어 노드가 자기 계정으로 서명하는데, 그것은 실제 사용자가 보내는 모양이 아니다. 계정을 새로 만들어 faucet 에서 자금을 받은 뒤 그 열쇠로 서명한다. 자금을 넣는 첫 전송만 노드 서명인데, 제네시스가 자금을 준 계정의 열쇠는 노드가 들고 있어 달리 할 수가 없다. 이 케이스의 이름이 말하는 \"일반 계정\" 도 노드 계정이 아니라 바로 이 계정이다. 종단 노드는 snap 으로 동기화한다. 전에는 stablenet 전용 preset(stablenet-bp4-en1-snap)을 이름으로 불러 --chain-preset 으로 체인을 바꿀 수 없었다. 지금은 세 체인이 모두 가진 bp4-en1 을 확장하고 syncMode 를 적어, 체인을 바꿔도 이 설정이 남는다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4-en1",
    "topology": {
      "syncMode": "snap"
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "120s"
    },
    {
      "do": "newAccount",
      "save": "sender",
      "saveKey": "senderKey"
    },
    {
      "do": "sendTx",
      "from": "faucet",
      "to": "$sender",
      "value": "3000000000000000000",
      "gas": "21000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "to": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
      "value": "1",
      "save": "txHash",
      "expect": "receipt",
      "key": "$senderKey",
      "timeout": "120s"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$txHash"
      ],
      "select": "blockNumber",
      "save": "txBlock"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "compare": "GreaterOrEqual",
      "expected": "$txBlock",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$txHash"
      ],
      "select": "effectiveGasPrice",
      "save": "egpBP"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$txHash"
      ],
      "select": "effectiveGasPrice",
      "compare": "Equal",
      "is": "$egpBP"
    }
  ]
}
