{
  "schemaVersion": "2",
  "kind": "case",
  "id": "full-sync",
  "description": "CT-NODE-004 — 새 노드가 full 방식으로 모든 블록을 실행하며 기존 체인을 따라잡는다 (기존 명세 RT-A-1-02, NODE-003, 절차는 docs/tc/common/06-detailed-procedures/01-node.md 의 CT-NODE-004). 종단 노드 en1 을 resetNode 로 멈추고 genesis 만 가진 상태로 되돌린 뒤, 생성 노드가 블록을 10개 이상 더 만들면 다시 띄운다. 그러면 en1 은 새 노드처럼 genesis 부터 받아 실행한다. 동기화 방식은 chainbench 가 설정에 full 로 적으므로(기본값이 go-wemix 만 snap 인 차이는 여기서 드러나지 않는다) 따로 지정하지 않는다. 따라잡은 뒤 같은 높이의 블록 해시와 상태 루트가 node1 과 같은지 보고, 받은 경로가 downloader 인지 metric eth_downloader_headers_in 으로 본다. 재기동으로 카운터가 0 부터 시작하므로 1 이상이면 이번 동기화에서 받은 것이다. go-wemix 에서 생성 노드끼리의 동기화 점검이 끼어들지 않도록 생산하지 않는 en1 에서 본다. 지표는 동기화가 끝나고 블록 10개를 더 받은 뒤 읽는다. go-wemix 는 계량기 값을 5초마다 도는 타이머가 옮겨야 Prometheus 출력에 나타나서, 바로 읽으면 0 이 나온다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4-en1",
    "launch": {
      "all": {
        "metrics": true
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "do": "resetNode",
      "on": "en1"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "from"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$from",
        "10"
      ],
      "save": "target"
    },
    {
      "do": "waitFor",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$target",
      "timeout": "180s",
      "pollInterval": "2s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "top"
    },
    {
      "do": "startNode",
      "on": "en1"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$top",
      "timeout": "180s",
      "pollInterval": "2s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$top",
        false
      ],
      "select": "hash",
      "save": "wantHash"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$top",
        false
      ],
      "select": "stateRoot",
      "save": "wantRoot"
    },
    {
      "expect": "rpcCall",
      "on": "en1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$top",
        false
      ],
      "select": "hash",
      "compare": "Equal",
      "is": "$wantHash"
    },
    {
      "expect": "rpcCall",
      "on": "en1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$top",
        false
      ],
      "select": "stateRoot",
      "compare": "Equal",
      "is": "$wantRoot"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$top",
        "10"
      ],
      "save": "settled"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$settled",
      "timeout": "60s",
      "pollInterval": "1s"
    },
    {
      "expect": "metric",
      "on": "en1",
      "name": "eth_downloader_headers_in",
      "compare": "GreaterOrEqual",
      "is": 1
    }
  ]
}
