{
  "schemaVersion": "2",
  "kind": "case",
  "id": "stress-block-time",
  "description": "Measure block production time statistics over last 100 blocks (원본 stress/block-time.sh)",
  "requires": [
    "rpc",
    "consensus"
  ],
  "chainPreset": "stablenet-bp4",
  "steps": [
    {
      "do": "waitBlock",
      "target": 20,
      "timeout": "180s"
    },
    {
      "expect": "blockInterval",
      "on": "node1",
      "blocks": 15,
      "maxSeconds": 60
    }
  ]
}
