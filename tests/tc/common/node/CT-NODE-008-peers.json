{
  "schemaVersion": "2",
  "kind": "case",
  "id": "basic-peers",
  "description": "CT-NODE-008 — 모든 노드에 피어가 있고, 피어 정보에 상대 노드가 보인다 (절차는 docs/tc/common/06-detailed-procedures/01-node.md). 2026-09-29 에 basic-peers 와 admin-peers-populated 두 파일을 합쳤다. 피어 수는 모든 노드에서 1 이상인지 본다. 피어 정보는 id 로 대조한다: node2~node5(en1) 의 admin_nodeInfo.id 가 node1 의 admin_peers 목록에 모두 있어야 한다. admin_peers 는 순서를 약속하지 않으므로 목록 전체(*.id)에서 찾는다. 문서 절차 1 은 부트노드로 기동한다고 적었지만 chainbench 는 static 노드로 잇는다(NoDiscovery). 피어가 맺어지는지 보는 목적은 같다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": "stablenet-bp4-en1",
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "120s"
    },
    {
      "expect": "peerCount",
      "onEach": [
        "all"
      ],
      "compare": "GreaterOrEqual",
      "is": "1"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "rpcCall",
      "on": "node1",
      "is": "4",
      "method": "admin_peers",
      "select": "#"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node2",
      "method": "admin_nodeInfo",
      "select": "id",
      "save": "id2"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node3",
      "method": "admin_nodeInfo",
      "select": "id",
      "save": "id3"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node4",
      "method": "admin_nodeInfo",
      "select": "id",
      "save": "id4"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node5",
      "method": "admin_nodeInfo",
      "select": "id",
      "save": "id5"
    },
    {
      "expect": "rpcCall",
      "on": "node1",
      "method": "admin_peers",
      "select": "*.id",
      "compare": "Contains",
      "is": "$id2"
    },
    {
      "expect": "rpcCall",
      "on": "node1",
      "method": "admin_peers",
      "select": "*.id",
      "compare": "Contains",
      "is": "$id3"
    },
    {
      "expect": "rpcCall",
      "on": "node1",
      "method": "admin_peers",
      "select": "*.id",
      "compare": "Contains",
      "is": "$id4"
    },
    {
      "expect": "rpcCall",
      "on": "node1",
      "method": "admin_peers",
      "select": "*.id",
      "compare": "Contains",
      "is": "$id5"
    }
  ]
}
