{
  "schemaVersion": "2",
  "kind": "case",
  "id": "live-block-receive",
  "description": "CT-NODE-007 — 정상 운영 중인 노드가 새 블록을 전파로 받아 바로 반영한다 (기존 명세 RT-A-1-07, 절차는 docs/tc/common/06-detailed-procedures/01-node.md 의 CT-NODE-007). 생산하지 않는 종단 노드 en1 을 관찰한다. node1 의 높이를 읽고 en1 이 5초 안에 그 높이에 닿는지를 다섯 번 본다. 그다음 20블록을 더 지켜본 뒤 metric eth_fetcher_block_broadcasts_in 이 1 이상인지로 블록 전체를 전파로 받은 적이 있는지 본다. 생성 노드는 블록 전체를 피어 수의 제곱근만큼에게 보내고 나머지에는 해시만 알리므로, en1 이 어느 블록을 전체로 받을지는 확률이다. 20블록이면 한 번도 받지 못할 확률은 무시할 만하다. 로그 대신 metric 을 쓰는 이유는 CT-NODE-006 과 같다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4-en1",
    "launch": {
      "all": {
        "metrics": true
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "3",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "h0"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$h0",
      "timeout": "5s",
      "pollInterval": "200ms"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "h1"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$h1",
      "timeout": "5s",
      "pollInterval": "200ms"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "h2"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$h2",
      "timeout": "5s",
      "pollInterval": "200ms"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "h3"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$h3",
      "timeout": "5s",
      "pollInterval": "200ms"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "h4"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$h4",
      "timeout": "5s",
      "pollInterval": "200ms"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "now"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$now",
        "20"
      ],
      "save": "later"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$later",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "expect": "metric",
      "on": "en1",
      "name": "eth_fetcher_block_broadcasts_in",
      "compare": "GreaterOrEqual",
      "is": 1
    }
  ]
}
