{
  "schemaVersion": "2",
  "kind": "case",
  "id": "live-block-receive",
  "description": "CT-NODE-007 — 정상 운영 중인 종단 노드 en1이 새 블록을 전파로 받아 바로 반영한다. 생성 노드의 높이를 읽고 en1이 5초 안에 그 높이에 닿는지를 다섯 번 본다. 그다음 20블록을 더 지켜보고 전체 블록 전파(eth_fetcher_block_broadcasts_in) 또는 해시 통지 후 fetcher 조회(eth_fetcher_block_announces_in) 중 하나 이상의 수신을 확인한다. 생성 노드는 피어 목록 일부에 전체 블록을 보내고 나머지에는 해시를 알리므로 특정 EN이 전체 블록을 받는다는 확률 가정을 하지 않는다. 선언한 두 metric 모두 같은 EN의 유한값으로 읽어 출처를 기록한다. 따라잡은 높이의 블록 해시와 상태 루트도 생성 노드와 비교하여 수신 카운터만으로 상태 반영을 판단하지 않는다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4-en1",
    "launch": {
      "all": {
        "metrics": true
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "3",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "h0"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$h0",
      "timeout": "5s",
      "pollInterval": "200ms"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "h1"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$h1",
      "timeout": "5s",
      "pollInterval": "200ms"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "h2"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$h2",
      "timeout": "5s",
      "pollInterval": "200ms"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "h3"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$h3",
      "timeout": "5s",
      "pollInterval": "200ms"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "h4"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$h4",
      "timeout": "5s",
      "pollInterval": "200ms"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "now"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$now",
        "20"
      ],
      "save": "later",
      "format": "hex"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$later",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "expect": "metric",
      "on": "en1",
      "name": "eth_fetcher_block_broadcasts_in",
      "compare": "GreaterOrEqual",
      "is": 1,
      "alternatives": [
        "eth_fetcher_block_announces_in"
      ]
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$later",
        false
      ],
      "select": "hash",
      "save": "wantHash"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$later",
        false
      ],
      "select": "stateRoot",
      "save": "wantRoot"
    },
    {
      "expect": "rpcCall",
      "on": "en1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$later",
        false
      ],
      "select": "hash",
      "compare": "Equal",
      "is": "$wantHash"
    },
    {
      "expect": "rpcCall",
      "on": "en1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$later",
        false
      ],
      "select": "stateRoot",
      "compare": "Equal",
      "is": "$wantRoot"
    }
  ]
}
