{
  "schemaVersion": "2",
  "kind": "case",
  "id": "e1-mixed-producers",
  "requires": [
    "rpc",
    "consensus"
  ],
  "skipsOn": [],
  "chainPreset": "stablenet-bp3-en1-table",
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "expect": "validators",
      "compare": "Len",
      "is": 3
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "60s",
      "pollInterval": "2s"
    }
  ]
}
