{
  "schemaVersion": "2",
  "kind": "case",
  "id": "downloader-catch-up",
  "description": "CT-NODE-006 — 끊겼던 노드가 다시 들어오면 누락 블록을 한꺼번에 받아 높이와 해시가 맞춰진다 (기존 명세 RT-A-1-06, 절차는 docs/tc/common/06-detailed-procedures/01-node.md 의 CT-NODE-006). 종단 노드 en1 을 멈추고 생성 노드가 블록을 40개 이상 더 만들게 한 뒤 다시 띄운다. 32블록 넘게 벌어지면 새 블록 전파(fetcher)는 그 블록을 버리므로 누락분은 downloader 가 받는다. 세 클라이언트가 같은 이름으로 내는 metric eth_downloader_headers_in 이 1 이상인지로 그 경로를 확인한다. 문서가 말한 '노드 로그로 확인' 대신 metric 을 쓰는 것은 로그 문구는 세 체인이 같지만 해당 줄이 Debug 수준이라 기본 설정에서 남지 않기 때문이다. 연결만 끊으면 프로세스가 살아 있어 카운터가 초기화되지 않으므로 노드를 멈춘다. 따라잡은 뒤 같은 높이의 블록 해시와 상태 루트를 node1 과 비교한다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4-en1",
    "launch": {
      "all": {
        "metrics": true
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "3",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "do": "stopNode",
      "on": "en1"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "from"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$from",
        "40"
      ],
      "save": "target"
    },
    {
      "do": "waitFor",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$target",
      "timeout": "180s",
      "pollInterval": "2s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "top"
    },
    {
      "do": "startNode",
      "on": "en1"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$top",
      "timeout": "180s",
      "pollInterval": "2s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$top",
        false
      ],
      "select": "hash",
      "save": "wantHash"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$top",
        false
      ],
      "select": "stateRoot",
      "save": "wantRoot"
    },
    {
      "expect": "rpcCall",
      "on": "en1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$top",
        false
      ],
      "select": "hash",
      "compare": "Equal",
      "is": "$wantHash"
    },
    {
      "expect": "rpcCall",
      "on": "en1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$top",
        false
      ],
      "select": "stateRoot",
      "compare": "Equal",
      "is": "$wantRoot"
    },
    {
      "expect": "metric",
      "on": "en1",
      "name": "eth_downloader_headers_in",
      "compare": "GreaterOrEqual",
      "is": 1
    }
  ]
}
