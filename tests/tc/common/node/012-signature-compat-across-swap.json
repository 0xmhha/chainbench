{
  "schemaVersion": "2",
  "kind": "case",
  "id": "signature-compat-across-swap",
  "description": "TC-3-1-04 — 노드가 다른 바이너리로 재기동해도 기존 tx 의 blockNumber·status·from·to 가 보존된다 그 tx 는 별도 계정이 서명해 eth_sendRawTransaction 으로 보낸다. 이 케이스가 보존을 확인하는 값에 from 이 들어 있는데, from 은 영수증에 적힌 값이 아니라 서명에서 되찾는 값이다. 그러니 바이너리를 바꾼 노드가 같은 from 을 내놓는지가 곧 서명 호환성이다. 노드가 자기 계정으로 서명하면 그 서명은 우리가 만든 것이 아니라 노드가 만든 것이라, 사용자가 보낸 tx 가 살아남는지를 묻는 이 케이스의 뜻과 어긋난다. 교체 전후 web3_clientVersion 이 달라야 한다. 같으면 같은 프로그램으로 바꿔 끼운 것이라, 새 버전과의 서명 호환이라는 이 케이스의 질문에 답하지 못한다. upgrade 바이너리가 기본 바이너리와 같은 빌드면(예: 두 번째 빌드가 없는 체인) 이 검사가 실패한다.",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "skipsOn": [],
  "chainPreset": "stablenet-bp4-en1-default-upgrade",
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "do": "newAccount",
      "save": "sender",
      "saveKey": "senderKey"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "from": "faucet",
      "to": "$sender",
      "value": "3000000000000000000",
      "gas": "21000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "to": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
      "value": "1",
      "save": "legacyTx",
      "expect": "receipt",
      "key": "$senderKey",
      "timeout": "120s"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "select": "blockNumber",
      "save": "blockBefore"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "select": "status",
      "save": "statusBefore"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "select": "from",
      "save": "fromBefore"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "select": "to",
      "save": "toBefore"
    },
    {
      "do": "read",
      "on": "en1",
      "source": "rpcCall",
      "method": "web3_clientVersion",
      "params": [],
      "save": "versionBefore"
    },
    {
      "do": "swapNode",
      "on": "en1",
      "binary": "upgrade",
      "purpose": "signature-compat"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "compare": "GreaterOrEqual",
      "expected": "$blockBefore",
      "timeout": "180s",
      "pollInterval": "2s"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "web3_clientVersion",
      "params": [],
      "compare": "NotEqual",
      "is": "$versionBefore"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "select": "blockNumber",
      "compare": "Equal",
      "is": "$blockBefore"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "select": "status",
      "compare": "Equal",
      "is": "$statusBefore"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "select": "from",
      "compare": "Equal",
      "is": "$fromBefore"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "select": "to",
      "compare": "Equal",
      "is": "$toBefore"
    },
    {
      "do": "readNodeLog",
      "on": "en1",
      "save": "upgradedNodeLog"
    }
  ]
}
