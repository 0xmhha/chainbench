{
  "schemaVersion": "2",
  "kind": "case",
  "id": "remote-chain-info",
  "description": "레거시 remote/chain-info: 붙은 체인이 chainId 를 보고하고 동기화가 끝나 있다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "expect": "chainId",
      "compare": "Equal",
      "is": "8283",
      "isPerChain": {
        "wbft": "8284",
        "wemix": "8285"
      }
    },
    {
      "expect": "rpcCall",
      "is": false,
      "method": "eth_syncing"
    },
    {
      "compare": "NotEqual",
      "expect": "rpcCall",
      "is": "",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "hash"
    }
  ]
}
