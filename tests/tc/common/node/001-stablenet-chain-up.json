{
  "schemaVersion": "2",
  "kind": "case",
  "id": "stablenet-chain-up",
  "requires": [
    "rpc",
    "consensus"
  ],
  "skipsOn": [],
  "chainPreset": "stablenet-bp4",
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "120s"
    },
    {
      "expect": "chainId",
      "compare": "Equal",
      "is": "8283",
      "isPerChain": {
        "wbft": "8284",
        "wemix": "8285"
      }
    },
    {
      "expect": "blockNumber",
      "compare": "GreaterOrEqual",
      "is": "2"
    },
    {
      "expect": "validators",
      "compare": "Len",
      "is": 4
    },
    {
      "expect": "rpc",
      "method": "net_peerCount",
      "compare": "NotEqual",
      "is": "0x0"
    },
    {
      "expect": "sameBlockHash",
      "block": "0x0"
    }
  ]
}
