{
  "schemaVersion": "2",
  "kind": "case",
  "id": "snap-sync",
  "description": "CT-NODE-005 — 새 노드가 상태 스냅샷으로 동기화한 뒤 잔액을 조회할 수 있다 (기존 명세 RT-A-1-03, NODE-004, 절차는 docs/tc/common/06-detailed-procedures/01-node.md 의 CT-NODE-005). 종단 노드 en1 을 syncMode snap 으로 두고 resetNode 로 genesis 만 가진 상태로 멈춰 둔다. 세 클라이언트 모두 head 가 0 인 노드에서만 snap 을 켜고, 블록을 하나라도 가진 노드는 full 로 바꾼다(eth/handler.go). 그래서 네트워크와 함께 떠서 블록을 받은 노드로는 snap 을 볼 수 없다. 새 계정이 송금한 블록을 적어 두고 그 뒤로 150블록이 쌓이면 en1 을 띄운다. pivot 은 head 에서 64 블록 아래라서 송금 블록은 pivot 아래에 놓이고, snap 은 pivot 아래 블록의 영수증을 내려받는다. full 은 영수증을 내려받지 않고 실행해서 만든다. 그래서 metric eth_downloader_receipts_in 이 1 이상이면 snap 을 실제로 탄 것이고, full 로 바뀌어 끝났다면 이 검사에서 실패한다. 따라잡은 뒤 같은 높이의 상태 루트와 해시가 node1 과 같은지, 송금받은 계정의 잔액이 en1 에서 조회되는지 본다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": {
    "extends": "stablenet-bp4-en1",
    "topology": {
      "syncMode": "snap"
    },
    "launch": {
      "all": {
        "metrics": true
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "do": "resetNode",
      "on": "en1"
    },
    {
      "do": "newAccount",
      "save": "payee",
      "saveKey": "payeeKey"
    },
    {
      "do": "newAccount",
      "save": "sender",
      "saveKey": "senderKey"
    },
    {
      "do": "sendTx",
      "from": "faucet",
      "on": "node1",
      "to": "$sender",
      "value": "10000000000000000000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_maxPriorityFeePerGas",
      "save": "tip"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "baseFeePerGas",
      "save": "base"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$base",
        "$base",
        "$tip"
      ],
      "save": "feeCap"
    },
    {
      "do": "sendTx",
      "key": "$senderKey",
      "on": "node1",
      "to": "$payee",
      "value": "1234567000000000000",
      "gas": "21000",
      "maxFeePerGas": "$feeCap",
      "maxPriorityFeePerGas": "$tip",
      "expect": "receipt",
      "save": "h",
      "timeout": "120s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$h"
      ],
      "select": "blockNumber",
      "save": "txBlock"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$txBlock",
        "150"
      ],
      "save": "target"
    },
    {
      "do": "waitFor",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$target",
      "timeout": "600s",
      "pollInterval": "5s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_blockNumber",
      "save": "top"
    },
    {
      "do": "startNode",
      "on": "en1"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$top",
      "timeout": "300s",
      "pollInterval": "2s"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_syncing",
      "compare": "Equal",
      "expected": false,
      "timeout": "300s",
      "pollInterval": "2s"
    },
    {
      "expect": "metric",
      "on": "en1",
      "name": "eth_downloader_receipts_in",
      "compare": "GreaterOrEqual",
      "is": 1
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$top",
        false
      ],
      "select": "stateRoot",
      "save": "wantRoot"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "on": "node1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$top",
        false
      ],
      "select": "hash",
      "save": "wantHash"
    },
    {
      "expect": "rpcCall",
      "on": "en1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$top",
        false
      ],
      "select": "stateRoot",
      "compare": "Equal",
      "is": "$wantRoot"
    },
    {
      "expect": "rpcCall",
      "on": "en1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$top",
        false
      ],
      "select": "hash",
      "compare": "Equal",
      "is": "$wantHash"
    },
    {
      "expect": "balanceAt",
      "on": "en1",
      "address": "$payee",
      "compare": "Equal",
      "is": "1234567000000000000"
    }
  ]
}
