{
  "schemaVersion": "2",
  "kind": "case",
  "id": "basic-wbft-consensus",
  "description": "Verify WBFT protocol properties - validator participation, round stability, commit seals (원본 basic/wbft-consensus.sh)",
  "requires": [
    "rpc",
    "consensus"
  ],
  "env": "stablenet-bp4-en1",
  "steps": [
    {
      "do": "waitBlock",
      "target": 5,
      "timeout": "120s"
    },
    {
      "expect": "rpc",
      "method": "istanbul_getValidators",
      "params": [
        "latest"
      ],
      "select": "#",
      "compare": "GreaterOrEqual",
      "is": "4"
    },
    {
      "expect": "rpc",
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "@latest"
      ],
      "select": "prevCommittedSeal.sealers.#",
      "compare": "GreaterOrEqual",
      "is": "3"
    }
  ]
}
