{
  "schemaVersion": "2",
  "kind": "case",
  "id": "basic-rpc-health",
  "description": "Verify all node RPC endpoints are responding (원본 basic/rpc-health.sh)",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "basic-stablenet",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4,
      "en": 1
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "120s"
    },
    {
      "expect": "blockNumber",
      "on": "node1",
      "compare": "GreaterOrEqual",
      "is": "0"
    },
    {
      "expect": "blockNumber",
      "on": "node2",
      "compare": "GreaterOrEqual",
      "is": "0"
    },
    {
      "expect": "blockNumber",
      "on": "node3",
      "compare": "GreaterOrEqual",
      "is": "0"
    },
    {
      "expect": "blockNumber",
      "on": "node4",
      "compare": "GreaterOrEqual",
      "is": "0"
    },
    {
      "expect": "blockNumber",
      "on": "en1",
      "compare": "GreaterOrEqual",
      "is": "0"
    }
  ]
}
