{
  "schemaVersion": "2",
  "kind": "case",
  "id": "basic-tx-send",
  "description": "Send a transaction and verify it gets included in a block (원본 basic/tx-send.sh)",
  "requires": [
    "rpc"
  ],
  "env": "stablenet-bp4-en1",
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "120s"
    },
    {
      "do": "newAccount",
      "save": "r",
      "saveKey": "rk"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "from": "node1",
      "to": "$r",
      "value": "1",
      "expect": "receipt"
    },
    {
      "expect": "balanceAt",
      "on": "node1",
      "address": "$r",
      "compare": "Greater",
      "is": "0"
    }
  ]
}
