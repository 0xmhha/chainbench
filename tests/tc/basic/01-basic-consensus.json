{
  "schemaVersion": "2",
  "kind": "case",
  "id": "basic-consensus",
  "description": "Verify blocks are being produced and all validators participate (원본 basic/consensus.sh)",
  "requires": [
    "rpc",
    "consensus"
  ],
  "env": "stablenet-bp4-en1",
  "steps": [
    {
      "do": "waitBlock",
      "target": 20,
      "timeout": "180s"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "60s",
      "pollInterval": "2s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    }
  ]
}
