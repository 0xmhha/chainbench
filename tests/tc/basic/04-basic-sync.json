{
  "schemaVersion": "2",
  "kind": "case",
  "id": "basic-sync",
  "description": "Verify all running nodes have synchronized block heights (원본 basic/sync.sh)",
  "requires": [
    "rpc",
    "consensus"
  ],
  "chainPreset": "stablenet-bp4-en1",
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    }
  ]
}
