{
  "schemaVersion": "2",
  "kind": "case",
  "id": "basic-sync",
  "description": "Verify all running nodes have synchronized block heights (원본 basic/sync.sh)",
  "requires": [
    "rpc",
    "consensus"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "basic-stablenet",
    "chain": "stablenet",
    "topology": {
      "bp": 4,
      "en": 1
    },
    "keys": {
      "nodekeys": {
        "source": "keyPreset",
        "ref": "keys/preset"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    }
  ]
}
