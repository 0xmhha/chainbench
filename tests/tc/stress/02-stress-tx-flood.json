{
  "schemaVersion": "2",
  "kind": "case",
  "id": "stress-tx-flood",
  "description": "Send N transactions rapidly and measure throughput (원본 stress/tx-flood.sh)",
  "requires": [
    "rpc",
    "consensus"
  ],
  "env": "stablenet-bp4",
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "60s"
    },
    {
      "do": "load",
      "from": "node1",
      "fillPercent": 30,
      "blocks": 15,
      "timeout": "90s"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "60s",
      "pollInterval": "2s"
    }
  ]
}
