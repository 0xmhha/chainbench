{
  "schemaVersion": "2",
  "kind": "case",
  "id": "stress-tx-flood",
  "description": "Send N transactions rapidly and measure throughput (원본 stress/tx-flood.sh)",
  "requires": [
    "rpc",
    "consensus"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "stress-stablenet",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "60s"
    },
    {
      "do": "load",
      "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8",
      "fillPercent": 30,
      "blocks": 15,
      "timeout": "90s"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "60s",
      "pollInterval": "2s"
    }
  ]
}
