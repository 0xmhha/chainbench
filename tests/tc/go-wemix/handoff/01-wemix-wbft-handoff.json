{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wemix-wbft-handoff",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "wemix-wbft",
    "chain": "wbft",
    "binaries": {
      "producer": "${GWEMIX_BIN:-gwemix}",
      "validator": "${GWBFT_BIN:-gwbft}"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "upgrade": {
      "profile": "profiles/wemix-upgrade.yaml",
      "template": "${GOWEMIX_TEMPLATE}"
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 22,
      "timeout": "240s"
    },
    {
      "expect": "blockNumber",
      "compare": "Greater",
      "is": "20"
    },
    {
      "expect": "rpc",
      "method": "eth_getBlockByNumber",
      "params": [
        "0x15",
        false
      ],
      "select": "miner",
      "compare": "In",
      "is": [
        "0xc17d493883eaa3b4cceb0f214b273392d562f9d8",
        "0x2493a84a8f83cb87fdcbe0bb3b2d313f69a58d3c",
        "0x8c4a10b9108d49b9d23f764464090831d9c17764",
        "0x8eb79036bc0f3aba136ef18b3a2fb8c1188939a6"
      ]
    },
    {
      "expect": "rpc",
      "method": "istanbul_getValidators",
      "params": [
        "latest"
      ],
      "compare": "Len",
      "is": 4
    }
  ]
}
