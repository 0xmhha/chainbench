{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wemix-chain-up-15",
  "requires": [
    "rpc",
    "consensus"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "wemix-docker15",
    "chain": "wemix",
    "topology": {
      "bp": 7,
      "en": 7,
      "pn": 1
    },
    "keys": {
      "nodekeys": {
        "source": "generate"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "300s"
    },
    {
      "expect": "chainId",
      "compare": "Greater",
      "is": "0"
    },
    {
      "expect": "blockNumber",
      "compare": "GreaterOrEqual",
      "is": "2"
    },
    {
      "expect": "rpc",
      "method": "net_peerCount",
      "compare": "NotEqual",
      "is": "0x0"
    }
  ],
  "description": "The standard 15-node shape brought up and producing: 7 bp, 7 en and 1 pn. Endpoints reach the producers through the pn rather than dialling one, so this is also the smallest check that a proxied network of the standard size comes up at all."
}
