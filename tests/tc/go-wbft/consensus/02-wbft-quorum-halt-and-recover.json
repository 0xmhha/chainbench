{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wbft-quorum-halt-and-recover",
  "description": "Take a wbft network below quorum and back: with 4 validators the quorum is floor(2n/3)+1 = 3, so stopping two must halt production and restarting them must resume it. The existing crash case stops ONE node, which the quorum tolerates -- it shows the network survives a loss, not that the quorum is the thing deciding (WA25 depth).",
  "requires": ["rpc", "consensus", "process"],
  "env": {
    "schemaVersion": "2", "kind": "env", "id": "wbft-quorum", "chain": "wbft",
    "binaries": { "default": "gwbft" },
    "topology": { "bp": 4 },
    "keys": { "nodekeys": { "source": "preset", "ref": "keys/preset" } }
  },
  "steps": [
    { "do": "waitBlock", "target": 3, "timeout": "180s" },
    { "do": "stopNode", "on": "node3" },
    { "expect": "blockAdvance", "on": "node1", "timeout": "120s", "pollInterval": "2s" },
    { "do": "stopNode", "on": "node4" },
    { "expect": "blockStalled", "on": "node1", "timeout": "40s", "pollInterval": "2s" },
    { "do": "restartNode", "on": "node3" },
    { "do": "restartNode", "on": "node4" },
    { "expect": "blockAdvance", "on": "node1", "timeout": "180s", "pollInterval": "2s" }
  ]
}
