{
  "schemaVersion": "2",
  "kind": "case",
  "id": "e1-mixed-producers",
  "requires": [
    "rpc",
    "consensus"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "e1-mixed-stablenet",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "nodes": [
        {
          "index": 1,
          "role": "en"
        },
        {
          "index": 2,
          "role": "bp"
        },
        {
          "index": 3,
          "role": "bp"
        },
        {
          "index": 4,
          "role": "bp"
        }
      ]
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "expect": "rpc",
      "method": "istanbul_getValidators",
      "params": [
        "latest"
      ],
      "compare": "Len",
      "is": 3
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "60s",
      "pollInterval": "2s"
    }
  ]
}
