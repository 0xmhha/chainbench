{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wbft-tx-crosses-the-proxied-topology",
  "description": "A transaction submitted at the EDGE of the standard 15-node proxied network must reach the producers and come back as state every node agrees on. The chain-up specs only bring such a network up and the other tx specs run on four mesh-peered nodes, so nothing else checks that a tx crosses the pn in both directions: in to the producers that seal it, out to the endpoint that reads the result.",
  "requires": [
    "rpc",
    "consensus"
  ],
  "chainPreset": "wbft-bp7-en7-pn1",
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "240s"
    },
    {
      "do": "newAccount",
      "save": "s",
      "saveKey": "sk"
    },
    {
      "do": "newAccount",
      "save": "r",
      "saveKey": "rk"
    },
    {
      "do": "sendTx",
      "on": "bp1",
      "from": "faucet",
      "to": "$s",
      "value": "10000000000000000000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "balanceAt",
      "address": "$s",
      "compare": "GreaterOrEqual",
      "expected": "10000000000000000000",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "do": "sendTx",
      "on": "en1",
      "key": "$sk",
      "to": "$r",
      "value": "1000000000000000000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "expect": "balanceAt",
      "on": "bp1",
      "address": "$r",
      "compare": "Equal",
      "is": "1000000000000000000"
    },
    {
      "expect": "balanceAt",
      "on": "bp13",
      "address": "$r",
      "compare": "Equal",
      "is": "1000000000000000000"
    },
    {
      "expect": "balanceAt",
      "on": "pn1",
      "address": "$r",
      "compare": "Equal",
      "is": "1000000000000000000"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "expect": "blockAdvance",
      "on": "en1",
      "timeout": "120s",
      "pollInterval": "2s"
    }
  ]
}
