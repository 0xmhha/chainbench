{
  "schemaVersion": "2",
  "kind": "case",
  "id": "stablenet-faucet-funds",
  "description": "Exercise the faucet action (WA24): top up a freshly generated account and read back its balance. LIVE-UNVERIFIED: authored offline (passes validate), needs a fleet run to confirm the target node's coinbase funder is unlocked.",
  "requires": [
    "rpc"
  ],
  "chainPreset": "stablenet-bp4",
  "steps": [
    {
      "do": "waitBlock",
      "target": 1,
      "timeout": "120s"
    },
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "faucet",
      "to": "$acct",
      "amount": "1000000000000000000",
      "timeout": "60s"
    },
    {
      "expect": "balanceAt",
      "address": "$acct",
      "compare": "GreaterOrEqual",
      "is": "1000000000000000000"
    }
  ]
}
