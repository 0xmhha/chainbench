{
  "schemaVersion": "2",
  "kind": "case",
  "id": "stablenet-register-contract",
  "description": "Exercise the registerContract action (WA24): deploy a contract that accepts any call, then send an encoded call to it through registerContract and confirm the tx is mined without reverting.",
  "requires": ["rpc"],
  "env": {
    "schemaVersion": "2", "kind": "env", "id": "stablenet", "chain": "stablenet",
    "binaries": { "default": "gstable" },
    "topology": { "bp": 4 },
    "keys": { "nodekeys": { "source": "preset", "ref": "keys/preset" } }
  },
  "steps": [
    { "do": "waitBlock", "target": 2, "timeout": "120s" },
    { "do": "deployContract", "on": "node1", "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8", "bytecode": "0x600a600c600039600a6000f3602a60005260206000f3", "gas": "300000", "save": "c" },
    { "do": "registerContract", "on": "node1", "to": "$c", "data": "0x01", "gas": "100000", "save": "reg" },
    { "expect": "txStatus", "on": "node1", "hash": "$reg", "is": "0x1" }
  ]
}
