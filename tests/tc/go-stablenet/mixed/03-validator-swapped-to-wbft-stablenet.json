{
  "schemaVersion": "2",
  "kind": "case",
  "id": "mixed-validator-swapped-to-wbft-stablenet",
  "description": "돌고 있는 gstable validator 를 같은 datadir 와 key 로 wbft-stablenet 으로 바꿔 띄워도 체인이 이어지고, 바꾼 노드가 다시 서명한다. swapNode 는 node2 를 멈추고 binary 이름 wbft 의 파일로 같은 명령줄을 다시 띄운다. 바꾼 뒤 node2 의 web3_clientVersion 이 wbft-stablenet 을 담아야 한다. 그렇지 않으면 같은 프로그램을 다시 띄운 것이라 교체를 보지 않는다. wbft-stablenet 은 서명 기록 없이 넘겨받은 key 로는 첫 높이에 서명하지 않으므로(take-over guard) 교체한 높이에서 다섯 block 을 더 기다린다. 세 case 가 한 망을 이어 쓰므로 높이는 절대값이 아니라 교체 때의 높이에서 잰다. swapNode 와 startNode 는 RPC 가 열리기 전에 돌아오므로 eth_blockNumber 가 답할 때까지 먼저 기다린다. 그다음이 구별되는 주장이다. node4 를 멈추면 정족수 셋에 node2 가 들어가야 하므로, 체인이 나아가는 것은 바꾼 node2 가 서명한다는 뜻이다. 바꾼 노드가 따라가기만 하고 서명하지 않으면 이 단계에서 체인이 멈춘다. 끝에 node4 를 다시 띄우고 모든 노드의 block hash 가 같은지 본다.",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "skipsOn": [],
  "chainPreset": "stablenet-bp4-en1-mixed",
  "steps": [
    {
      "do": "waitBlock",
      "target": 5,
      "timeout": "180s"
    },
    {
      "expect": "rpc",
      "on": "node2",
      "method": "web3_clientVersion",
      "params": [],
      "compare": "NotContains",
      "is": "wbft-stablenet"
    },
    {
      "do": "swapNode",
      "on": "node2",
      "binary": "wbft"
    },
    {
      "do": "waitFor",
      "on": "node2",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "compare": "GreaterOrEqual",
      "expected": "0",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "expect": "rpc",
      "on": "node2",
      "method": "web3_clientVersion",
      "params": [],
      "compare": "Contains",
      "is": "wbft-stablenet"
    },
    {
      "do": "read",
      "on": "node2",
      "source": "blockNumber",
      "save": "swappedAt"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$swappedAt",
        "5"
      ],
      "save": "pastFloor"
    },
    {
      "do": "waitFor",
      "on": "node2",
      "source": "blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "$pastFloor",
      "timeout": "180s",
      "pollInterval": "2s"
    },
    {
      "do": "stopNode",
      "on": "node4"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "expect": "blockAdvance",
      "on": "node2",
      "timeout": "60s",
      "pollInterval": "2s"
    },
    {
      "do": "startNode",
      "on": "node4"
    },
    {
      "do": "waitFor",
      "on": "node4",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "compare": "GreaterOrEqual",
      "expected": "0",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "expect": "blockAdvance",
      "on": "node4",
      "timeout": "180s",
      "pollInterval": "2s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    }
  ]
}
