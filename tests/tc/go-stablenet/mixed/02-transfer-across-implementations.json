{
  "schemaVersion": "2",
  "kind": "case",
  "id": "mixed-transfer-across-implementations",
  "description": "한 구현의 노드에 보낸 송금이 다른 구현의 노드에서도 같은 결과로 보인다. 먼저 web3_clientVersion 으로 node1·node2 가 gstable, node3·en1 이 wbft-stablenet 인지 본다. 이 확인이 없을 때는 wbft 이름을 gstable 로 풀어 섞지 않은 망에서도 이 case 가 통과했다. 세 경로를 본다. (1) gstable node1 의 faucet 이 새 계정에 자금을 주고, wbft-stablenet 인 en1 에 그 잔액이 도착하는지 기다린다. (2) 그 계정이 자기 키로 서명해 en1 에 보낸 송금(eth_sendRawTransaction)이 들어가고, gstable node2 가 같은 영수증 status 와 받는 쪽 잔액을 보인다. 이 송금은 wbft-stablenet 의 pool 에서 gstable 로 퍼지거나 wbft-stablenet 의 제안으로 들어가야 한다. (3) wbft-stablenet 인 node3 이 자기 keystore 계정으로 서명해 보낸 송금(eth_sendTransaction, --unlock 으로 연 계정)이 들어가고 gstable node1 에서 보인다. 이 경로는 wbft-stablenet 이 gstable 의 계정 플래그를 받아야 성립한다. 받는 쪽은 모두 새 계정이다. validator 계정은 block 보상으로 잔액이 저절로 움직여 '늘었다' 가 송금 없이도 참이 된다.",
  "requires": [
    "rpc"
  ],
  "skipsOn": [],
  "chainPreset": "stablenet-bp4-en1-mixed",
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "180s"
    },
    {
      "expect": "rpc",
      "on": "node1",
      "method": "web3_clientVersion",
      "params": [],
      "compare": "NotContains",
      "is": "wbft-stablenet"
    },
    {
      "expect": "rpc",
      "on": "node2",
      "method": "web3_clientVersion",
      "params": [],
      "compare": "NotContains",
      "is": "wbft-stablenet"
    },
    {
      "expect": "rpc",
      "on": "node3",
      "method": "web3_clientVersion",
      "params": [],
      "compare": "Contains",
      "is": "wbft-stablenet"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "web3_clientVersion",
      "params": [],
      "compare": "Contains",
      "is": "wbft-stablenet"
    },
    {
      "do": "newAccount",
      "save": "sender",
      "saveKey": "senderKey"
    },
    {
      "do": "newAccount",
      "save": "recipient",
      "saveKey": "recipientKey"
    },
    {
      "do": "newAccount",
      "save": "nodeRecipient",
      "saveKey": "nodeRecipientKey"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "from": "faucet",
      "to": "$sender",
      "value": "3000000000000000000",
      "gas": "21000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "balanceAt",
      "address": "$sender",
      "compare": "Equal",
      "expected": "3000000000000000000",
      "timeout": "120s",
      "pollInterval": "2s"
    },
    {
      "do": "sendTx",
      "on": "en1",
      "key": "$senderKey",
      "to": "$recipient",
      "value": "1000000000000000000",
      "expect": "receipt",
      "save": "rawHash",
      "timeout": "120s"
    },
    {
      "expect": "rpc",
      "on": "node2",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$rawHash"
      ],
      "select": "status",
      "compare": "Equal",
      "is": "0x1"
    },
    {
      "do": "waitFor",
      "on": "node2",
      "source": "balanceAt",
      "address": "$recipient",
      "compare": "Equal",
      "expected": "1000000000000000000",
      "timeout": "60s",
      "pollInterval": "2s"
    },
    {
      "do": "sendTx",
      "on": "node3",
      "from": "node3",
      "to": "$nodeRecipient",
      "value": "1000000000000000000",
      "expect": "receipt",
      "save": "nodeHash",
      "timeout": "120s"
    },
    {
      "expect": "rpc",
      "on": "node1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$nodeHash"
      ],
      "select": "status",
      "compare": "Equal",
      "is": "0x1"
    },
    {
      "do": "waitFor",
      "on": "node1",
      "source": "balanceAt",
      "address": "$nodeRecipient",
      "compare": "Equal",
      "expected": "1000000000000000000",
      "timeout": "60s",
      "pollInterval": "2s"
    }
  ]
}
