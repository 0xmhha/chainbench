{
  "schemaVersion": "2",
  "kind": "case",
  "id": "chain-id",
  "description": "RT-A-1-01 — 제네시스 블록으로 노드 초기화 (원본 regression/ethereum/01-test-genesis-init)",
  "requires": [
    "rpc",
    "family:wbft"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "compare": "Regexp",
      "expect": "rpcCall",
      "is": "^0x[0-9a-fA-F]+$",
      "method": "eth_chainId"
    },
    {
      "compare": "Greater",
      "expect": "chainId",
      "is": "0"
    }
  ]
}
