{
  "schemaVersion": "1",
  "id": "chain-id",
  "applicableChains": "stablenet,wbft",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "assertions": [
    { "assert": "rpcCall", "method": "eth_chainId", "compare": "Regexp", "expected": "^0x[0-9a-fA-F]+$" },
    { "assert": "chainId", "compare": "Greater", "expected": "0" }
  ]
}
