{
  "schemaVersion": "2",
  "kind": "case",
  "id": "eth-call-revert-returns-error",
  "description": "RT-A-3-05 — eth_call로 revert하는 함수 호출 시 에러 반환 (원본 regression/ethereum/23-test-eth-call-revert)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "eth-call-revert-returns-error-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "data": "0x6080604052348015600e575f5ffd5b50606a80601a5f395ff3fe6080604052348015600e575f5ffd5b50600436106026575f3560e01c8063a9cc471814602a575b5f5ffd5b60306032565b005b60405162461bcd60e51b815260206004820152600960248201526810905117d25394155560ba1b604482015260640160405180910390fd",
      "do": "sendTx",
      "from": "node1",
      "gas": "300000",
      "on": "node1",
      "save": "dhash"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$dhash"
      ],
      "save": "addr",
      "select": "contractAddress",
      "source": "rpcCall"
    },
    {
      "address": "$addr",
      "compare": "NotEqual",
      "do": "waitFor",
      "expected": "0x",
      "pollInterval": "1s",
      "source": "codeAt",
      "timeout": "60s"
    },
    {
      "expect": "txStatus",
      "hash": "$dhash",
      "is": "0x1"
    },
    {
      "data": "0xa9cc4718",
      "expect": "callError",
      "to": "$addr"
    }
  ]
}
