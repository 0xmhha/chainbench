{
  "schemaVersion": "2",
  "kind": "case",
  "id": "logs-query-well-formed",
  "description": "RT-A-4-04 — eth_getLogs 이벤트 로그 조회 (원본 regression/ethereum/29-test-eth-get-logs)",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "logs-query-well-formed-env",
    "chain": "stablenet",
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "keyPreset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "compare": "GreaterOrEqual",
      "expect": "logs",
      "fromBlock": "latest",
      "is": "0",
      "select": "count",
      "toBlock": "latest"
    }
  ]
}
