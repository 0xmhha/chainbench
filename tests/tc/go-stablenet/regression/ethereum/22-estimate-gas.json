{
  "schemaVersion": "2",
  "kind": "case",
  "id": "estimate-gas",
  "description": "RT-A-3-04 — eth_estimateGas 정상 동작 (원본 regression/ethereum/22-test-estimate-gas)",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "estimate-gas-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "compare": "GreaterOrEqual",
      "data": "0x",
      "expect": "estimateGas",
      "is": "21000",
      "to": "0x0000000000000000000000000000000000000001"
    }
  ]
}
