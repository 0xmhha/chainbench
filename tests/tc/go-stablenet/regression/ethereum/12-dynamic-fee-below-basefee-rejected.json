{
  "schemaVersion": "2",
  "kind": "case",
  "id": "dynamic-fee-below-basefee-rejected",
  "description": "RT-A-2-05a — GasTipCap < MinTip tx 거부 검증 (원본 regression/ethereum/12-test-tipcap-underpriced)",
  "requires": [
    "rpc",
    "engine:anzeon"
  ],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "sendTx",
      "expect": "reject",
      "from": "node1",
      "gas": "21000",
      "maxFeePerGas": "1",
      "maxPriorityFeePerGas": "1",
      "to": "0x00000000000000000000000000000000C0FFEE10",
      "value": "1",
      "reason": "transaction underpriced"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "0x1"
    }
  ]
}
