{
  "schemaVersion": "2",
  "kind": "case",
  "id": "insufficient-funds-rejected",
  "description": "RT-A-2-06 — 잔액 부족 tx 거부 (원본 regression/ethereum/14-test-insufficient-funds)",
  "applicableChains": "stablenet,wbft",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "insufficient-funds-rejected-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "address": "node1",
      "do": "read",
      "save": "bal",
      "source": "balanceAt"
    },
    {
      "do": "read",
      "of": [
        "$bal",
        "1000000000000000000"
      ],
      "op": "sum",
      "save": "over",
      "source": "derive"
    },
    {
      "do": "sendTx",
      "expect": "reject",
      "from": "node1",
      "gas": "21000",
      "to": "0x00000000000000000000000000000000C0FFEE07",
      "value": "$over",
      "reason": "insufficient funds"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "0x1"
    }
  ]
}
