{
  "schemaVersion": "1",
  "id": "insufficient-funds-rejected",
  "applicableChains": "stablenet,wbft",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "read": { "source": "balanceAt",
                "address": "node1", "save": "bal" } },
    { "read": { "source": "derive", "op": "sum", "of": ["$bal", "1000000000000000000"], "save": "over" } },
    { "sendTx": { "from": "node1",
                  "to": "0x00000000000000000000000000000000C0FFEE07",
                  "value": "$over", "gas": "21000",
                  "expect": "reject" } }
  ],
  "assertions": [
    { "assert": "blockNumber", "compare": "GreaterOrEqual", "expected": "0x1" }
  ]
}
