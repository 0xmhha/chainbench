{
  "schemaVersion": "1",
  "id": "access-list-tx",
  "applicableChains": "stablenet,wbft",
  "chain": {
    "name": "stablenet",
    "binary": "gstable"
  },
  "requires": [
    "rpc"
  ],
  "steps": [
    {
      "read": {
        "source": "baseFee",
        "save": "base"
      }
    },
    {
      "read": {
        "source": "derive",
        "op": "sum",
        "of": [
          "$base",
          "$base"
        ],
        "save": "gp"
      }
    },
    {
      "read": {
        "source": "rpcCall",
        "method": "eth_createAccessList",
        "params": [
          {
            "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8",
            "to": "0x00000000000000000000000000000000C0FFEE0D",
            "value": "0x1"
          },
          "latest"
        ],
        "select": "accessList",
        "save": "createdList"
      }
    },
    {
      "sendTx": {
        "from": "node1",
        "to": "0x00000000000000000000000000000000C0FFEE0D",
        "value": "1",
        "gas": "21000",
        "gasPrice": "$gp",
        "accessList": "$createdList",
        "save": "hash"
      }
    }
  ],
  "assertions": [
    {
      "assert": "txStatus",
      "hash": "$hash",
      "expected": "0x1"
    },
    {
      "assert": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "type",
      "compare": "Equal",
      "expected": "0x1"
    }
  ],
  "description": "RT-A-2-03: eth_createAccessList 로 노드가 만든 접근 목록을 붙여 type 0x01 트랜잭션을 보낸다."
}
