{
  "schemaVersion": "2",
  "kind": "case",
  "id": "revert-tx-status-zero",
  "description": "RT-A-3-06 — revert tx: receipt.status == 0x0, gasUsed만 차감 검증 (원본 regression/ethereum/24-test-revert-tx)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "revert-tx-status-zero-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "data": "0x600580600b6000396000f360006000fd",
      "do": "sendTx",
      "from": "node1",
      "gas": "200000",
      "save": "dhash"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$dhash"
      ],
      "save": "addr",
      "select": "contractAddress",
      "source": "rpcCall"
    },
    {
      "do": "sendTx",
      "expect": "revert",
      "from": "node1",
      "gas": "100000",
      "save": "chash",
      "to": "$addr"
    },
    {
      "expect": "txStatus",
      "hash": "$dhash",
      "is": "0x1"
    },
    {
      "compare": "Equal",
      "expect": "rpcCall",
      "is": "0x0",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$chash"
      ],
      "select": "status"
    }
  ]
}
