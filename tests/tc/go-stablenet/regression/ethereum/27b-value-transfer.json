{
  "schemaVersion": "1",
  "id": "value-transfer",
  "applicableChains": "stablenet,wbft",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "read": { "source": "rpcCall", "method": "eth_getBalance",
                "params": ["0x00000000000000000000000000000000C0FFEE01", "latest"], "save": "before" } },
    { "sendTx": { "from": "node1",
                  "to": "0x00000000000000000000000000000000C0FFEE01",
                  "value": "1000000000000000000", "gas": "21000", "save": "hash" } },
    { "read": { "source": "rpcCall", "method": "eth_getBalance",
                "params": ["0x00000000000000000000000000000000C0FFEE01", "latest"], "save": "after" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$hash", "expected": "0x1" },
    { "assert": "derive", "op": "diff", "of": ["$after", "$before"],
      "compare": "Equal", "expected": "1000000000000000000" }
  ]
}
