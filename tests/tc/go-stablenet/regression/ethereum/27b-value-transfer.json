{
  "schemaVersion": "2",
  "kind": "case",
  "id": "value-transfer",
  "description": "RT-A-4-03 — eth_sendRawTransaction 서명된 tx 전파 (원본 regression/ethereum/28-test-send-raw-tx)",
  "applicableChains": "stablenet,wbft",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "value-transfer-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "method": "eth_getBalance",
      "params": [
        "0x00000000000000000000000000000000C0FFEE01",
        "latest"
      ],
      "save": "before",
      "source": "rpcCall"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "save": "hash",
      "to": "0x00000000000000000000000000000000C0FFEE01",
      "value": "1000000000000000000"
    },
    {
      "do": "read",
      "method": "eth_getBalance",
      "params": [
        "0x00000000000000000000000000000000C0FFEE01",
        "latest"
      ],
      "save": "after",
      "source": "rpcCall"
    },
    {
      "expect": "txStatus",
      "hash": "$hash",
      "is": "0x1"
    },
    {
      "compare": "Equal",
      "expect": "derive",
      "is": "1000000000000000000",
      "of": [
        "$after",
        "$before"
      ],
      "op": "diff"
    }
  ]
}
