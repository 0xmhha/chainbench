{
  "schemaVersion": "2",
  "kind": "case",
  "id": "set-code-delegation",
  "description": "RT-A-2-10 — SetCodeTx (type 0x4 / EIP-7702) 계정 코드 위임 (원본 regression/ethereum/18-test-setcode-tx)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "set-code-delegation-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "genesis": {
      "overlay": {
        "config": {
          "applepieBlock": 0
        }
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "sponsor",
      "saveKey": "sponsorKey"
    },
    {
      "do": "newAccount",
      "save": "authority",
      "saveKey": "authorityKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundHash",
      "to": "$sponsor",
      "value": "30000000000000000000"
    },
    {
      "authorityKey": "$authorityKey",
      "delegate": "0x1111111111111111111111111111111111111111",
      "do": "sendSetCode",
      "key": "$sponsorKey",
      "on": "en1",
      "save": "scHash"
    },
    {
      "address": "$authority",
      "compare": "Equal",
      "do": "waitFor",
      "expected": "0xef01001111111111111111111111111111111111111111",
      "pollInterval": "1s",
      "source": "codeAt",
      "timeout": "90s"
    },
    {
      "expect": "txStatus",
      "hash": "$fundHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$scHash",
      "is": "0x1"
    },
    {
      "compare": "Equal",
      "expect": "rpcCall",
      "is": "0x4",
      "method": "eth_getTransactionByHash",
      "params": [
        "$scHash"
      ],
      "select": "type"
    },
    {
      "address": "$authority",
      "compare": "Equal",
      "expect": "codeAt",
      "is": "0xef01001111111111111111111111111111111111111111"
    }
  ]
}
