{
  "schemaVersion": "2",
  "kind": "case",
  "id": "gas-limit-exceeds-block-rejected",
  "description": "RT-A-2-07 — Gas Limit 초과 tx 거부 (블록 gas limit 초과) (원본 regression/ethereum/15-test-gaslimit-exceeded)",
  "applicableChains": "stablenet,wbft",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "gas-limit-exceeds-block-rejected-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "save": "gl",
      "select": "gasLimit",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "of": [
        "$gl",
        "1"
      ],
      "op": "sum",
      "save": "over",
      "source": "derive"
    },
    {
      "do": "sendTx",
      "expect": "reject",
      "from": "node1",
      "gas": "$over",
      "to": "0x00000000000000000000000000000000C0FFEE10",
      "value": "1",
      "reason": "exceeds block gas limit"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "0x1"
    }
  ]
}
