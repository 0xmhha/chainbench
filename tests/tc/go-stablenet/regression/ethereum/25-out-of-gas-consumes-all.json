{
  "schemaVersion": "1",
  "id": "out-of-gas-consumes-all",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "sendTx": { "from": "node1",
                  "data": "0x600480600b6000396000f35b600056",
                  "gas": "200000", "save": "dhash" } },
    { "read": { "source": "rpcCall", "method": "eth_getTransactionReceipt",
                "params": ["$dhash"], "select": "contractAddress", "save": "addr" } },
    { "sendTx": { "from": "node1",
                  "to": "$addr", "gas": "50000",
                  "expect": "revert", "save": "chash" } },
    { "read": { "source": "rpcCall", "method": "eth_getTransactionReceipt",
                "params": ["$chash"], "select": "gasUsed", "save": "used" } }
  ],
  "assertions": [
    { "assert": "txStatus", "hash": "$dhash", "expected": "0x1" },
    { "assert": "derive", "op": "diff", "of": ["$used", "50000"],
      "compare": "Equal", "expected": "0" }
  ]
}
