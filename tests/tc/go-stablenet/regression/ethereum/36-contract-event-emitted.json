{
  "schemaVersion": "2",
  "kind": "case",
  "id": "contract-event-emitted",
  "applicableChains": "stablenet,wbft",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "contract-event-emitted-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "data": "0x6027600c60003960276000f37f111111111111111111111111111111111111111111111111111111111111111160006000a100",
      "do": "sendTx",
      "from": "node1",
      "gas": "200000",
      "save": "dhash"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$dhash"
      ],
      "save": "addr",
      "select": "contractAddress",
      "source": "rpcCall"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "100000",
      "save": "ehash",
      "to": "$addr"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$ehash"
      ],
      "save": "blk",
      "select": "blockNumber",
      "source": "rpcCall"
    },
    {
      "expect": "txStatus",
      "hash": "$ehash",
      "is": "0x1"
    },
    {
      "address": "$addr",
      "compare": "Equal",
      "expect": "logs",
      "fromBlock": "$blk",
      "is": "0x1111111111111111111111111111111111111111111111111111111111111111",
      "select": "topic0",
      "toBlock": "$blk",
      "topics": [
        "0x1111111111111111111111111111111111111111111111111111111111111111"
      ]
    }
  ]
}
