{
  "schemaVersion": "2",
  "kind": "case",
  "id": "stablenet-gastip-field",
  "requires": [
    "rpc",
    "engine:anzeon"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "method": "eth_blockNumber",
      "save": "head",
      "source": "rpcCall"
    },
    {
      "compare": "NotNil",
      "expect": "rpcCall",
      "is": null,
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "$head"
      ],
      "select": "gasTip"
    }
  ]
}
