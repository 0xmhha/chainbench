{
  "schemaVersion": "2",
  "kind": "case",
  "id": "block-period-one-second",
  "description": "RT-B-01 — 블록 생산 주기 1초 간격 (원본 regression/wbft/01-test-block-period)",
  "applicableChains": "stablenet,wbft",
  "requires": [
    "rpc"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "method": "eth_blockNumber",
      "save": "n",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "eth_getBlockByNumber",
      "params": [
        "$n",
        false
      ],
      "save": "t1",
      "select": "timestamp",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "eth_getBlockByNumber",
      "params": [
        "$n",
        false
      ],
      "save": "ph1",
      "select": "parentHash",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "eth_getBlockByHash",
      "params": [
        "$ph1",
        false
      ],
      "save": "t0",
      "select": "timestamp",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "eth_getBlockByHash",
      "params": [
        "$ph1",
        false
      ],
      "save": "ph0",
      "select": "parentHash",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "eth_getBlockByHash",
      "params": [
        "$ph0",
        false
      ],
      "save": "tm1",
      "select": "timestamp",
      "source": "rpcCall"
    },
    {
      "compare": "Equal",
      "expect": "derive",
      "is": "1",
      "of": [
        "$t1",
        "$t0"
      ],
      "op": "diff"
    },
    {
      "compare": "Equal",
      "expect": "derive",
      "is": "1",
      "of": [
        "$t0",
        "$tm1"
      ],
      "op": "diff"
    }
  ]
}
