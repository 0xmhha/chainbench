{
  "schemaVersion": "2",
  "kind": "case",
  "id": "wbft-seals-quorum",
  "description": "RT-B-02 — WBFTExtra에 Committed Seal + Prepared Seal 모두 존재하고 quorum 이상 (원본 regression/wbft/02-test-wbft-extra-seal)",
  "requires": [
    "rpc",
    "consensus",
    "family:wbft"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc",
      "consensus"
    ]
  },
  "steps": [
    {
      "do": "read",
      "method": "eth_blockNumber",
      "save": "n",
      "source": "rpcCall"
    },
    {
      "compare": "NotEqual",
      "expect": "rpcCall",
      "is": "0x",
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "$n"
      ],
      "select": "committedSeal.signature"
    },
    {
      "compare": "NotEqual",
      "expect": "rpcCall",
      "is": "0x",
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "$n"
      ],
      "select": "preparedSeal.signature"
    }
  ]
}
