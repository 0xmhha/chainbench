{
  "schemaVersion": "2",
  "kind": "case",
  "id": "zero-address-transfer-rejected",
  "description": "RT-E-05: 0x0 주소로의 값 전송은 EVM 실행에서 거부된다 (ErrZeroAddressTransfer) — 트랜잭션은 채굴되고 영수증 status 가 0 이다.",
  "requires": [
    "rpc",
    "engine:anzeon"
  ],
  "chainPreset": {
    "extends": "stablenet-bp4-boho",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "sendTx",
      "expect": "revert",
      "from": "node1",
      "gas": "100000",
      "on": "node1",
      "to": "0x0000000000000000000000000000000000000000",
      "value": "1"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "0x1"
    }
  ]
}
