{
  "schemaVersion": "2",
  "kind": "case",
  "id": "precompile-transfer-rejected",
  "description": "RT-E-06: 프리컴파일·시스템 컨트랙트 주소로의 값 전송은 5개 주소 모두 EVM 실행에서 거부된다 — 트랜잭션은 채굴되고 영수증 status 가 0 이다.",
  "requires": [
    "rpc",
    "engine:anzeon"
  ],
  "env": {
    "extends": "stablenet-bp4-boho",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "sendTx",
      "expect": "revert",
      "from": "node1",
      "gas": "100000",
      "on": "node1",
      "to": "0x0000000000000000000000000000000000000001",
      "value": "1"
    },
    {
      "do": "sendTx",
      "expect": "revert",
      "from": "node1",
      "gas": "100000",
      "on": "node1",
      "to": "0x0000000000000000000000000000000000000100",
      "value": "1"
    },
    {
      "do": "sendTx",
      "expect": "revert",
      "from": "node1",
      "gas": "100000",
      "on": "node1",
      "to": "0x0000000000000000000000000000000000b00001",
      "value": "1"
    },
    {
      "do": "sendTx",
      "expect": "revert",
      "from": "node1",
      "gas": "100000",
      "on": "node1",
      "to": "0x0000000000000000000000000000000000b00002",
      "value": "1"
    },
    {
      "do": "sendTx",
      "expect": "revert",
      "from": "node1",
      "gas": "100000",
      "on": "node1",
      "to": "accountManager",
      "value": "1"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "0x1"
    }
  ]
}
