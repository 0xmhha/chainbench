{
  "schemaVersion": "2",
  "kind": "case",
  "id": "admin-peers-populated",
  "description": "RT-A-1-05 — P2P 피어 연결 확인 (원본 regression/ethereum/05-test-p2p-peers)",
  "requires": [
    "rpc"
  ],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "compare": "GreaterOrEqual",
      "expect": "rpcCall",
      "is": "1",
      "method": "admin_peers",
      "select": "#"
    },
    {
      "compare": "NotEqual",
      "expect": "rpcCall",
      "is": "",
      "method": "admin_peers",
      "select": "0.id"
    }
  ]
}
