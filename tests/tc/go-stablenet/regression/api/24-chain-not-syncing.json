{
  "schemaVersion": "2",
  "kind": "case",
  "id": "chain-not-syncing",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "chain-not-syncing-env",
    "chain": "stablenet",
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "keyPreset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "expect": "rpcCall",
      "is": false,
      "method": "eth_syncing"
    }
  ]
}
