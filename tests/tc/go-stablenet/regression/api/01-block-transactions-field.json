{
  "schemaVersion": "2",
  "kind": "case",
  "id": "block-transactions-field",
  "description": "RT-G-1-01 — eth_getBlockByNumber(latest) (원본 regression/api/01-test-get-block-by-number)",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "block-transactions-field-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "compare": "Regexp",
      "expect": "rpcCall",
      "is": "^0x[0-9a-fA-F]+$",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "number"
    },
    {
      "compare": "Regexp",
      "expect": "rpcCall",
      "is": "^0x[0-9a-fA-F]{64}$",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "hash"
    },
    {
      "compare": "NotNil",
      "expect": "rpcCall",
      "is": null,
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "select": "transactions"
    }
  ]
}
