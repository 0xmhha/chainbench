{
  "schemaVersion": "1",
  "id": "block-transactions-field",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "assertions": [
    { "assert": "rpcCall", "method": "eth_getBlockByNumber", "params": ["latest", false], "select": "number", "compare": "Regexp", "expected": "^0x[0-9a-fA-F]+$" },
    { "assert": "rpcCall", "method": "eth_getBlockByNumber", "params": ["latest", false], "select": "hash", "compare": "Regexp", "expected": "^0x[0-9a-fA-F]{64}$" },
    { "assert": "rpcCall", "method": "eth_getBlockByNumber", "params": ["latest", false], "select": "transactions", "compare": "NotNil", "expected": null }
  ]
}
