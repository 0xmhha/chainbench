{
  "schemaVersion": "2",
  "kind": "case",
  "id": "commit-signers-quorum",
  "description": "RT-G-3-03 — istanbul_getCommitSignersFromBlock (원본 regression/api/13-test-get-commit-signers)",
  "requires": [
    "rpc",
    "consensus",
    "family:wbft"
  ],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc",
      "consensus"
    ]
  },
  "steps": [
    {
      "do": "read",
      "method": "istanbul_getValidators",
      "params": [
        "latest"
      ],
      "save": "validators",
      "source": "rpcCall"
    },
    {
      "compare": "NotNil",
      "expect": "rpcCall",
      "is": null,
      "method": "istanbul_getCommitSignersFromBlock",
      "params": [
        "latest"
      ]
    },
    {
      "compare": "Equal",
      "expect": "rpcCall",
      "is": "$validators",
      "method": "istanbul_getValidators",
      "params": [
        "latest"
      ]
    }
  ]
}
