{
  "schemaVersion": "2",
  "kind": "case",
  "id": "validator-set-count",
  "requires": [
    "rpc",
    "consensus",
    "family:wbft"
  ],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc",
      "consensus"
    ]
  },
  "steps": [
    {
      "compare": "GreaterOrEqual",
      "do": "waitFor",
      "expected": "1",
      "pollInterval": "1s",
      "source": "blockNumber",
      "timeout": "60s"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "rpcCall",
      "is": "4",
      "method": "istanbul_getValidators",
      "params": [
        "latest"
      ],
      "select": "#"
    }
  ]
}
