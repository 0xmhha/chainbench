{
  "schemaVersion": "2",
  "kind": "case",
  "id": "block-by-hash-consistency",
  "description": "RT-G-1-02 — eth_getBlockByHash (원본 regression/api/02-test-get-block-by-hash)",
  "requires": [
    "rpc"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "save": "hash",
      "select": "hash",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "eth_getBlockByNumber",
      "params": [
        "latest",
        false
      ],
      "save": "number",
      "select": "number",
      "source": "rpcCall"
    },
    {
      "expect": "rpcCall",
      "is": "$hash",
      "method": "eth_getBlockByHash",
      "params": [
        "$hash",
        false
      ],
      "select": "hash"
    },
    {
      "expect": "rpcCall",
      "is": "$number",
      "method": "eth_getBlockByHash",
      "params": [
        "$hash",
        false
      ],
      "select": "number"
    }
  ]
}
