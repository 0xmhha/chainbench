{
  "schemaVersion": "1",
  "id": "node-address-returned",
  "applicableChains": "stablenet,wbft",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc", "consensus"],
  "assertions": [
    {
      "assert": "rpcCall",
      "onEach": ["bp1", "bp2", "bp3", "bp4"],
      "method": "istanbul_nodeAddress",
      "compare": "Regexp",
      "expected": "^0x[0-9a-fA-F]{40}$"
    }
  ]
}
