{
  "schemaVersion": "2",
  "kind": "case",
  "id": "validator-set-nonempty",
  "description": "RT-G-3-02 — istanbul_getValidators (원본 regression/api/12-test-get-validators)",
  "requires": [
    "rpc",
    "consensus",
    "family:wbft"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc",
      "consensus"
    ]
  },
  "steps": [
    {
      "compare": "NotNil",
      "expect": "rpcCall",
      "is": null,
      "method": "istanbul_getValidators",
      "params": [
        "latest"
      ]
    },
    {
      "compare": "Len",
      "expect": "rpcCall",
      "is": 4,
      "method": "istanbul_getValidators",
      "params": [
        "latest"
      ]
    }
  ]
}
