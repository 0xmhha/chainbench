{
  "schemaVersion": "2",
  "kind": "case",
  "id": "validator-set-nonempty",
  "description": "RT-G-3-02 — istanbul_getValidators (원본 regression/api/12-test-get-validators)",
  "applicableChains": "stablenet,wbft",
  "requires": [
    "rpc",
    "consensus"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "validator-set-nonempty-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc",
      "consensus"
    ]
  },
  "steps": [
    {
      "compare": "NotNil",
      "expect": "rpcCall",
      "is": null,
      "method": "istanbul_getValidators",
      "params": [
        "latest"
      ]
    },
    {
      "compare": "Len",
      "expect": "rpcCall",
      "is": 4,
      "method": "istanbul_getValidators",
      "params": [
        "latest"
      ]
    }
  ]
}
