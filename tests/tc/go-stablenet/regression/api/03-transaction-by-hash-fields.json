{
  "schemaVersion": "2",
  "kind": "case",
  "id": "transaction-by-hash-fields",
  "description": "RT-G-1-03 — eth_getTransactionByHash (원본 regression/api/03-test-get-tx-by-hash)",
  "requires": [
    "rpc",
    "family:wbft"
  ],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "save": "hash",
      "to": "0x00000000000000000000000000000000C0FFEE05",
      "value": "1"
    },
    {
      "compare": "EqualCI",
      "expect": "rpcCall",
      "is": "node1",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "from"
    },
    {
      "compare": "EqualCI",
      "expect": "rpcCall",
      "is": "0x00000000000000000000000000000000C0FFEE05",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "to"
    },
    {
      "compare": "NotNil",
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "blockNumber"
    },
    {
      "compare": "NotNil",
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "value"
    }
  ]
}
