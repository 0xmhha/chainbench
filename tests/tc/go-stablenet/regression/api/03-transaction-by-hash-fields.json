{
  "schemaVersion": "2",
  "kind": "case",
  "id": "transaction-by-hash-fields",
  "description": "RT-G-1-03 — eth_getTransactionByHash (원본 regression/api/03-test-get-tx-by-hash)",
  "applicableChains": "stablenet,wbft",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "transaction-by-hash-fields-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "save": "hash",
      "to": "0x00000000000000000000000000000000C0FFEE05",
      "value": "1"
    },
    {
      "compare": "EqualCI",
      "expect": "rpcCall",
      "is": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "from"
    },
    {
      "compare": "EqualCI",
      "expect": "rpcCall",
      "is": "0x00000000000000000000000000000000C0FFEE05",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "to"
    },
    {
      "compare": "NotNil",
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "blockNumber"
    },
    {
      "compare": "NotNil",
      "expect": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$hash"
      ],
      "select": "value"
    }
  ]
}
