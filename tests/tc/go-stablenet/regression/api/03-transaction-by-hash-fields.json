{
  "schemaVersion": "1",
  "id": "transaction-by-hash-fields",
  "applicableChains": "stablenet,wbft",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "sendTx": { "from": "node1",
                  "to": "0x00000000000000000000000000000000C0FFEE05",
                  "value": "1", "gas": "21000", "save": "hash" } }
  ],
  "assertions": [
    { "assert": "rpcCall", "method": "eth_getTransactionByHash", "params": ["$hash"],
      "select": "from", "compare": "EqualCI", "expected": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8" },
    { "assert": "rpcCall", "method": "eth_getTransactionByHash", "params": ["$hash"],
      "select": "to", "compare": "EqualCI", "expected": "0x00000000000000000000000000000000C0FFEE05" },
    { "assert": "rpcCall", "method": "eth_getTransactionByHash", "params": ["$hash"],
      "select": "blockNumber", "compare": "NotNil" },
    { "assert": "rpcCall", "method": "eth_getTransactionByHash", "params": ["$hash"],
      "select": "value", "compare": "NotNil" }
  ]
}
