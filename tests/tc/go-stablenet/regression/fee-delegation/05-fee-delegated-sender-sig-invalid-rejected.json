{
  "schemaVersion": "2",
  "kind": "case",
  "id": "fee-delegated-sender-sig-invalid-rejected",
  "requires": [
    "rpc",
    "tx:0x16"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "genesis": {
      "overlay": {
        "config": {
          "applepieBlock": 0
        }
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundHash",
      "to": "$acct",
      "value": "10000000000000000000"
    },
    {
      "do": "sendRawTampered",
      "feePayerKey": "$acctKey",
      "on": "en1",
      "senderKey": "$acctKey",
      "to": "0x00000000000000000000000000000000C0FFEE22",
      "value": "1",
      "which": "sender"
    },
    {
      "expect": "txStatus",
      "hash": "$fundHash",
      "is": "0x1"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "1"
    }
  ]
}
