{
  "schemaVersion": "2",
  "kind": "case",
  "id": "fee-delegated-unfunded-feepayer-rejected",
  "requires": [
    "rpc"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "genesis": {
      "overlay": {
        "config": {
          "applepieBlock": 0
        }
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "sender",
      "saveKey": "senderKey"
    },
    {
      "do": "newAccount",
      "save": "feePayer",
      "saveKey": "feePayerKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundHash",
      "to": "$sender",
      "value": "10000000000000000000"
    },
    {
      "do": "sendTx",
      "expect": "reject",
      "feePayerKey": "$feePayerKey",
      "key": "$senderKey",
      "on": "en1",
      "to": "0x00000000000000000000000000000000C0FFEE10",
      "value": "1",
      "reason": "insufficient feePayer's funds"
    },
    {
      "expect": "txStatus",
      "hash": "$fundHash",
      "is": "0x1"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "1"
    }
  ]
}
