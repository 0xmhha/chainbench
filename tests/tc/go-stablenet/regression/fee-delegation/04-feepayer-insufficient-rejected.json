{
  "schemaVersion": "2",
  "kind": "case",
  "id": "feepayer-insufficient-rejected",
  "description": "RT-D-05 — FeePayer 잔액 부족 시 거부 (원본 regression/fee-delegation/04-test-feepayer-insufficient)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "feepayer-insufficient-rejected-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "genesis": {
      "overlay": {
        "config": {
          "applepieBlock": 0
        }
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "sender",
      "saveKey": "senderKey"
    },
    {
      "do": "newAccount",
      "save": "feePayer",
      "saveKey": "feePayerKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundHash",
      "to": "$sender",
      "value": "10000000000000000000"
    },
    {
      "do": "sendTx",
      "expect": "reject",
      "feePayerKey": "$feePayerKey",
      "key": "$senderKey",
      "on": "en1",
      "to": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
      "value": "1"
    },
    {
      "expect": "txStatus",
      "hash": "$fundHash",
      "is": "0x1"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "1"
    }
  ]
}
