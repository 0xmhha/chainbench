{
  "schemaVersion": "2",
  "kind": "case",
  "id": "anzeon-basefee-increase",
  "requires": [
    "rpc"
  ],
  "chainPreset": "stablenet-bp4",
  "steps": [
    {
      "do": "waitBlock",
      "target": 2,
      "timeout": "60s"
    },
    {
      "do": "read",
      "source": "baseFee",
      "save": "bf0"
    },
    {
      "do": "load",
      "from": "node1",
      "fillPercent": 25,
      "blocks": 6,
      "timeout": "60s"
    },
    {
      "expect": "baseFee",
      "compare": "Greater",
      "is": "$bf0"
    }
  ]
}
