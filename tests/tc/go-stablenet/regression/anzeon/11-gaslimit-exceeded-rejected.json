{
  "schemaVersion": "2",
  "kind": "case",
  "id": "gaslimit-exceeded-rejected",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "method": "eth_blockNumber",
      "save": "n",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "eth_getBlockByNumber",
      "params": [
        "$n",
        false
      ],
      "save": "base",
      "select": "baseFeePerGas",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "$n"
      ],
      "save": "tip",
      "select": "gasTip",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "of": [
        "$base",
        "$tip"
      ],
      "op": "sum",
      "save": "feecap",
      "source": "derive"
    },
    {
      "do": "read",
      "method": "eth_getBlockByNumber",
      "params": [
        "$n",
        false
      ],
      "save": "gl",
      "select": "gasLimit",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "of": [
        "$gl",
        "1"
      ],
      "op": "sum",
      "save": "over",
      "source": "derive"
    },
    {
      "do": "sendTx",
      "expect": "reject",
      "from": "node1",
      "gas": "$over",
      "maxFeePerGas": "$feecap",
      "maxPriorityFeePerGas": "$tip",
      "to": "0x00000000000000000000000000000000C0FFEE0E",
      "value": "1",
      "reason": "exceeds block gas limit"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "0x1"
    }
  ]
}
