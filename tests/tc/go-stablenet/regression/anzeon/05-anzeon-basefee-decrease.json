{
  "schemaVersion": "2",
  "kind": "case",
  "id": "anzeon-basefee-decrease",
  "env": "anzeon-stablenet",
  "requires": ["rpc"],
  "steps": [
    { "do": "waitBlock", "target": 2, "timeout": "60s" },
    { "do": "load", "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8", "fillPercent": 25, "blocks": 6, "timeout": "60s" },
    { "do": "read", "source": "baseFee", "save": "peak" },
    { "do": "waitBlock", "target": 30, "timeout": "120s" },
    { "expect": "baseFee", "compare": "Less", "is": "$peak" }
  ]
}
