{
  "schemaVersion": "2",
  "kind": "case",
  "id": "basefee-minimum",
  "description": "RT-C-06 — baseFee가 MinBaseFee(20 Gwei) 아래로 내려가지 않음 (원본 regression/anzeon/06-test-min-basefee)",
  "requires": [
    "rpc",
    "engine:anzeon"
  ],
  "chainPreset": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "compare": "GreaterOrEqual",
      "expect": "baseFee",
      "is": "20000000000000"
    }
  ]
}
