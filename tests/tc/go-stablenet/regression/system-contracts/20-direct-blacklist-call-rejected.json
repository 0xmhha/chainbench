{
  "schemaVersion": "2",
  "kind": "case",
  "id": "direct-blacklist-call-rejected",
  "description": "RT-F-5-05 — 비멤버가 AccountManager.blacklist 직접 호출 → revert (원본 regression/system-contracts/20-test-direct-blacklist-rejected)",
  "requires": [
    "rpc",
    "contract:accountManager"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundHash",
      "to": "$acct",
      "value": "50000000000000000000"
    },
    {
      "data": "0xf9f92be400000000000000000000000000000000000000000000000000000000c0ffee40",
      "do": "sendTx",
      "expect": "revert",
      "key": "$acctKey",
      "on": "en1",
      "to": "accountManager"
    },
    {
      "expect": "txStatus",
      "hash": "$fundHash",
      "is": "0x1"
    }
  ]
}
