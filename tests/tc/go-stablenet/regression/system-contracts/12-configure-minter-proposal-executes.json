{
  "schemaVersion": "2",
  "kind": "case",
  "id": "configure-minter-proposal-executes",
  "description": "RT-F-4-01 — GovMasterMinter.proposeConfigureMinter(address, uint256) → 승인 → execute (원본 regression/system-contracts/12-test-add-minter)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "configure-minter-proposal-executes-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "data": "0x898420a900000000000000000000000000000000000000000000000000000000c0ffee070000000000000000000000000000000000000000000000008ac7230489e80000",
      "do": "sendTx",
      "from": "node1",
      "gas": "0x16e360",
      "on": "node1",
      "save": "propHash",
      "to": "0x0000000000000000000000000000000000001002"
    },
    {
      "do": "read",
      "hash": "$propHash",
      "save": "pid",
      "source": "receiptLog",
      "topic": 1,
      "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a"
    },
    {
      "do": "read",
      "of": [
        "$pid"
      ],
      "op": "abiCall",
      "save": "approveData",
      "selector": "0x98951b56",
      "source": "derive"
    },
    {
      "data": "$approveData",
      "do": "sendTx",
      "from": "node2",
      "gas": "0x16e360",
      "on": "node2",
      "save": "apHash",
      "to": "0x0000000000000000000000000000000000001002"
    },
    {
      "expect": "txStatus",
      "hash": "$propHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$apHash",
      "is": "0x1"
    },
    {
      "compare": "Equal",
      "data": "0x8a6db9c300000000000000000000000000000000000000000000000000000000c0ffee07",
      "expect": "call",
      "is": "0x0000000000000000000000000000000000000000000000008ac7230489e80000",
      "to": "0x0000000000000000000000000000000000001000"
    }
  ]
}
