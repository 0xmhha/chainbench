{
  "schemaVersion": "2",
  "kind": "case",
  "id": "non-member-configure-minter-rejected",
  "description": "RT-F-4-04 — 비멤버 계정의 GovMasterMinter.proposeConfigureMinter 호출 거부 (원본 regression/system-contracts/15-test-non-member-rejected)",
  "requires": [
    "rpc",
    "contract:govMasterMinter"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundHash",
      "to": "$acct",
      "value": "50000000000000000000"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$fundHash"
      ],
      "select": "status",
      "compare": "Equal",
      "expected": "0x1",
      "timeout": "60s",
      "pollInterval": "1s"
    },
    {
      "data": "0x898420a900000000000000000000000000000000000000000000000000000000c0ffee410000000000000000000000000000000000000000000000008ac7230489e80000",
      "do": "sendTx",
      "expect": "revert",
      "key": "$acctKey",
      "on": "en1",
      "to": "govMasterMinter"
    },
    {
      "expect": "txStatus",
      "hash": "$fundHash",
      "is": "0x1"
    }
  ]
}
