{
  "schemaVersion": "2",
  "kind": "case",
  "id": "gastip-governance-updates-header",
  "description": "RT-B-06 — GasTip 거버넌스 변경 → 블록 헤더 WBFTExtra.GasTip 반영 검증 + 원복 (원본 regression/wbft/06-test-gastip-header-sync)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "gastip-governance-updates-header-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "method": "eth_blockNumber",
      "save": "h0",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "$h0"
      ],
      "save": "orig",
      "select": "gasTip",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "of": [
        "25000000000000"
      ],
      "op": "abiCall",
      "save": "propData",
      "selector": "0xeeaf6816",
      "source": "derive"
    },
    {
      "data": "$propData",
      "do": "sendTx",
      "from": "node1",
      "gas": "0x16e360",
      "on": "node1",
      "save": "propHash",
      "to": "0x0000000000000000000000000000000000001001"
    },
    {
      "do": "read",
      "hash": "$propHash",
      "save": "pid",
      "source": "receiptLog",
      "topic": 1,
      "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a"
    },
    {
      "do": "read",
      "of": [
        "$pid"
      ],
      "op": "abiCall",
      "save": "approveData",
      "selector": "0x98951b56",
      "source": "derive"
    },
    {
      "data": "$approveData",
      "do": "sendTx",
      "from": "node2",
      "gas": "0x16e360",
      "on": "node2",
      "save": "apHash",
      "to": "0x0000000000000000000000000000000000001001"
    },
    {
      "compare": "Equal",
      "do": "waitFor",
      "expected": "25000000000000",
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "@latest"
      ],
      "pollInterval": "1s",
      "select": "gasTip",
      "source": "rpcCall",
      "timeout": "60s"
    },
    {
      "do": "read",
      "of": [
        "$orig"
      ],
      "op": "abiCall",
      "save": "restoreData",
      "selector": "0xeeaf6816",
      "source": "derive"
    },
    {
      "data": "$restoreData",
      "do": "sendTx",
      "from": "node1",
      "gas": "0x16e360",
      "on": "node1",
      "save": "restoreHash",
      "to": "0x0000000000000000000000000000000000001001"
    },
    {
      "do": "read",
      "hash": "$restoreHash",
      "save": "pid2",
      "source": "receiptLog",
      "topic": 1,
      "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a"
    },
    {
      "do": "read",
      "of": [
        "$pid2"
      ],
      "op": "abiCall",
      "save": "approveData2",
      "selector": "0x98951b56",
      "source": "derive"
    },
    {
      "data": "$approveData2",
      "do": "sendTx",
      "from": "node2",
      "gas": "0x16e360",
      "on": "node2",
      "save": "apHash2",
      "to": "0x0000000000000000000000000000000000001001"
    },
    {
      "compare": "Equal",
      "do": "waitFor",
      "expected": "$orig",
      "method": "istanbul_getWbftExtraInfo",
      "params": [
        "@latest"
      ],
      "pollInterval": "1s",
      "select": "gasTip",
      "source": "rpcCall",
      "timeout": "60s"
    },
    {
      "expect": "txStatus",
      "hash": "$propHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$apHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$restoreHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$apHash2",
      "is": "0x1"
    },
    {
      "address": "0x0000000000000000000000000000000000001001",
      "compare": "GreaterOrEqual",
      "expect": "logs",
      "fromBlock": "earliest",
      "is": "1",
      "select": "count",
      "toBlock": "latest",
      "topics": [
        "0x535d54b8a14e2287f10efd7add38eca14bcf44eb31651abf8eec2499eba393a3"
      ]
    }
  ]
}
