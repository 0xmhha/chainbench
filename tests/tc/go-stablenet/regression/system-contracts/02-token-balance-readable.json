{
  "schemaVersion": "1",
  "id": "token-balance-readable",
  "applicableChains": "stablenet",
  "chain": { "name": "stablenet", "binary": "gstable" },
  "requires": ["rpc"],
  "steps": [
    { "read": { "source": "call", "to": "0x0000000000000000000000000000000000001000",
                "data": "0x70a08231000000000000000000000000c17d493883eaa3b4cceb0f214b273392d562f9d8",
                "save": "bal" } }
  ],
  "assertions": [
    { "assert": "call", "to": "0x0000000000000000000000000000000000001000",
      "data": "0x18160ddd", "compare": "GreaterOrEqual", "expected": "$bal" }
  ]
}
