{
  "schemaVersion": "2",
  "kind": "case",
  "id": "token-balance-readable",
  "description": "RT-F-1-02 — NativeCoinAdapter.balanceOf == eth_getBalance (원본 regression/system-contracts/02-test-balance-of)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "token-balance-readable-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "data": "0x70a08231000000000000000000000000c17d493883eaa3b4cceb0f214b273392d562f9d8",
      "do": "read",
      "save": "bal",
      "source": "call",
      "to": "0x0000000000000000000000000000000000001000"
    },
    {
      "compare": "GreaterOrEqual",
      "data": "0x18160ddd",
      "expect": "call",
      "is": "$bal",
      "to": "0x0000000000000000000000000000000000001000"
    }
  ]
}
