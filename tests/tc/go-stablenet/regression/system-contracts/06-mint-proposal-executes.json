{
  "schemaVersion": "2",
  "kind": "case",
  "id": "mint-proposal-executes",
  "description": "RT-F-2-01 — 코인 발행: proposeMint(proofData) → 승인 → execute (원본 regression/system-contracts/06-test-mint-proposal)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "mint-proposal-executes-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "address": "0x00000000000000000000000000000000C0FFEE05",
      "do": "read",
      "save": "b0",
      "source": "balanceAt"
    },
    {
      "do": "read",
      "of": [
        "$b0",
        "1000000000000000000"
      ],
      "op": "sum",
      "save": "want",
      "source": "derive"
    },
    {
      "data": "",
      "do": "sendTx",
      "from": "node1",
      "gas": "0x16e360",
      "on": "node1",
      "save": "propHash",
      "to": "0x0000000000000000000000000000000000001003"
    },
    {
      "do": "read",
      "hash": "$propHash",
      "save": "pid",
      "source": "receiptLog",
      "topic": 1,
      "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a"
    },
    {
      "do": "read",
      "of": [
        "$pid"
      ],
      "op": "abiCall",
      "save": "approveData",
      "selector": "0x98951b56",
      "source": "derive"
    },
    {
      "data": "$approveData",
      "do": "sendTx",
      "from": "node2",
      "gas": "0x16e360",
      "on": "node2",
      "save": "apHash",
      "to": "0x0000000000000000000000000000000000001003"
    },
    {
      "expect": "txStatus",
      "hash": "$propHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$apHash",
      "is": "0x1"
    },
    {
      "address": "0x00000000000000000000000000000000C0FFEE05",
      "expect": "balanceAt",
      "is": "$want"
    }
  ]
}
