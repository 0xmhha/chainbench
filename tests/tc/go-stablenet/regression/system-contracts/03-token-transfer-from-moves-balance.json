{
  "schemaVersion": "2",
  "kind": "case",
  "id": "token-transfer-from-moves-balance",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "token-transfer-from-moves-balance-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "owner",
      "saveKey": "ownerKey"
    },
    {
      "do": "newAccount",
      "save": "spender",
      "saveKey": "spenderKey"
    },
    {
      "do": "newAccount",
      "save": "recipient",
      "saveKey": "recipientKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundOwnerHash",
      "to": "$owner",
      "value": "5000000000000000000"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundSpenderHash",
      "to": "$spender",
      "value": "10000000000000000000"
    },
    {
      "do": "read",
      "of": [
        "$spender",
        "1000000"
      ],
      "op": "abiCall",
      "save": "approveData",
      "selector": "0x095ea7b3",
      "source": "derive"
    },
    {
      "data": "$approveData",
      "do": "sendTx",
      "key": "$ownerKey",
      "on": "en1",
      "save": "approveHash",
      "to": "0x0000000000000000000000000000000000001000"
    },
    {
      "do": "read",
      "of": [
        "$owner",
        "$recipient",
        "1000000"
      ],
      "op": "abiCall",
      "save": "transferFromData",
      "selector": "0x23b872dd",
      "source": "derive"
    },
    {
      "data": "$transferFromData",
      "do": "sendTx",
      "key": "$spenderKey",
      "on": "en1",
      "save": "transferFromHash",
      "to": "0x0000000000000000000000000000000000001000"
    },
    {
      "do": "read",
      "of": [
        "$recipient"
      ],
      "op": "abiCall",
      "save": "balOfRecipient",
      "selector": "0x70a08231",
      "source": "derive"
    },
    {
      "expect": "txStatus",
      "hash": "$fundOwnerHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$fundSpenderHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$approveHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$transferFromHash",
      "is": "0x1"
    },
    {
      "compare": "Equal",
      "data": "$balOfRecipient",
      "expect": "call",
      "is": "0x00000000000000000000000000000000000000000000000000000000000f4240",
      "to": "0x0000000000000000000000000000000000001000"
    }
  ]
}
