{
  "schemaVersion": "2",
  "kind": "case",
  "id": "unsupported-system-contract-version",
  "description": "TC-5-2-06 — genesis 가 지원하지 않는 시스템 컨트랙트 버전을 선언하면 BohoBlock 을 커밋하지 못하고 멈춘다",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "unsupported-version-stablenet",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "genesis": {
      "overlay": {
        "config": {
          "bohoBlock": 6,
          "boho": {
            "systemContracts": {
              "govMinter": {
                "address": "0x0000000000000000000000000000000000001003",
                "version": "v99"
              }
            }
          }
        }
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 5,
      "timeout": "120s"
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "save": "stalledAt"
    },
    {
      "do": "readNodeLog",
      "on": "node1",
      "save": "node1Log"
    },
    {
      "expect": "blockStalled",
      "on": "node1",
      "timeout": "20s",
      "pollInterval": "2s"
    },
    {
      "expect": "rpc",
      "method": "eth_blockNumber",
      "params": [],
      "compare": "Equal",
      "is": "$stalledAt"
    },
    {
      "expect": "rpc",
      "method": "eth_getBlockByNumber",
      "params": [
        "0x6",
        false
      ],
      "compare": "Equal",
      "is": null
    }
  ]
}
