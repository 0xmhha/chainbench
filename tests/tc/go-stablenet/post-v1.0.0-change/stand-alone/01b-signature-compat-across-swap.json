{
  "schemaVersion": "2",
  "kind": "case",
  "id": "signature-compat-across-swap",
  "description": "TC-3-1-04 — 서로 다른 빌드로 두 EN을 데이터 유지 재시작한다. 원래 키로 직접 서명한 성공 거래의 해시·블록·송수신자·영수증을 양쪽 EN에서 보존하고, 교체 후 BP가 두 블록 이상 전진하며 두 EN이 이후 높이와 현재 BP의 ±2블록 이내까지 따라왔는지 확인한다. 두 EN의 버전 변경·eth_syncing=false·정확한 이전 블록 해시를 검증한다. 교체 전후 로그는 각각 완전한 1MiB 미만 캡처여야 하며, 이전 접두가 유지된 새 구간에 원문의 서명 오류 패턴이 없어야 한다. 로그 읽기 실패·잘림·접두 손실은 실패다. 원문은 15노드 중 EN8/11을 사용하며 이 fixture는 BP4/EN2다. 두 번째 빌드가 필요해 StableNet 전용이며 전체 legacy나 원문 전체 토폴로지 인수는 아니다.",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "skipsOn": [],
  "chainPreset": "stablenet-bp4-en2-default-upgrade",
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "do": "newAccount",
      "save": "sender",
      "saveKey": "senderKey"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "from": "faucet",
      "to": "$sender",
      "value": "3000000000000000000",
      "gas": "21000",
      "expect": "receipt",
      "timeout": "120s"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "to": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
      "value": "1",
      "save": "legacyTx",
      "expect": "receipt",
      "key": "$senderKey",
      "timeout": "120s"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "select": "blockNumber",
      "save": "blockBefore"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "select": "status",
      "save": "statusBefore"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "select": "from",
      "save": "fromBefore"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "select": "to",
      "save": "toBefore"
    },
    {
      "expect": "rpc",
      "on": "node1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "0x1",
      "select": "status"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_getBlockByNumber",
      "params": [
        "$blockBefore",
        false
      ],
      "save": "legacyBlockHash",
      "select": "hash"
    },
    {
      "expect": "rpc",
      "on": "node1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$blockBefore",
        false
      ],
      "compare": "Regexp",
      "is": "^0x[0-9a-fA-F]{64}$",
      "select": "hash"
    },
    {
      "expect": "rpc",
      "on": "node1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "$legacyBlockHash",
      "select": "blockHash"
    },
    {
      "expect": "rpc",
      "on": "node1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "$legacyTx",
      "select": "transactionHash"
    },
    {
      "expect": "rpc",
      "on": "node1",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "compare": "EqualCI",
      "is": "$sender",
      "select": "from"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "save": "headBefore"
    },
    {
      "do": "read",
      "source": "derive",
      "op": "sum",
      "of": [
        "$headBefore",
        "2"
      ],
      "save": "progressTarget"
    },
    {
      "do": "read",
      "on": "en1",
      "source": "rpcCall",
      "method": "web3_clientVersion",
      "params": [],
      "save": "en1VersionBefore"
    },
    {
      "do": "readNodeLog",
      "on": "en1",
      "maxBytes": 1048576,
      "requireComplete": true,
      "save": "en1LogBefore"
    },
    {
      "do": "read",
      "on": "en2",
      "source": "rpcCall",
      "method": "web3_clientVersion",
      "params": [],
      "save": "en2VersionBefore"
    },
    {
      "do": "readNodeLog",
      "on": "en2",
      "maxBytes": 1048576,
      "requireComplete": true,
      "save": "en2LogBefore"
    },
    {
      "do": "swapNode",
      "onEach": [
        "en1",
        "en2"
      ],
      "binary": "upgrade"
    },
    {
      "do": "waitBlock",
      "on": "node1",
      "target": "$progressTarget",
      "timeout": "180s"
    },
    {
      "expect": "blockNumber",
      "on": "node1",
      "compare": "Greater",
      "is": "$headBefore"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "save": "headAfter"
    },
    {
      "do": "waitFor",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "compare": "GreaterOrEqual",
      "expected": "$headAfter",
      "timeout": "180s",
      "pollInterval": "1s"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "web3_clientVersion",
      "params": [],
      "compare": "NotEqual",
      "is": "$en1VersionBefore"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_syncing",
      "params": [],
      "compare": "Equal",
      "is": false
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "$blockBefore",
      "select": "blockNumber"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "0x1",
      "select": "status"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "$legacyBlockHash",
      "select": "blockHash"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "$legacyTx",
      "select": "transactionHash"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "compare": "EqualCI",
      "is": "$sender",
      "select": "from"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "compare": "EqualCI",
      "is": "$toBefore",
      "select": "to"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "$legacyTx",
      "select": "hash"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "$legacyBlockHash",
      "select": "blockHash"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$blockBefore",
        false
      ],
      "compare": "Equal",
      "is": "$legacyBlockHash",
      "select": "hash"
    },
    {
      "expect": "rpc",
      "on": "en1",
      "method": "eth_getBlockByNumber",
      "params": [
        "$blockBefore",
        false
      ],
      "compare": "Equal",
      "is": "$blockBefore",
      "select": "number"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "save": "en1SourceHead"
    },
    {
      "do": "read",
      "on": "en1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "save": "en1CurrentHead"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$en1SourceHead",
        "$en1CurrentHead"
      ],
      "compare": "LessOrEqual",
      "is": "2"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$en1SourceHead",
        "$en1CurrentHead"
      ],
      "compare": "GreaterOrEqual",
      "is": "-2"
    },
    {
      "do": "readNodeLog",
      "on": "en1",
      "maxBytes": 1048576,
      "requireComplete": true,
      "save": "en1LogAfter"
    },
    {
      "expect": "derive",
      "op": "regexpCount",
      "of": [
        "$en1LogAfter"
      ],
      "since": "$en1LogBefore",
      "pattern": "(?i)ecrecover failed|invalid[^[:cntrl:]]*sig|verify[^[:cntrl:]]*error|signature[^[:cntrl:]]*(error|fail|invalid)|secp256k1[^[:cntrl:]]*(error|fail|invalid)",
      "compare": "Equal",
      "is": "0"
    },
    {
      "do": "waitFor",
      "on": "en2",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "compare": "GreaterOrEqual",
      "expected": "$headAfter",
      "timeout": "180s",
      "pollInterval": "1s"
    },
    {
      "expect": "rpc",
      "on": "en2",
      "method": "web3_clientVersion",
      "params": [],
      "compare": "NotEqual",
      "is": "$en2VersionBefore"
    },
    {
      "expect": "rpc",
      "on": "en2",
      "method": "eth_syncing",
      "params": [],
      "compare": "Equal",
      "is": false
    },
    {
      "expect": "rpc",
      "on": "en2",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "$blockBefore",
      "select": "blockNumber"
    },
    {
      "expect": "rpc",
      "on": "en2",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "0x1",
      "select": "status"
    },
    {
      "expect": "rpc",
      "on": "en2",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "$legacyBlockHash",
      "select": "blockHash"
    },
    {
      "expect": "rpc",
      "on": "en2",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "$legacyTx",
      "select": "transactionHash"
    },
    {
      "expect": "rpc",
      "on": "en2",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "compare": "EqualCI",
      "is": "$sender",
      "select": "from"
    },
    {
      "expect": "rpc",
      "on": "en2",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "compare": "EqualCI",
      "is": "$toBefore",
      "select": "to"
    },
    {
      "expect": "rpc",
      "on": "en2",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "$legacyTx",
      "select": "hash"
    },
    {
      "expect": "rpc",
      "on": "en2",
      "method": "eth_getTransactionByHash",
      "params": [
        "$legacyTx"
      ],
      "compare": "Equal",
      "is": "$legacyBlockHash",
      "select": "blockHash"
    },
    {
      "expect": "rpc",
      "on": "en2",
      "method": "eth_getBlockByNumber",
      "params": [
        "$blockBefore",
        false
      ],
      "compare": "Equal",
      "is": "$legacyBlockHash",
      "select": "hash"
    },
    {
      "expect": "rpc",
      "on": "en2",
      "method": "eth_getBlockByNumber",
      "params": [
        "$blockBefore",
        false
      ],
      "compare": "Equal",
      "is": "$blockBefore",
      "select": "number"
    },
    {
      "do": "read",
      "on": "node1",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "save": "en2SourceHead"
    },
    {
      "do": "read",
      "on": "en2",
      "source": "rpcCall",
      "method": "eth_blockNumber",
      "params": [],
      "save": "en2CurrentHead"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$en2SourceHead",
        "$en2CurrentHead"
      ],
      "compare": "LessOrEqual",
      "is": "2"
    },
    {
      "expect": "derive",
      "op": "diff",
      "of": [
        "$en2SourceHead",
        "$en2CurrentHead"
      ],
      "compare": "GreaterOrEqual",
      "is": "-2"
    },
    {
      "do": "readNodeLog",
      "on": "en2",
      "maxBytes": 1048576,
      "requireComplete": true,
      "save": "en2LogAfter"
    },
    {
      "expect": "derive",
      "op": "regexpCount",
      "of": [
        "$en2LogAfter"
      ],
      "since": "$en2LogBefore",
      "pattern": "(?i)ecrecover failed|invalid[^[:cntrl:]]*sig|verify[^[:cntrl:]]*error|signature[^[:cntrl:]]*(error|fail|invalid)|secp256k1[^[:cntrl:]]*(error|fail|invalid)",
      "compare": "Equal",
      "is": "0"
    }
  ]
}
