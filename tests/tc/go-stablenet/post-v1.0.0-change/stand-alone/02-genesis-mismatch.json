{
  "schemaVersion": "2",
  "kind": "case",
  "id": "genesis-mismatch-refuses-to-start",
  "env": "genesis-mismatch-stablenet",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "swapNode",
      "on": "node4",
      "binary": "mismatch",
      "purpose": "genesis-mismatch",
      "expect": "fail",
      "reason": "genesis",
      "save": "mismatchEvidence"
    },
    {
      "do": "readNodeLog",
      "on": "node4",
      "save": "node4Log"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "60s",
      "pollInterval": "2s"
    }
  ]
}
