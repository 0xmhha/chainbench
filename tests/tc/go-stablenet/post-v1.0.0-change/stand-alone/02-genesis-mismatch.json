{
  "schemaVersion": "2",
  "kind": "case",
  "id": "genesis-mismatch-refuses-to-start",
  "description": "TC-4-1-03 — 이 체인과 다른 genesis 로 빌드된 바이너리는 GenesisMismatch 로 기동에 실패한다",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "genesis-mismatch-stablenet",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable",
      "mismatch": "${GSTABLE_MISMATCH_BIN:-gstable-genesis-mismatch}"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "swapNode",
      "on": "node4",
      "binary": "mismatch",
      "purpose": "genesis-mismatch",
      "expect": "fail",
      "reason": "genesis",
      "save": "mismatchEvidence"
    },
    {
      "do": "readNodeLog",
      "on": "node4",
      "save": "node4Log"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "60s",
      "pollInterval": "2s"
    }
  ]
}
