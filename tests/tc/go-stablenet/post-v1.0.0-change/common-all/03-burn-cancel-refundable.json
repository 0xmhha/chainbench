{
  "schemaVersion": "2",
  "kind": "case",
  "id": "burn-cancel-refundable",
  "description": "TC-1-1-01, TC-1-1-10 — 소각 제안 취소 → refundableBalance 이동 및 BurnDepositRefunded 이벤트 검증 (원본 post-v1.0.0-change/common-all/03-test-burn-cancel-refund)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "burn-cancel-refundable-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "read",
      "of": [
        "0x2493a84a8f83cb87fdcbe0bb3b2d313f69a58d3c"
      ],
      "op": "abiCall",
      "save": "refBalCall",
      "selector": "0xb03d36cd",
      "source": "derive"
    },
    {
      "data": "$refBalCall",
      "do": "read",
      "save": "refBefore",
      "source": "call",
      "to": "0x0000000000000000000000000000000000001003"
    },
    {
      "data": "",
      "do": "sendTx",
      "from": "node2",
      "gas": "0xb71b0",
      "on": "node2",
      "save": "burnHash",
      "to": "0x0000000000000000000000000000000000001003",
      "value": "0xde0b6b3a7640000"
    },
    {
      "do": "read",
      "hash": "$burnHash",
      "save": "cancelPid",
      "source": "receiptLog",
      "topic": 1,
      "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a"
    },
    {
      "do": "read",
      "of": [
        "$cancelPid"
      ],
      "op": "abiCall",
      "save": "cancelData",
      "selector": "0xe0a8f6f5",
      "source": "derive"
    },
    {
      "data": "$cancelData",
      "do": "sendTx",
      "from": "node2",
      "gas": "0xb71b0",
      "on": "node2",
      "save": "cancelHash",
      "to": "0x0000000000000000000000000000000000001003"
    },
    {
      "data": "$refBalCall",
      "do": "read",
      "save": "refAfter",
      "source": "call",
      "to": "0x0000000000000000000000000000000000001003"
    },
    {
      "expect": "txStatus",
      "hash": "$burnHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$cancelHash",
      "is": "0x1"
    },
    {
      "compare": "Equal",
      "expect": "derive",
      "is": "1000000000000000000",
      "of": [
        "$refAfter",
        "$refBefore"
      ],
      "op": "diff"
    }
  ]
}
