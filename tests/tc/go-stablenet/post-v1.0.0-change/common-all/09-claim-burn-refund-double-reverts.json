{
  "schemaVersion": "2",
  "kind": "case",
  "id": "claim-burn-refund-double-reverts",
  "description": "TC-1-1-07 — claimBurnRefund 중복 호출 revert 검증 (원본 post-v1.0.0-change/common-all/09-test-claim-refund-double-revert)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "claim-burn-refund-double-reverts-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "data": "",
      "do": "sendTx",
      "from": "node2",
      "gas": "0xb71b0",
      "on": "node2",
      "save": "burnHash",
      "to": "0x0000000000000000000000000000000000001003",
      "value": "0xde0b6b3a7640000"
    },
    {
      "do": "read",
      "hash": "$burnHash",
      "save": "burnPid",
      "source": "receiptLog",
      "topic": 1,
      "topic0": "0x830652010a654c24b39890c16f53e6f6179becc61702ecd9a8c88461c2ff941a"
    },
    {
      "do": "read",
      "of": [
        "$burnPid"
      ],
      "op": "abiCall",
      "save": "cancelData",
      "selector": "0xe0a8f6f5",
      "source": "derive"
    },
    {
      "data": "$cancelData",
      "do": "sendTx",
      "from": "node2",
      "gas": "0xb71b0",
      "on": "node2",
      "save": "cancelHash",
      "to": "0x0000000000000000000000000000000000001003"
    },
    {
      "data": "0x936834b9",
      "do": "sendTx",
      "from": "node2",
      "gas": "0xb71b0",
      "on": "node2",
      "save": "claim1Hash",
      "to": "0x0000000000000000000000000000000000001003"
    },
    {
      "data": "0x936834b9",
      "do": "sendTx",
      "expect": "revert",
      "from": "node2",
      "gas": "0xb71b0",
      "on": "node2",
      "save": "claim2Hash",
      "to": "0x0000000000000000000000000000000000001003"
    },
    {
      "expect": "txStatus",
      "hash": "$burnHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$cancelHash",
      "is": "0x1"
    },
    {
      "expect": "txStatus",
      "hash": "$claim1Hash",
      "is": "0x1"
    }
  ]
}
