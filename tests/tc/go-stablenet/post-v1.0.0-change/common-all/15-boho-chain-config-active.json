{
  "schemaVersion": "2",
  "kind": "case",
  "id": "boho-chain-config-active",
  "description": "TC-4-1-01 — Boho hardfork chain config verification (원본 post-v1.0.0-change/common-all/15-test-chain-config-boho)",
  "requires": [
    "rpc",
    "fork:boho"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "compare": "Greater",
      "expect": "blockNumber",
      "is": "0"
    },
    {
      "compare": "Greater",
      "expect": "chainId",
      "is": "0"
    },
    {
      "compare": "Greater",
      "expect": "baseFee",
      "is": "0"
    }
  ]
}
