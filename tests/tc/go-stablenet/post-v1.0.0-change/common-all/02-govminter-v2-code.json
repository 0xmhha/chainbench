{
  "schemaVersion": "2",
  "kind": "case",
  "id": "govminter-v2-code",
  "description": "TC-5-2-05: Boho 10 직전 블록 9와 경계 블록 10의 GovMinter 코드가 원문 v1/v2 고정 Keccak 해시와 같고 잔액을 보존하는지 확인한다. 두 과거 블록을 고정해 latest 조회 경합을 피한다.",
  "requires": [
    "rpc",
    "contract:govMinter",
    "fork:boho"
  ],
  "chainPreset": {
    "extends": "stablenet-bp4-boho-at-10",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "compare": "GreaterOrEqual",
      "do": "waitFor",
      "expected": "11",
      "pollInterval": "2s",
      "source": "blockNumber",
      "timeout": "120s"
    },
    {
      "do": "read",
      "method": "eth_getBalance",
      "params": [
        "0x0000000000000000000000000000000000001003",
        "0x9"
      ],
      "save": "balPreBoho",
      "source": "rpcCall"
    },
    {
      "do": "read",
      "method": "eth_getCode",
      "params": [
        "0x0000000000000000000000000000000000001003",
        "0x9"
      ],
      "save": "codePreBoho",
      "source": "rpcCall"
    },
    {
      "address": "govMinter",
      "compare": "NotEqual",
      "expect": "codeAt",
      "is": "0x"
    },
    {
      "compare": "NotEqual",
      "expect": "rpcCall",
      "is": "$codePreBoho",
      "method": "eth_getCode",
      "params": [
        "0x0000000000000000000000000000000000001003",
        "0xa"
      ]
    },
    {
      "compare": "Equal",
      "expect": "rpcCall",
      "is": "$balPreBoho",
      "method": "eth_getBalance",
      "params": [
        "0x0000000000000000000000000000000000001003",
        "0xa"
      ]
    },
    {
      "do": "read",
      "source": "rpcCall",
      "method": "eth_getCode",
      "params": [
        "0x0000000000000000000000000000000000001003",
        "0xa"
      ],
      "save": "codePostBoho"
    },
    {
      "expect": "rpcCall",
      "method": "web3_sha3",
      "params": [
        "$codePreBoho"
      ],
      "compare": "Equal",
      "is": "0x3ea99dd77ff9bbc4a88b126e9aa06ddbf144f535a5b432040dbedadd66f3c759"
    },
    {
      "expect": "rpcCall",
      "method": "web3_sha3",
      "params": [
        "$codePostBoho"
      ],
      "compare": "Equal",
      "is": "0xf369fcc4edab330169f427fd2aedbe97432cf1cfa31200da06464034f3edaa05"
    }
  ]
}
