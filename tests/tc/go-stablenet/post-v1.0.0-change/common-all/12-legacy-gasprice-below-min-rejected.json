{
  "schemaVersion": "2",
  "kind": "case",
  "id": "legacy-gasprice-below-min-rejected",
  "description": "TC-1-3-04 — LegacyTx gasPrice 최소 가스비 하한선 미만 거부 검증 (원본 post-v1.0.0-change/common-all/12-test-legacy-gasprice-below-min-revert)",
  "requires": [
    "rpc",
    "engine:anzeon"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "sendTx",
      "expect": "reject",
      "from": "node1",
      "gas": "21000",
      "gasPrice": "1",
      "to": "0x00000000000000000000000000000000C0FFEE0E",
      "value": "1",
      "reason": "transaction underpriced"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "0x1"
    }
  ]
}
