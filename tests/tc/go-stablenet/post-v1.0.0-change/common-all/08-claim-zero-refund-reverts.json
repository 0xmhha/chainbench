{
  "schemaVersion": "2",
  "kind": "case",
  "id": "claim-zero-refund-reverts",
  "description": "TC-1-1-06 — refundableBalance 0 계정 claimBurnRefund revert 검증 (원본 post-v1.0.0-change/common-all/08-test-claim-refund-zero-revert)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "claim-zero-refund-reverts-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "sendTx",
      "from": "node1",
      "gas": "21000",
      "on": "node1",
      "save": "fundHash",
      "to": "$acct",
      "value": "100000000000000000000"
    },
    {
      "data": "0x936834b9",
      "do": "sendTx",
      "expect": "revert",
      "gas": "0xb71b0",
      "key": "$acctKey",
      "on": "en1",
      "save": "claimHash",
      "to": "0x0000000000000000000000000000000000001003"
    },
    {
      "expect": "txStatus",
      "hash": "$fundHash",
      "is": "0x1"
    }
  ]
}
