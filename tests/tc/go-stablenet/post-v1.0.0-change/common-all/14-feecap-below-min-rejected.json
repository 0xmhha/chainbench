{
  "schemaVersion": "2",
  "kind": "case",
  "id": "feecap-below-min-rejected",
  "description": "TC-1-3-06 — DynamicFeeTx gasTipCap 최소값 미만 거부 검증 (원본 post-v1.0.0-change/common-all/14-test-dynamic-fee-tipcap-below-min-revert)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "extends": "stablenet-bp4",
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "do": "sendTx",
      "expect": "reject",
      "from": "node1",
      "gas": "21000",
      "maxFeePerGas": "1",
      "maxPriorityFeePerGas": "1",
      "to": "0x00000000000000000000000000000000C0FFEE0E",
      "value": "1",
      "reason": "transaction underpriced"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "0x1"
    }
  ]
}
