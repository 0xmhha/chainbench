{
  "schemaVersion": "2",
  "kind": "case",
  "id": "accesslist-gasprice-below-min-rejected",
  "description": "TC-1-3-05 — AccessListTx gasPrice 최소 가스비 하한선 미만 거부 검증 (원본 post-v1.0.0-change/common-all/13-test-accesslist-gasprice-below-min-revert)",
  "applicableChains": "stablenet",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "accesslist-gasprice-below-min-rejected-env",
    "chain": "stablenet",
    "binaries": {
      "default": "go-stablenet"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "accessList": [],
      "do": "sendTx",
      "expect": "reject",
      "from": "node1",
      "gas": "21000",
      "gasPrice": "1",
      "to": "0x00000000000000000000000000000000C0FFEE0E",
      "value": "1"
    },
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "0x1"
    }
  ]
}
