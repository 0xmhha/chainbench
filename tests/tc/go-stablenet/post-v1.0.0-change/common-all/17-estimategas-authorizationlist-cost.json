{
  "schemaVersion": "1",
  "id": "estimategas-authorizationlist-cost",
  "applicableChains": "stablenet",
  "chain": {
    "name": "stablenet",
    "binary": "gstable"
  },
  "requires": [
    "rpc"
  ],
  "description": "TC-4-2-01/03: EIP-7702 authorizationList 를 1건·2건 붙였을 때 eth_estimateGas 가 그만큼 늘어난다. 경계값은 preActions 에서 이름을 붙여 한 번씩만 적는다. 상한은 노드의 estimateGas 오차 1.5% 정책에서 나온다 — 절대 상한은 하한 x 1.015, 증가분 상한은 절대 상한에서 baseline(21000)을 뺀 값이다.",
  "preActions": [
    {
      "read": {
        "source": "derive",
        "op": "sum",
        "of": [
          "21000"
        ],
        "save": "gasBaselineExpected"
      }
    },
    {
      "read": {
        "source": "derive",
        "op": "sum",
        "of": [
          "46000"
        ],
        "save": "gas1AuthMin"
      }
    },
    {
      "read": {
        "source": "derive",
        "op": "sum",
        "of": [
          "46690"
        ],
        "save": "gas1AuthMax"
      }
    },
    {
      "read": {
        "source": "derive",
        "op": "sum",
        "of": [
          "71000"
        ],
        "save": "gas2AuthMin"
      }
    },
    {
      "read": {
        "source": "derive",
        "op": "sum",
        "of": [
          "72065"
        ],
        "save": "gas2AuthMax"
      }
    },
    {
      "read": {
        "source": "derive",
        "op": "sum",
        "of": [
          "25000"
        ],
        "save": "authCost1Min"
      }
    },
    {
      "read": {
        "source": "derive",
        "op": "sum",
        "of": [
          "25690"
        ],
        "save": "authCost1Max"
      }
    },
    {
      "read": {
        "source": "derive",
        "op": "sum",
        "of": [
          "50000"
        ],
        "save": "authCost2Min"
      }
    },
    {
      "read": {
        "source": "derive",
        "op": "sum",
        "of": [
          "51065"
        ],
        "save": "authCost2Max"
      }
    }
  ],
  "steps": [
    {
      "newAccount": {
        "save": "delegate",
        "saveKey": "delegateKey"
      }
    },
    {
      "newAccount": {
        "save": "authority1",
        "saveKey": "authority1Key"
      }
    },
    {
      "newAccount": {
        "save": "authority2",
        "saveKey": "authority2Key"
      }
    },
    {
      "read": {
        "source": "rpcCall",
        "method": "eth_coinbase",
        "params": [],
        "save": "sponsor"
      }
    },
    {
      "signAuthorization": {
        "authorityKey": "$authority1Key",
        "delegate": "$delegate",
        "save": "auth1"
      }
    },
    {
      "signAuthorization": {
        "authorityKey": "$authority2Key",
        "delegate": "$delegate",
        "save": "auth2"
      }
    },
    {
      "read": {
        "source": "rpcCall",
        "method": "eth_estimateGas",
        "params": [
          {
            "from": "$sponsor",
            "to": "$sponsor"
          }
        ],
        "save": "gasBaseline"
      }
    },
    {
      "read": {
        "source": "rpcCall",
        "method": "eth_estimateGas",
        "params": [
          {
            "from": "$sponsor",
            "to": "$sponsor",
            "authorizationList": [
              "$auth1"
            ]
          }
        ],
        "save": "gas1Auth"
      }
    },
    {
      "read": {
        "source": "rpcCall",
        "method": "eth_estimateGas",
        "params": [
          {
            "from": "$sponsor",
            "to": "$sponsor",
            "authorizationList": [
              "$auth1",
              "$auth2"
            ]
          }
        ],
        "save": "gas2Auth"
      }
    }
  ],
  "assertions": [
    {
      "assert": "derive",
      "op": "sum",
      "of": [
        "$gasBaseline"
      ],
      "compare": "Equal",
      "expected": "$gasBaselineExpected"
    },
    {
      "assert": "derive",
      "op": "sum",
      "of": [
        "$gas1Auth"
      ],
      "compare": "GreaterOrEqual",
      "expected": "$gas1AuthMin"
    },
    {
      "assert": "derive",
      "op": "sum",
      "of": [
        "$gas1Auth"
      ],
      "compare": "LessOrEqual",
      "expected": "$gas1AuthMax"
    },
    {
      "assert": "derive",
      "op": "sum",
      "of": [
        "$gas2Auth"
      ],
      "compare": "GreaterOrEqual",
      "expected": "$gas2AuthMin"
    },
    {
      "assert": "derive",
      "op": "sum",
      "of": [
        "$gas2Auth"
      ],
      "compare": "LessOrEqual",
      "expected": "$gas2AuthMax"
    },
    {
      "assert": "derive",
      "op": "diff",
      "of": [
        "$gas1Auth",
        "$gasBaseline"
      ],
      "compare": "GreaterOrEqual",
      "expected": "$authCost1Min"
    },
    {
      "assert": "derive",
      "op": "diff",
      "of": [
        "$gas1Auth",
        "$gasBaseline"
      ],
      "compare": "LessOrEqual",
      "expected": "$authCost1Max"
    },
    {
      "assert": "derive",
      "op": "diff",
      "of": [
        "$gas2Auth",
        "$gasBaseline"
      ],
      "compare": "GreaterOrEqual",
      "expected": "$authCost2Min"
    },
    {
      "assert": "derive",
      "op": "diff",
      "of": [
        "$gas2Auth",
        "$gasBaseline"
      ],
      "compare": "LessOrEqual",
      "expected": "$authCost2Max"
    }
  ]
}
