{
  "schemaVersion": "2",
  "kind": "case",
  "id": "sample-case-node-restart",
  "env": "sample",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "from": "dev1",
      "to": "$acct",
      "value": "1000000000000000000",
      "gas": "21000",
      "expect": "receipt"
    },
    {
      "expect": "balanceAt",
      "on": "node1",
      "address": "$acct",
      "compare": "Greater",
      "is": "0"
    },
    {
      "do": "stopNode",
      "on": "en1"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "60s",
      "pollInterval": "2s"
    },
    {
      "do": "startNode",
      "on": "en1"
    },
    {
      "do": "waitBlock",
      "on": "en1",
      "target": 8,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "readNodeLog",
      "on": "en1",
      "maxBytes": 4096,
      "save": "en1Log"
    }
  ]
}
