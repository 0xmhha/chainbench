{
  "schemaVersion": "2",
  "kind": "case",
  "id": "sample-lifecycle-node-restart",
  "description": "작성 샘플 — 노드를 멈췄다 살리고 체인이 이어지는지 확인한다 (docs/guide/dsl-authoring.md)",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "sample",
    "chain": "stablenet",
    "binaries": {
      "default": "${GSTABLE_BIN:-gstable}"
    },
    "topology": {
      "bp": 4,
      "en": 1
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "genesis": {
      "overlay": {
        "config": {
          "bohoBlock": 6
        }
      }
    },
    "accounts": {
      "dev1": {
        "fund": "0x8AC7230489E80000"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "newAccount",
      "save": "acct",
      "saveKey": "acctKey"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "from": "dev1",
      "to": "$acct",
      "value": "1000000000000000000",
      "gas": "21000",
      "expect": "receipt"
    },
    {
      "expect": "balanceAt",
      "on": "node1",
      "address": "$acct",
      "compare": "Greater",
      "is": "0"
    },
    {
      "do": "stopNode",
      "on": "en1"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "60s",
      "pollInterval": "2s"
    },
    {
      "do": "startNode",
      "on": "en1"
    },
    {
      "do": "waitBlock",
      "on": "en1",
      "target": 8,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "readNodeLog",
      "on": "en1",
      "maxBytes": 4096,
      "save": "en1Log"
    }
  ]
}
