{
  "schemaVersion": "2",
  "kind": "case",
  "id": "sample-spec-value-transfer",
  "description": "v1 스펙 샘플. 이미 떠 있는 체인에 붙어 실행한다. steps 로 값을 모으고 assertions 로 판정한다. chainbench validate tests/tc/samples/01-sample-spec.json",
  "applicableChains": "stablenet,wbft",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "sample-spec-value-transfer-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "hooks": {
    "pre": [
      {
        "do": "read",
        "of": [
          "21000"
        ],
        "op": "sum",
        "save": "transferGas",
        "source": "derive"
      }
    ]
  },
  "steps": [
    {
      "address": "node2",
      "do": "read",
      "save": "balBefore",
      "source": "balanceAt"
    },
    {
      "do": "sendTx",
      "expect": "receipt",
      "from": "node1",
      "gas": "$transferGas",
      "on": "node1",
      "save": "txHash",
      "to": "node2",
      "value": "1000000000000000000"
    },
    {
      "do": "read",
      "method": "eth_getTransactionReceipt",
      "params": [
        "$txHash"
      ],
      "save": "txBlock",
      "select": "blockNumber",
      "source": "rpcCall"
    },
    {
      "expect": "txStatus",
      "hash": "$txHash",
      "is": "0x1"
    },
    {
      "compare": "Greater",
      "expect": "derive",
      "is": "0",
      "of": [
        "$txBlock",
        "0"
      ],
      "op": "diff"
    },
    {
      "address": "node2",
      "compare": "Greater",
      "expect": "balanceAt",
      "is": "$balBefore"
    }
  ]
}
