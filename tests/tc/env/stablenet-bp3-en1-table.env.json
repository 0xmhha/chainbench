{
  "schemaVersion": "2",
  "kind": "env",
  "id": "stablenet-bp3-en1-table",
  "description": "stablenet: 3 bp + 1 en, declared per node. Used by 1 case.",
  "chain": "stablenet",
  "keys": {
    "nodekeys": {
      "ref": "keys/preset",
      "source": "keyPreset"
    }
  },
  "topology": {
    "nodes": [
      {
        "index": 1,
        "role": "en"
      },
      {
        "index": 2,
        "role": "bp"
      },
      {
        "index": 3,
        "role": "bp"
      },
      {
        "index": 4,
        "role": "bp"
      }
    ]
  }
}
