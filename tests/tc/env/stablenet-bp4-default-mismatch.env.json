{
  "schemaVersion": "2",
  "kind": "env",
  "id": "stablenet-bp4-default-mismatch",
  "description": "stablenet: 4 bp. Binaries: default = gstable, mismatch = ${GSTABLE_MISMATCH_BIN:-gstable-genesis-mismatch}. Used by 1 case.",
  "binaries": {
    "default": "gstable",
    "mismatch": "${GSTABLE_MISMATCH_BIN:-gstable-genesis-mismatch}"
  },
  "chain": "stablenet",
  "keys": {
    "nodekeys": {
      "ref": "keys/preset",
      "source": "keyPreset"
    }
  },
  "topology": {
    "bp": 4
  }
}
