{
  "schemaVersion": "2",
  "kind": "env",
  "id": "wemix-brioche",
  "chain": "wemix",
  "binaries": { "default": "${GWEMIX_BIN:-gwemix}" },
  "topology": { "bp": 4 },
  "keys": { "nodekeys": { "source": "preset", "ref": "keys/preset" } },
  "genesis": {
    "overlay": {
      "config": {
        "brioche": {
          "firstHalvingBlock": 10,
          "halvingPeriod": 10,
          "finishRewardBlock": 1000,
          "halvingTimes": 4,
          "halvingRate": 50
        }
      }
    }
  }
}
