{
  "schemaVersion": "2",
  "kind": "env",
  "id": "wemix-bp4-binvar",
  "description": "wemix: 4 bp. Binaries: default = ${GWEMIX_BIN:-gwemix}. Used by 3 cases.",
  "binaries": {
    "default": "${GWEMIX_BIN:-gwemix}"
  },
  "chain": "wemix",
  "keys": {
    "nodekeys": {
      "ref": "keys/preset",
      "source": "keyPreset"
    }
  },
  "topology": {
    "bp": 4
  }
}
