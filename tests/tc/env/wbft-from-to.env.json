{
  "schemaVersion": "2",
  "kind": "env",
  "id": "wbft-from-to",
  "description": "wbft: default size. Binaries: from = ${GWEMIX_BIN:-gwemix}, to = ${GWBFT_BIN:-gwbft}. Used by 1 case.",
  "binaries": {
    "from": "${GWEMIX_BIN:-gwemix}",
    "to": "${GWBFT_BIN:-gwbft}"
  },
  "chain": "wbft",
  "keys": {
    "nodekeys": {
      "ref": "keys/preset",
      "source": "keyPreset"
    }
  }
}
