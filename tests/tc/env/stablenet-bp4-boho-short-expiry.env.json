{
  "schemaVersion": "2",
  "kind": "env",
  "id": "stablenet-bp4-boho-short-expiry",
  "description": "stablenet: 4 bp, Boho·Applepie 가 처음부터 켜져 있고 거버넌스 제안이 30초 만에 만료된다. 소각 환불은 GovMinter v2 의 refundableBalance 를 읽으므로 boho 가 필요하고, 만료를 지켜보려면 짧은 expiry 가 필요하다. 둘 다 genesis 가 만드는 사실이라 genesis 가 두 capability 를 함께 선언한다. 1건이 쓴다.",
  "chain": "stablenet",
  "keys": {
    "nodekeys": {
      "ref": "keys/preset",
      "source": "keyPreset"
    }
  },
  "topology": {
    "bp": 4
  },
  "hardforks": {
    "applepie": 0,
    "boho": 0
  },
  "genesis": {
    "provides": ["short-expiry"],
    "overlay": {
      "config": {
        "boho": {
          "systemContracts": {
            "govMinter": {
              "address": "0x0000000000000000000000000000000000001003",
              "version": "v2"
            }
          }
        }
      }
    },
    "set": {
      "config.anzeon.systemContracts.govValidator.params.expiry": "30",
      "config.anzeon.systemContracts.govMinter.params.expiry": "30",
      "config.anzeon.systemContracts.govCouncil.params.expiry": "30",
      "config.anzeon.systemContracts.govMasterMinter.params.expiry": "30"
    }
  }
}
