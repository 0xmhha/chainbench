{
  "schemaVersion": "2",
  "kind": "env",
  "id": "stablenet-bp4-en1-default-upgrade",
  "description": "stablenet: 4 bp + 1 en. Binaries: default = gstable, upgrade = ${GSTABLE_UPGRADE_BIN:-gstable}. Used by 1 case.",
  "binaries": {
    "default": "gstable",
    "upgrade": "${GSTABLE_UPGRADE_BIN:-gstable}"
  },
  "chain": "stablenet",
  "keys": {
    "nodekeys": {
      "ref": "presets/keys",
      "source": "keyPreset"
    }
  },
  "topology": {
    "bp": 4,
    "en": 1
  }
}
