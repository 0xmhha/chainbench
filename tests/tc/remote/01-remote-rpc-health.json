{
  "schemaVersion": "1",
  "id": "remote-rpc-health",
  "applicableChains": "stablenet,wbft",
  "chain": {
    "name": "stablenet",
    "binary": "gstable"
  },
  "requires": [
    "rpc"
  ],
  "description": "레거시 remote/rpc-health: 붙은 엔드포인트가 살아 있고 기본 RPC 셋이 응답한다. chainbench run --rpc <endpoint> 로 실행한다.",
  "assertions": [
    {
      "assert": "blockNumber",
      "compare": "GreaterOrEqual",
      "expected": "0x0"
    },
    {
      "assert": "rpcCall",
      "method": "web3_clientVersion",
      "compare": "NotEqual",
      "expected": ""
    },
    {
      "assert": "rpcCall",
      "method": "net_peerCount",
      "compare": "NotEqual",
      "expected": ""
    }
  ]
}
