{
  "schemaVersion": "2",
  "kind": "case",
  "id": "remote-rpc-health",
  "description": "레거시 remote/rpc-health: 붙은 엔드포인트가 살아 있고 기본 RPC 셋이 응답한다. chainbench run --rpc <endpoint> 로 실행한다.",
  "applicableChains": "stablenet,wbft",
  "requires": [
    "rpc"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "remote-rpc-health-env",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    },
    "capabilities": [
      "rpc"
    ]
  },
  "steps": [
    {
      "compare": "GreaterOrEqual",
      "expect": "blockNumber",
      "is": "0x0"
    },
    {
      "compare": "NotEqual",
      "expect": "rpcCall",
      "is": "",
      "method": "web3_clientVersion"
    },
    {
      "compare": "NotEqual",
      "expect": "rpcCall",
      "is": "",
      "method": "net_peerCount"
    }
  ]
}
