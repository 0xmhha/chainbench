{
  "schemaVersion": "2",
  "kind": "case",
  "id": "fault-network-partition",
  "env": "fault-stablenet",
  "requires": ["rpc", "consensus", "process"],
  "steps": [
    { "do": "waitBlock", "target": 3, "timeout": "120s" },
    { "expect": "sameBlockHash", "block": "latest" },
    { "do": "partition", "groups": [["node1", "node2"], ["node3", "node4"]] },
    { "expect": "peerCount", "on": "node1", "compare": "LessOrEqual", "is": "2" },
    { "expect": "peerCount", "on": "node3", "compare": "LessOrEqual", "is": "2" },
    { "do": "healPartition" },
    { "do": "waitBlock", "on": "node3", "target": 8, "timeout": "150s" },
    { "expect": "sameBlockHash", "block": "latest" }
  ]
}
