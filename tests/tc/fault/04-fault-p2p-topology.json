{
  "schemaVersion": "2",
  "kind": "case",
  "id": "fault-p2p-topology",
  "description": "Test consensus and TX propagation under restricted hub-spoke P2P topology (원본 fault/p2p-topology.sh)",
  "requires": [
    "rpc",
    "consensus",
    "process"
  ],
  "env": {
    "schemaVersion": "2",
    "kind": "env",
    "id": "fault-stablenet",
    "chain": "stablenet",
    "binaries": {
      "default": "gstable"
    },
    "topology": {
      "bp": 4
    },
    "keys": {
      "nodekeys": {
        "source": "preset",
        "ref": "keys/preset"
      }
    }
  },
  "steps": [
    {
      "do": "waitBlock",
      "target": 3,
      "timeout": "120s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    },
    {
      "do": "partition",
      "groups": [
        [
          "node2"
        ],
        [
          "node3"
        ],
        [
          "node4"
        ]
      ]
    },
    {
      "expect": "peerCount",
      "on": "node1",
      "compare": "GreaterOrEqual",
      "is": "2"
    },
    {
      "expect": "blockAdvance",
      "on": "node1",
      "timeout": "90s",
      "pollInterval": "2s"
    },
    {
      "do": "newAccount",
      "save": "r",
      "saveKey": "rk"
    },
    {
      "do": "sendTx",
      "on": "node1",
      "from": "0xc17d493883eaa3b4cceb0f214b273392d562f9d8",
      "to": "$r",
      "value": "1",
      "expect": "receipt"
    },
    {
      "expect": "balanceAt",
      "on": "node1",
      "address": "$r",
      "compare": "Greater",
      "is": "0"
    },
    {
      "do": "healPartition"
    },
    {
      "expect": "blockAdvance",
      "on": "node4",
      "timeout": "90s",
      "pollInterval": "2s"
    },
    {
      "expect": "sameBlockHash",
      "block": "latest"
    }
  ]
}
