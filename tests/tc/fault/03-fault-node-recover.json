{
  "schemaVersion": "2",
  "kind": "case",
  "id": "fault-node-recover",
  "env": "fault-stablenet",
  "requires": ["rpc", "consensus", "process"],
  "steps": [
    { "do": "waitBlock", "target": 3, "timeout": "120s" },
    { "do": "stopNode", "on": "node3" },
    { "do": "waitBlock", "on": "node1", "target": 12, "timeout": "150s" },
    { "do": "restartNode", "on": "node3" },
    { "do": "waitBlock", "on": "node3", "target": 12, "timeout": "150s" },
    { "expect": "sameBlockHash", "block": "latest" }
  ]
}
