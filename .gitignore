# Runtime state
state/pids.json
state/current-profile.yaml
state/current-profile-merged.json
state/results/*.json
state/remotes.json
state/current-remote
state/local-config.yaml
state/logrot-build.log
state/failures/

# Node data (generated at runtime)
data/
/tmp/

# chainbench test-framework runtime session artifacts (.chainbench/<session>/…)
.chainbench/

# Backup copies
*.bak
*.bak.*

# Go test coverage / build outputs
coverage.out
coverage.html
*.coverprofile
/dist/

# Large session transcripts — must NOT be committed (bloats the repo).
# NOTE: docs/dev/session-data/ is currently TRACKED; run `git rm -r --cached
# docs/dev/session-data` to stop tracking it (see review notes).
docs/dev/session-data/

# Logs
*.log
*.log.*

# Removed legacy trees — the Go tool replaced these; never re-add. (They were
# once accidentally re-committed via `git add -A`; use explicit `git add <path>`.)
# Anchored to repo root so unrelated dirs (e.g. tests/specs/network/) aren't swallowed.
/mcp-server/
/network/

# Node.js dependencies and build caches (never commit)
node_modules/
**/node_modules/
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code
.claude/

# PID files
*.pid

# Binaries (platform-specific, not tracked) — whole dir, incl. *.bak copies
bin/

.claude/settings.local.json

# Remote chain profiles with auth headers (security)
profiles/custom/*-secret.yaml
profiles/custom/*-auth.yaml
# Defense in depth: catch copies placed outside the custom/ subdir
profiles/*-secret.yaml
profiles/*-auth.yaml

# Test environment secrets (private keys, SSH credentials, node IP/URL mappings)
# Defense in depth — tests/env/secret/.gitignore also ignores its own contents.
tests/env/secret/

# Server set: host addresses, node port assignments, data roots, and SSH
# access. All of it is site-specific and sensitive — NEVER commit real values.
# Only server-set.sample.yaml is tracked (design §7).
server-set.yaml
server-set.yml
*server-set.yaml
*server-set.yml
!server-set.sample.yaml
# Older copies of the same file under its previous name may still exist
# locally; keep them out too.
remote-server-config.yaml
remote-server-config.yml
*remote-server-config.yaml
*remote-server-config.yml

# --- Secrets hardening (defense in depth) --------------------------------------
# NEVER commit real private keys or credentials. The only intentional key
# material in this repo is keys/preset/ (labeled TEST FIXTURE ONLY) and the
# public test addresses in tests/env/*.env. Real secrets belong in the
# gitignored tests/env/secret/ (see docs/SECURITY_KEY_HANDLING.md).

# The keyring's default ring location (keyring new with no --keyring-dir).
# It holds generated private keys, so it must never be committed — matched at
# any depth, because a command run from a subdirectory creates it there.
keys/default/
#
# Private-key / certificate files (none are tracked; catch new ones).
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.keystore
# Personal/real env overrides (the tracked tests/env/*.env are public fixtures;
# a literal ".env" or "*.env.local" is treated as private).
.env
.env.*
*.env.local
# Runtime devp2p node keys (datadirs live under data/, already ignored; this
# catches stray copies elsewhere).
**/geth/nodekey
**/gwemix/nodekey

# browser automation artifacts
.playwright-mcp/

# go build artifacts at the repo root
/chainbench
/chainbench-mcp
/chainbenchd
/chain-flag-graph
/code-graph

# local docker fleet artifacts (keys, generated server set/map)
env/docker/build/
# dev accounts injected into the containers (name:uid list + shared password);
# only accounts.env.sample is tracked
env/docker/accounts.env
chainbench-out/
