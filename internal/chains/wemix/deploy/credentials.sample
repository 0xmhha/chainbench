# credentials — SSH auth for the remote cluster (chainbench).
# SENSITIVE: cp credentials.sample credentials, then edit. `credentials` is
# gitignored. This mirrors wemix4's .credentials (global user + password).
#
# Password auth (closed network, sshpass-style):
user: ubuntu
password: yourpassword

# OR key-based auth (preferred where allowed) — set key_file instead of password:
# key_file: ~/.ssh/id_ed25519

# Per-server overrides are optional; keyed by server index. Omit to use the
# global user/password/key_file above.
# overrides:
#   3:
#     user: adminuser
#   9:
#     key_file: ~/.ssh/bootnode_key
