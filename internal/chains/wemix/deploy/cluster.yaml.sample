# cluster.yaml — remote wemix+etcd deployment config (chainbench).
#
# This is chainbench's equivalent of wemix4's env.conf + node_env.json: it
# declares the chain parameters and the server list (1..N servers with roles).
#
# USAGE (sensitive — never commit the real file):
#   cp cluster.yaml.sample cluster.yaml
#   # edit cluster.yaml with your real server hosts/roles
# cluster.yaml is gitignored (see .gitignore). SSH auth and account/keystore
# material go in the separate credentials/accounts files, also gitignored.

# --- chain parameters ---
rpc_port: 8601
ws_port: 8701
croissant_block: 100        # wemix -> wbft hardfork block
epoch_length: 10
target_validators: 7

# Remote paths (on every server) — gwemix embeds etcd, so no external etcd.
genesis_file: /data/go-wbft/genesis_private.json
wemix_binary: /data/bin/gwemix3   # pre-fork wpoa producer binary
wbft_binary: /data/bin/gwemix4    # post-fork WBFT validator binary

# Default SSH port for all servers (per-server override with `ssh_port`).
ssh_port: 10022

# Where key material lives on each server (used by `chainbench remote keys read`).
# Omit any field to use the wemix4 defaults shown here.
remote_paths:
  bootnode: bootnode                                   # BLS/address derivation tool
  nodekey: /data/go-wbft/conf/nodekey
  coinbase_keystore: /data/go-wbft/conf/keystore/coinbase
  operator_keystore: /data/go-wbft/conf/keystore/operator

# --- servers: one entry per host, 1 to N. count = number of entries. ---
# role: wemix_bp (pre-fork producer) | wbft_bp (validator) | en (endpoint) | pn (bootnode)
servers:
  - index: 1
    host: 10.0.0.11
    role: wemix_bp
  - index: 2
    host: 10.0.0.12
    role: wemix_bp
  - index: 3
    host: 10.0.0.13
    role: wbft_bp
  - index: 4
    host: 10.0.0.14
    role: wbft_bp
  - index: 5
    host: 10.0.0.15
    role: wbft_bp
  - index: 6
    host: 10.0.0.16
    role: wbft_bp
  - index: 7
    host: 10.0.0.17
    role: wbft_bp
  - index: 8
    host: 10.0.0.18
    role: en
    sync_mode: snap
  - index: 9
    host: 10.0.0.19
    role: pn
# A single-server local test is just one entry:
#   servers:
#     - index: 1
#       host: 127.0.0.1
#       role: wbft_bp
